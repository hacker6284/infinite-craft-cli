load("@rules_python//python:defs.bzl", "py_test")

py_test(
    name = "chrome_pair_test",
    srcs = ["chrome_pair_test.py"],
    main = "chrome_pair_test.py",
    data = [
        "page.html",
        "//bookmarklet:trainer_js",
    ],
    deps = [
        "//src/infinite_craft_cli",
        "@pip//playwright",
        "@pip//pytest",
    ],
    # Chromium + Playwright browsers live on the host (HOME cache). `local`
    # disables sandboxing so the browser can launch; PATH/HOME must be
    # forwarded or the driver cannot find the browser binary.
    tags = ["local"],
    env_inherit = [
        "PATH",
        "HOME",
        "PLAYWRIGHT_BROWSERS_PATH",
        "XDG_CACHE_HOME",
    ],
    size = "medium",
)
