load("@rules_sudo//:defs.bzl", "sudo_js_library")

# Kernel adapters for craft.sudo (JS target), compiled by rules_sudo's
# sudo_js_library into a tree-artifact directory named "_sudo". Runtime
# consumers (trainer.src.mjs via "./_sudo/craft.mjs",
# tests/parity/run_js.mjs via "../../bookmarklet/_sudo/craft.mjs") resolve
# this exact path unchanged from the old genrule layout.
sudo_js_library(
    name = "_sudo",
    lib = "//sudo:craft",
    entry = "craft.sudo",
)

filegroup(
    name = "trainer_srcs",
    srcs = [
        "trainer.src.mjs",
        ":_sudo",
    ],
    visibility = ["//visibility:public"],
)
