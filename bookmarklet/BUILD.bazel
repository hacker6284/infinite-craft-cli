load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_sudo//:defs.bzl", "sudo_js_library")

# Kernel adapters for craft.sudo (JS target), compiled by rules_sudo's
# sudo_js_library into a tree-artifact directory named "_sudo". Runtime
# consumers (trainer.src.mjs via "./_sudo/craft.mjs",
# tests/parity/run_js.mjs via "../../bookmarklet/_sudo/craft.mjs") resolve
# this exact path unchanged from the old genrule layout.
sudo_js_library(
    name = "_sudo",
    lib = "//sudo:craft",
    entry = "craft.sudo",
)

filegroup(
    name = "trainer_srcs",
    srcs = [
        "trainer.src.mjs",
        ":_sudo",
    ],
    visibility = ["//visibility:public"],
)

# Both targets pin target = ["esnext"] (rules_esbuild's macro default is
# es2015) to match the old minify.sh, which invoked esbuild with no --target
# and so performed no syntax lowering. Without this override, es2015 lowering
# rewrites craft.sudo's BigInt literals (e.g. "48n") in bookmarklet/_sudo/
# _regex_impl.mjs into `BigInt("48")` calls -- functionally fine (verified
# via `node --check`) but a gratuitous transform + a wall of esbuild
# "may crash at run-time [bigint]" warnings for a bookmarklet that only ever
# runs in modern BigInt-capable browsers.
#
# Both targets also pin sourcemap = "" (rules_esbuild's macro default is
# "linked", which emits a companion "<output>.map" file and declares it as an
# extra DefaultInfo output). The old minify.sh produced no maps at all, and
# //bookmarklet:site copy_to_directory's srcs pull each esbuild target's full
# DefaultInfo, so a linked map would ride along into the deploy dir and get
# uploaded to GitHub Pages by Task 6. sourcemap = "" is falsy in the macro
# (aspect_rules_esbuild's esbuild/defs.bzl `if sourcemap:` / `if sourcemap and
# sourcemap != "inline":` gates), so no output_map is declared at all -- the
# cleanest way to suppress maps entirely, rather than filtering them out
# downstream in copy_to_directory.

# Bundled, unminified trainer (host tests + local dev read this).
esbuild(
    name = "trainer_js",
    entry_point = "trainer.src.mjs",
    srcs = ["trainer.src.mjs", ":_sudo"],
    config = "esbuild.config.mjs",
    format = "iife",
    sourcemap = "",
    target = ["esnext"],
    output = "trainer.js",
    visibility = ["//visibility:public"],
)

# Minified trainer (served by GitHub Pages, fetched by the extension).
esbuild(
    name = "trainer_min_js",
    entry_point = "trainer.src.mjs",
    srcs = ["trainer.src.mjs", ":_sudo"],
    config = "esbuild.config.mjs",
    format = "iife",
    minify = True,
    sourcemap = "",
    target = ["esnext"],
    output = "trainer.min.js",
    visibility = ["//visibility:public"],
)

# The exact directory GitHub Pages uploads: committed static assets + built
# bundle. root_paths = ["bookmarklet"] strips the "bookmarklet/" package
# prefix off srcs that live directly in this package (index.html,
# trainer.user.js) so they land at the site root; the esbuild outputs
# (:trainer_js, :trainer_min_js) already produce bare "trainer.js" /
# "trainer.min.js" (declared via output = ...), so they land at the root too.
copy_to_directory(
    name = "site",
    srcs = [
        "index.html",
        "trainer.user.js",
        ":trainer_js",
        ":trainer_min_js",
    ],
    root_paths = ["bookmarklet"],
    visibility = ["//visibility:public"],
)
