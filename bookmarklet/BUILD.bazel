# Kernel adapters for craft.sudo (JS target), generated at build time by the
# pinned sudoc binary (see //sudo:sudoc_bin). Same generated-only rationale
# as //src/infinite_craft_cli:gen_py_sudo -- no glob(["_sudo/**"]) alongside
# it, to avoid colliding with the gitignored output scripts/generate.sh
# writes in-place for non-Bazel flows (minify.sh, Pages/publish CI).
genrule(
    name = "gen_js_sudo",
    srcs = ["//sudo:craft.sudo"],
    outs = [
        "_sudo/craft.mjs",
        "_sudo/_craft_impl.mjs",
        "_sudo/_regex_impl.mjs",
        "_sudo/_strings_impl.mjs",
        "_sudo/_sudo_rt.mjs",
        "_sudo/regex.mjs",
    ],
    cmd = "set -euo pipefail; " +
          "OUTDIR=$(RULEDIR)/_sudo; " +
          "mkdir -p \"$$OUTDIR\"; " +
          "$(location //sudo:sudoc_bin) build --target js -o \"$$OUTDIR\" $(location //sudo:craft.sudo)",
    tools = ["//sudo:sudoc_bin"],
)

filegroup(
    name = "trainer_srcs",
    srcs = ["trainer.src.mjs", ":gen_js_sudo"],
    visibility = ["//visibility:public"],
)
