{
  "manifest_version": 3,
  "name": "Infinite Craft Trainer",
  "version": "1.6.1",
  "description": "CLI overlay for neal.fun Infinite Craft — combine, search, recipe, exhaust, crawl, and more.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://neal.fun/infinite-craft/*"],
      "js": ["loader.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://hacker6284.github.io/*",
    "https://infinibrowser.wiki/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://neal.fun/*"]
    }
  ]
}
