    assert miss.name == "Unicorn Dust"
    assert miss.emoji == ""
    assert miss.first == false
    assert get_by_name(els, "fire").is_none()
    assert get_by_name(els, "Fire").is_some()
    assert is_base_element("Water")
    assert not is_base_element("Steam")
