// Tests
// ===========================================================================

func parity_fixture() -> List<Element>
    els: List<Element> = []
    els.append(Element(name = "Water", emoji = "💧", first = false))
    els.append(Element(name = "Fire", emoji = "🔥", first = false))
    els.append(Element(name = "Wind", emoji = "🌬️", first = false))
    els.append(Element(name = "Earth", emoji = "🌍", first = false))
    els.append(Element(name = "Firewall", emoji = "🧱", first = true))
    return els

func match_names(els: List<Element>, query: text) -> (Set<text>, Option<text>)
    matches, err = match_elements(els, query)
    names: Set<text> = Set()
    for e in matches
        names.add(e.name)
    return (names, err)

test "retry policy parity"
    assert fetch_timeout_ms() == 30000
    assert pair_retry_max_attempts() == 3
    assert pair_retry_backoff_ms(0) == 1000
    assert pair_retry_backoff_ms(1) == 2000
    assert pair_retry_backoff_ms(2) == 4000
    assert pair_should_retry(0)
    assert pair_should_retry(1)
    assert not pair_should_retry(2)
    assert ib_retry_max_attempts() == 4
    assert ib_retry_backoff_ms(0) == 2000
    assert ib_retry_backoff_ms(1) == 4000
    assert ib_retry_backoff_ms(2) == 8000
    assert ib_should_retry(429, 0)
    assert ib_should_retry(0, 0)
    assert ib_should_retry(429, 2)
    assert not ib_should_retry(429, 3)
    assert not ib_should_retry(0, 3)
    assert not ib_should_retry(404, 0)
    assert not ib_should_retry(500, 0)
    assert not ib_should_retry(200, 0)

test "is_local_command parity"
    assert is_local_command("/help")
    assert is_local_command("/list")
    assert is_local_command("/history")
    assert is_local_command("/clear")
    assert is_local_command("/queue")
    assert is_local_command("/unfilled")
    assert is_local_command("/unfilled extra")
    assert is_local_command("/search")
    assert is_local_command("/search water")
    assert is_local_command("/recipe")
    assert is_local_command("/recipe Fire")
    assert is_local_command("/target")
    assert is_local_command("/target Steam")
    assert is_local_command("/target clear")
    assert not is_local_command("/combine Water + Fire")
    assert not is_local_command("/fill")
    assert not is_local_command("/prune")
    assert not is_local_command("/permutate w*")
    assert not is_local_command("Water + Fire")

test "queue lane and target pure rules"
    assert is_ib_command("/import")
    assert is_ib_command("/import Steam")
    assert is_ib_command("/fill")
    assert is_ib_command("/prune")
    assert not is_ib_command("/combine Water Fire")
    assert not is_ib_command("/permutate w*")
    assert not is_ib_command("/help")
    assert command_queue_lane("/help") == "local"
    assert command_queue_lane("/target Steam") == "local"
    assert command_queue_lane("/fill") == "ib"
    assert command_queue_lane("/import X") == "ib"
    assert command_queue_lane("/permutate w*") == "pair"
    assert command_queue_lane("Water + Fire") == "pair"
    // queue_accept: dup / full / ok
    empty_q: List<text> = []
    assert queue_accept("Water + Fire", "Water + Fire", empty_q, 0, 50) == "dup"
    q1: List<text> = ["Water + Fire", "/fill"]
    assert queue_accept("Water + Fire", "", q1, 2, 50) == "dup"
    assert queue_accept("/fill", "other", q1, 2, 50) == "dup"
    assert queue_accept("new", "", q1, 50, 50) == "full"
    assert queue_accept("new", "", q1, 49, 50) == "ok"
    assert queue_accept("new", "", empty_q, 0, 50) == "ok"
    // Idle current "" does not false-dup empty line unless empty is queued
    assert queue_accept("", "", empty_q, 0, 50) == "ok"
    empty_only: List<text> = [""]
    assert queue_accept("", "", empty_only, 1, 50) == "dup"
    // Non-empty current still dups; full only when not dup
    assert queue_accept("x", "x", empty_q, 50, 50) == "dup"
    // queue_lane_busy: current non-empty OR pending_len>0 OR confirm_active
    assert not queue_lane_busy("", 0, false)
    assert queue_lane_busy("Water + Fire", 0, false)
    assert queue_lane_busy("", 1, false)
    assert queue_lane_busy("", 0, true)
    assert queue_lane_busy("x", 2, true)
    assert not queue_lane_busy("", 0, false)
    // lane_should_reset_cancel: pair ignores confirm; ib needs peer idle + no confirm
    assert lane_should_reset_cancel("pair", false, false)
    assert lane_should_reset_cancel("pair", false, true)
    assert not lane_should_reset_cancel("pair", true, false)
    assert not lane_should_reset_cancel("pair", true, true)
    assert lane_should_reset_cancel("ib", false, false)
    assert not lane_should_reset_cancel("ib", false, true)
    assert not lane_should_reset_cancel("ib", true, false)
    assert not lane_should_reset_cancel("ib", true, true)
    // soft: pair always; ib only when not peer_busy
    assert lane_should_soft_reset_cancel("pair", false)
    assert lane_should_soft_reset_cancel("pair", true)
    assert lane_should_soft_reset_cancel("ib", false)
    assert not lane_should_soft_reset_cancel("ib", true)
    assert may_bulk_confirm("/permutate w*")
    assert may_bulk_confirm("/exhaust fire*")
    assert may_bulk_confirm("/with Water fire*")
    assert not may_bulk_confirm("/combine Water Fire")
    assert not may_bulk_confirm("/fill")
    assert not may_bulk_confirm("/crawl Water Fire")
    assert should_bulk_warn(201, 200)
    assert not should_bulk_warn(200, 200)
    assert not should_bulk_warn(0, 200)
    assert should_bulk_warn(2, 1)
    act, name = parse_target_arg("")
    assert act == "show"
    assert name == ""
    act, name = parse_target_arg("  clear  ")
    assert act == "clear"
    assert name == ""
    act, name = parse_target_arg("off")
    assert act == "clear"
    act, name = parse_target_arg("Steam")
    assert act == "set"
    assert name == "Steam"
    assert is_target_hit("Steam", "Steam")
    assert not is_target_hit("Steam", "steam")
    assert not is_target_hit("", "Steam")
    assert not is_target_hit("Steam", "")
    assert apply_target_state("Steam", "show", "") == "Steam"
    assert apply_target_state("Steam", "clear", "") == ""
    assert apply_target_state("", "set", "Lava") == "Lava"
    kind, st, det = target_outcome("", "show", "")
    assert kind == "show_empty"
    assert st == ""
    assert det == ""
    kind, st, det = target_outcome("Steam", "show", "")
    assert kind == "show"
    assert st == "Steam"
    assert det == ""
    kind, st, det = target_outcome("", "clear", "")
    assert kind == "clear_empty"
    assert st == ""
    assert det == ""
    kind, st, det = target_outcome("Steam", "clear", "")
    assert kind == "clear"
    assert st == ""
    assert det == "Steam"
    kind, st, det = target_outcome("", "set", "Lava")
    assert kind == "set"
    assert st == "Lava"
    assert det == ""
    kind, st, det = target_outcome("Steam", "set", "  Water  ")
    assert kind == "set"
    assert st == "Water"
    assert confirm_should_continue("y")
    assert confirm_should_continue(" Y ")
    assert not confirm_should_continue("n")
    assert not confirm_should_continue("")
    assert not confirm_should_continue("yes")
    assert is_confirm_answer("y")
    assert is_confirm_answer("Y")
    assert is_confirm_answer(" n ")
    assert not is_confirm_answer("")
    assert not is_confirm_answer("yes")
    assert not is_confirm_answer("no")
    assert not is_confirm_answer("ya")
    assert confirm_answer_key(" Y ") == "y"
    assert confirm_answer_key(" n ") == "n"
    assert confirm_input_route("y", true, false) == "deliver"
    assert confirm_input_route("n", true, true) == "deliver"
    assert confirm_input_route("y", false, true) == "buffer"
    assert confirm_input_route("n", false, true) == "buffer"
    assert confirm_input_route("y", false, false) == "ignore"
    assert confirm_input_route("", true, true) == "ignore"
    assert confirm_input_route("yes", true, false) == "ignore"
    assert confirm_input_route("no", false, true) == "ignore"
    assert rate_slots_left(0, 60) == 60
    assert rate_slots_left(15, 60) == 45
    assert rate_slots_left(60, 60) == 0
    assert rate_slots_left(0, 0) == 0
    // Idle
    assert rate_next_slot_frac_milli(1000, 0, 0, 60000, false, false) == 1000
    // Just acquired at t=0, now=0 → empty left bar
    assert rate_next_slot_frac_milli(0, 0, 0, 1000, true, false) == 0
    // Half way through first segment (oldest birth → expiry)
    assert rate_next_slot_frac_milli(500, 0, 0, 1000, true, false) == 500
    // After free at t=800, next free at oldest(100)+1000=1100, span=300
    // now=950 → 150/300 → 500
    assert rate_next_slot_frac_milli(950, 100, 800, 1000, true, true) == 500
    lf, rf = rate_bar_fills(60, 60, 1000, 9, 9)
    assert lf == 9
    assert rf == 9
    lf, rf = rate_bar_fills(0, 60, 0, 9, 9)
    assert lf == 0
    assert rf == 0
    lf, rf = rate_bar_fills(30, 60, 500, 9, 9)
    assert lf == 5
    assert rf == 5
    // rate_bar_segment: clamp edges + mid fill (█ / ░)
    assert rate_bar_segment(0, 4) == "░░░░"
    assert rate_bar_segment(4, 4) == "████"
    assert rate_bar_segment(2, 4) == "██░░"
    assert rate_bar_segment(-3, 4) == "░░░░"
    assert rate_bar_segment(99, 4) == "████"
    assert rate_bar_segment(0, 0) == ""
    assert rate_bar_segment(3, 0) == ""
    // rate_ellipsize_end: short fits, overflow end-ellipsis
    assert rate_ellipsize_end("hello", 10) == "hello"
    assert rate_ellipsize_end("hello", 5) == "hello"
    assert rate_ellipsize_end("hello", 0) == ""
    assert rate_ellipsize_end("hello", 1) == "…"
    assert rate_ellipsize_end("hello", 3) == "he…"
    // rate_format_pair_for_width: short fits, tight avail, overflow split
    assert rate_format_pair_for_width("Hi", "Yo", 20) == "Hi + Yo"
    assert rate_format_pair_for_width("A", "B", 7) == "A + B"
    assert rate_format_pair_for_width("Water", "Fire", 5) == "Wate…"
    assert rate_format_pair_for_width("Water", "Fire", 6) == "W… + …"
    assert rate_format_pair_for_width("Water", "Fire", 11) == "Wat… + Fire"

test "parse_query_filter parity"
    p, ex, on = parse_query_filter("!fire*")
    assert p == "fire*"
    assert ex
    assert not on
    p, ex, on = parse_query_filter("!")
    assert p == ""
    assert ex
    assert not on
    p, ex, on = parse_query_filter("!  ")
    assert p == ""
    assert ex
    assert not on
    p, ex, on = parse_query_filter("^fire*")
    assert p == "fire*"
    assert not ex
    assert on
    p, ex, on = parse_query_filter("^")
    assert p == ""
    assert not ex
    assert on
    p, ex, on = parse_query_filter("/^fi/")
    assert p == "/^fi/"
    assert not ex
    assert not on
    p, ex, on = parse_query_filter("water")
    assert p == "water"
    assert not ex
    assert not on
    // owner ruling 2026-07-22: prefixes combine, either order
    p, ex, on = parse_query_filter("!^steam*")
    assert p == "steam*"
    assert ex
    assert on
    p, ex, on = parse_query_filter("^!steam*")
    assert p == "steam*"
    assert ex
    assert on
    // owner ruling 2026-07-22: repeated prefix consumes only the first
    // occurrence; the second stays in the pattern text
    p, ex, on = parse_query_filter("!!x")
    assert p == "!x"
    assert ex
    assert not on
    p, ex, on = parse_query_filter("^^x")
    assert p == "^x"
    assert not ex
    assert on

test "match_elements parity fixture"
    els = parity_fixture()
    names, err = match_names(els, "!fire*")
    assert err.is_none()
    assert names.has("Water")
    assert names.has("Wind")
    assert names.has("Earth")
    assert not names.has("Fire")
    assert not names.has("Firewall")
    names, err = match_names(els, "!")
    assert err.is_none()
    assert names.has("Water")
    assert names.has("Fire")
    assert names.has("Wind")
    assert names.has("Earth")
    assert names.has("Firewall")
    names, err = match_names(els, "!/wall/")
    assert err.is_none()
    assert names.has("Water")
    assert names.has("Fire")
    assert names.has("Wind")
    assert names.has("Earth")
    assert not names.has("Firewall")
    names, err = match_names(els, "^fire*")
    assert err.is_none()
    assert names.has("Firewall")
    assert not names.has("Fire")
    names, err = match_names(els, "/^fi/")
    assert err.is_none()
    assert names.has("Fire")
    assert names.has("Firewall")
    assert not names.has("Water")
    // owner ruling 2026-07-22: combined prefixes work end-to-end through
    // match_elements too (exclude AND only_new applied together)
    names, err = match_names(els, "!^wind")
    assert err.is_none()
    assert names.has("Firewall")
    assert names.items().length == 1
    names, err = match_names(els, "^!wind")
    assert err.is_none()
    assert names.has("Firewall")
    assert names.items().length == 1

test "parse_two_elements and cross helpers"
    r = parse_two_elements("Water Fire")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "Water"
    assert b == "Fire"
    r = parse_two_elements("Water + Fire")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "Water"
    assert b == "+ Fire"
    assert parse_two_elements("Water+Fire").is_none()
    assert parse_two_elements("fire").is_none()
    r = parse_cross_queries("fire* water*")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "fire*"
    assert b == "water*"
    r = split_two_positional_args("/a b/ /c d/")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "/a b/"
    assert b == "/c d/"
    r = parse_with_args("Water fire*")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "Water"
    assert b == "fire*"

test "classify_command_line parity"
    c = classify_command_line("Water + | Fire")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "bad+|"
    c = classify_command_line("Water +| Fire")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "+|"
    c = classify_command_line("/^fi/ * /^wa/")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "*"
    c = classify_command_line("/combine Water + Fire")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "combine"
    assert p == "Water + Fire"
    c = classify_command_line("/combine Water + | Fire")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "combine"
    c = classify_command_line("Water +")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "+"
    c = classify_command_line("Water + Fire")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "+"
    assert not is_slash_command_attempt("/^fi/ * /^wa/")
    assert is_slash_command_attempt("/notacommand")
    assert not is_slash_command_attempt("Water + Fire")

test "validate_command_line error presence"
    assert validate_command_line("/combine Water Fire").is_none()
    assert validate_command_line("/crawl Water Fire").is_none()
    assert validate_command_line("/cross Water Fire").is_none()
    assert validate_command_line("/combine Water + Fire").is_some()
    assert validate_command_line("/cross fire* * water*").is_some()
    assert validate_command_line("Water + | Fire").is_some()
    assert validate_command_line("/combine Water + | Fire").is_some()
    assert validate_command_line("Water +").is_some()
    assert validate_command_line("Water + Fire").is_none()
    assert validate_command_line("/^fi/ * /^wa/").is_none()
    assert validate_command_line("/cross /^fi/ /^wa/").is_none()
    assert validate_command_line("/^fi/").is_some()
    assert validate_command_line("/notacommand").is_some()
    assert validate_command_line("Water Fire").is_some()
    assert validate_command_line("/permute").is_some()
    assert validate_command_line("/with Water").is_some()
    assert validate_command_line("Water ++").is_some()
    assert validate_command_line("/import").is_some()

test "parse_operands maxsplit semantics"
    // The tail keeps later separators (Python split(sep, 1) semantics) —
    // these four inputs are exactly where the old JS length-limit split
    // truncated the second operand.
    r = parse_operands("+", "A + B + C")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "A"
    assert b == "B + C"
    r = parse_operands("++", "A ++ B ++ C")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "A"
    assert b == "B ++ C"
    r = parse_operands("+|", "A+|b+|c")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "A"
    assert b == "b+|c"
    r = parse_operands("*", "x * y * z")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "x"
    assert b == "y * z"
    r = parse_operands("+", "Water + Fire")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "Water"
    assert b == "Fire"
    // operands are stripped
    r = parse_operands("+|", "  Water  +|  fire*  ")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "Water"
    assert b == "fire*"
    // missing/empty operands
    assert parse_operands("+", "Water +").is_none()
    assert parse_operands("+", "Water").is_none()
    assert parse_operands("++", "A ++ ").is_none()
    assert parse_operands("++", " ++ B").is_none()
    assert parse_operands("+|", "A+|").is_none()
    assert parse_operands("*", " * y").is_none()
    // non-shorthand kinds are not this function's job
    assert parse_operands("combine", "Water Fire").is_none()
    assert parse_operands("", "Water + Fire").is_none()

test "validate_command_line exact messages"
    err = validate_command_line("/combine Water + Fire")
    assert err.is_some()
    assert err.unwrap() == "  Slash /combine uses positional args, not +. Try Water + Fire (shorthand) or /combine Water Fire."
    err = validate_command_line("/cross fire* * water*")
    assert err.is_some()
    assert err.unwrap() == "  Slash /cross uses positional args, not *. Try fire* * water* (shorthand) or /cross fire* water*."
    err = validate_command_line("Water + | Fire")
    assert err.is_some()
    assert err.unwrap() == "  Use <element> +| <query> (no space between + and |). Type /help for commands."
    err = validate_command_line("/combine Water + | Fire")
    assert err.is_some()
    assert err.unwrap() == "  Use <element> +| <query> (no space between + and |). Type /help for commands."
    err = validate_command_line("Water +")
    assert err.is_some()
    assert err.unwrap() == "  Usage: <element> + <element>"
    err = validate_command_line("/^fi/")
    assert err.is_some()
    assert err.unwrap() == "  Unknown input. Type /help for commands."
    err = validate_command_line("/notacommand")
    assert err.is_some()
    assert err.unwrap() == "  Unknown command: /notacommand. Type /help for commands."
    err = validate_command_line("Water Fire")
    assert err.is_some()
    assert err.unwrap() == "  Unknown input. Type /help for commands."
    err = validate_command_line("/crawl Banana")
    assert err.is_some()
    assert err.unwrap() == "  Usage: /crawl <element> <element>"

test "validate_command_line segments highlights"
    segs_opt = validate_command_line_segments("/notacommand")
    assert segs_opt.is_some()
    segs = segs_opt.unwrap()
    assert segs.length == 5
    t0, h0 = segs[0]
    assert t0 == "  Unknown command: "
    assert not h0
    t1, h1 = segs[1]
    assert t1 == "/notacommand"
    assert h1
    t3, h3 = segs[3]
    assert t3 == "/help"
    assert h3
    op_segs = slash_combine_crawl_operator_error_segments("Water + Fire", "combine")
    assert op_segs.is_some()
    o = op_segs.unwrap()
    assert o.length == 5
    s1t, s1h = o[1]
    assert s1t == "Water + Fire"
    assert s1h
    s3t, s3h = o[3]
    assert s3t == "/combine Water Fire"
    assert s3h
    x_segs = slash_cross_operator_error_segments("fire* * water*")
    assert x_segs.is_some()
    x = x_segs.unwrap()
    x3t, x3h = x[3]
    assert x3t == "/cross fire* water*"
    assert x3h
    // segments concat == plain validate for every error shape
    for bad_line in ["Water +", "/notacommand", "Water Fire", "/combine Water + Fire", "Water + | Fire", "/permute", "/with Water", "/cross fire* * water*", "/^fi/"]
        v = validate_command_line(bad_line)
        assert v.is_some()
        sv = validate_command_line_segments(bad_line)
        assert sv.is_some()
        assert seg_concat(sv.unwrap()) == v.unwrap()
    // no-error lines yield no segments
    assert validate_command_line_segments("Water + Fire").is_none()
    assert validate_command_line_segments("/combine Water Fire").is_none()

test "pair_key and exhaust_pairs parity"
    k1 = pair_key("Water", "Fire")
    k2 = pair_key("Fire", "Water")
    a1, b1 = k1
    a2, b2 = k2
    assert a1 == a2
    assert b1 == b2
    matches: List<Element> = []
    matches.append(Element(name = "Water", emoji = "", first = false))
    matches.append(Element(name = "Wind", emoji = "", first = false))
    all_els: List<Element> = []
    all_els.append(Element(name = "Water", emoji = "", first = false))
    all_els.append(Element(name = "Wind", emoji = "", first = false))
    all_els.append(Element(name = "Fire", emoji = "", first = false))
    all_els.append(Element(name = "Earth", emoji = "", first = false))
    pairs = exhaust_pairs(matches, all_els)
    assert pairs.length == 5
    keys: Set<text> = Set()
    for p in pairs
        ta, tb = p
        pk = pair_key(ta.name, tb.name)
        ka, kb = pk
        keys.add(ka + "\u{0}" + kb)
    assert keys.items().length == 5

test "permute cross with pair generation"
    a = Element(name = "A", emoji = "", first = false)
    b = Element(name = "B", emoji = "", first = false)
    c = Element(name = "C", emoji = "", first = false)
    // permute: upper triangle in match order
    pp = permute_pairs([a, b, c])
    assert pp.length == 3
    p0a, p0b = pp[0]
    assert p0a.name == "A"
    assert p0b.name == "B"
    p1a, p1b = pp[1]
    assert p1a.name == "A"
    assert p1b.name == "C"
    p2a, p2b = pp[2]
    assert p2a.name == "B"
    assert p2b.name == "C"
    single: List<Element> = [a]
    assert permute_pairs(single).length == 0
    empty_els: List<Element> = []
    assert permute_pairs(empty_els).length == 0
    // cross: left-major, same-name skipped, symmetric dedup
    cp = cross_pairs([a, b], [b, c])
    // (A,B), (A,C), (B,C) — B+B skipped
    assert cp.length == 3
    c0a, c0b = cp[0]
    assert c0a.name == "A"
    assert c0b.name == "B"
    c1a, c1b = cp[1]
    assert c1a.name == "A"
    assert c1b.name == "C"
    c2a, c2b = cp[2]
    assert c2a.name == "B"
    assert c2b.name == "C"
    // overlap dedup: (A,B) from left-major once only even if reversed later
    cp2 = cross_pairs([a, b], [b, a])
    assert cp2.length == 1
    // with: target x others, self skipped, order preserved
    wp = with_pairs(b, [a, b, c])
    assert wp.length == 2
    w0a, w0b = wp[0]
    assert w0a.name == "B"
    assert w0b.name == "A"
    w1a, w1b = wp[1]
    assert w1a.name == "B"
    assert w1b.name == "C"
    // boundary adapters
    tuples: List<(text, text, bool)> = [("A", "", false), ("B", "", false), ("C", "", false)]
    assert permute_pairs_boundary(tuples).length == 3
    bn, be, bf, cn, ce, cf = permute_pairs_boundary(tuples)[2]
    assert bn == "B"
    assert cn == "C"
    left_t: List<(text, text, bool)> = [("A", "", false), ("B", "", false)]
    right_t: List<(text, text, bool)> = [("B", "", false), ("C", "", false)]
    assert cross_pairs_boundary(left_t, right_t).length == 3
    assert with_pairs_boundary(("B", "", false), tuples).length == 2

test "element_matches_pattern branches"
    m, err = element_matches_pattern("Firewall", "fire*")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("Water", "fire*")
    assert err.is_none()
    assert not m
    m, err = element_matches_pattern("Fire", "/^fi/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("Steam", "tea")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("Steam", "")
    assert err.is_none()
    assert not m
    m, err = element_matches_pattern("x", "/[abc/")
    assert err.is_some()
    assert err.unwrap() == "Invalid regex pattern"
    assert not m
    m, err = element_matches_pattern("//", "//")
    // owner ruling 2026-07-22 (R4): empty regex body matches every name
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("Anything At All", "//")
    assert err.is_none()
    assert m

test "match_elements exclude only_new error abort"
    els = parity_fixture()
    matches, err = match_elements(els, "")
    assert err.is_none()
    assert matches.length == 0
    matches, err = match_elements(els, "^")
    assert err.is_none()
    assert matches.length == 1
    assert matches[0].name == "Firewall"
    matches, err = match_elements(els, "zzzz")
    assert err.is_none()
    assert matches.length == 0
    // invalid regex aborts and discards partial matches
    matches, err = match_elements(els, "/[abc/")
    assert err.is_some()
    assert err.unwrap() == "Invalid regex pattern"
    assert matches.length == 0
    // query too long
    long_q = repeat_char('a', 513)
    matches, err = match_elements(els, long_q)
    assert err.is_some()
    assert err.unwrap() == "Query too long (max 512 characters)"
    assert matches.length == 0

test "ex-gate pathological patterns now work"
    // 12+ wildcards glob
    assert regex.glob_match("*a*b*c*d*e*f*g*h*", "axbxcxdxexfxgxh", true)
    m, err = element_matches_pattern("axbxcxdxexfxgxh", "*a*b*c*d*e*f*g*h*")
    assert err.is_none()
    assert m
    // delimited regex body longer than 200
    body = repeat_char('a', 201)
    pat = "/" + body + "/"
    m, err = element_matches_pattern(body, pat)
    assert err.is_none()
    assert m
    m, err = element_matches_pattern(repeat_char('a', 200), pat)
    assert err.is_none()
    assert not m
    // /a|b/ is now real alternation (a OR b), not a literal 3-char pipe
    // run — see DIVERGENCES.md ruling: upstream both hosts reject any '|'
    // as "too complex"; kernel's linear-time NFA engine makes that fear
    // obsolete, so it performs real alternation instead.
    m, err = element_matches_pattern("xa|by", "/a|b/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("a", "/a|b/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("b", "/a|b/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("xyz", "/a|b/")
    assert err.is_none()
    assert not m
    // validate_query accepts long/pipe patterns (no "too complex")
    assert validate_query_at_enqueue("/a|b/").is_none()
    assert validate_query_at_enqueue(pat).is_none()
    assert validate_query_at_enqueue("/[abc/").is_some()
    assert validate_query_at_enqueue("/[abc/").unwrap() == "  Invalid regex pattern"

test "element_matches_pattern real alternation cat or dog"
    m, err = element_matches_pattern("Watchdog", "/cat|dog/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("Elephant", "/cat|dog/")
    assert err.is_none()
    assert not m

test "element_matches_pattern backslash escape digits"
    m, err = element_matches_pattern("Area 51", "/\\d+/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("AreaX", "/\\d+/")
    assert err.is_none()
    assert not m

test "trace_recipe unbounded depth over 200 layers"
    els: List<Element> = []
    recipes: Map<text, List<(text, text)>> = Map()
    recipes["C0"] = [("Fire", "Water")]
    els.append(Element(name = "C0", emoji = "", first = false))
    for i = 1 to 300
        name = "C" + int_to_text(i)
        prev = "C" + int_to_text(i - 1)
        recipes[name] = [(prev, "Water")]
        els.append(Element(name = name, emoji = "", first = false))
    r = trace_recipe(els, recipes, "C300")
    match r
        case Steps(t, steps)
            assert t == "C300"
            assert steps.length == 301
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0

test "included_element_names orphan export v1.4.2"
    els: List<Element> = []
    els.append(Element(name = "Water", emoji = "", first = false))
    els.append(Element(name = "Fire", emoji = "", first = false))
    els.append(Element(name = "Wind", emoji = "", first = false))
    els.append(Element(name = "Earth", emoji = "", first = false))
    els.append(Element(name = "Steam", emoji = "", first = false))
    els.append(Element(name = "Mystery Gas", emoji = "", first = false))
    els.append(Element(name = "Orphan", emoji = "", first = false))
    recipes: Map<text, List<(text, text)>> = Map()
    recipes["Steam"] = [("Mystery Gas", "Water")]
    included = included_element_names(recipes)
    assert included.has("Water")
    assert included.has("Fire")
    assert included.has("Wind")
    assert included.has("Earth")
    assert included.has("Steam")
    assert included.has("Mystery Gas")
    assert not included.has("Orphan")
    exported = export_elements(els, recipes)
    assert exported.length == 6
    orphans = orphan_candidates(els, recipes)
    assert orphans.length == 1
    assert orphans[0].name == "Orphan"
    // empty recipe list does not include the result name
    recipes2: Map<text, List<(text, text)>> = Map()
    empty_pairs: List<(text, text)> = []
    recipes2["Ghost"] = empty_pairs
    included2 = included_element_names(recipes2)
    assert not included2.has("Ghost")

test "ingredient_usage_counts and prioritize_pairs"
    recipes: Map<text, List<(text, text)>> = Map()
    recipes["Steam"] = [("Fire", "Water")]
    recipes["Mud"] = [("Earth", "Water")]
    recipes["Lake"] = [("Water", "Water")]
    counts = ingredient_usage_counts(recipes)
    // Water: Steam +1, Mud +1, Lake self-pair +2 = 4
    assert counts.get("Water").get_or(0) == 4
    assert counts.get("Fire").get_or(0) == 1
    assert counts.get("Earth").get_or(0) == 1
    // results never count as usage
    assert counts.get("Steam").get_or(0) == 0
    assert counts.get("Zzz").get_or(0) == 0
    water = Element(name = "Water", emoji = "", first = false)
    fire = Element(name = "Fire", emoji = "", first = false)
    earth = Element(name = "Earth", emoji = "", first = false)
    zzz = Element(name = "Zzz", emoji = "", first = false)
    pairs: List<(Element, Element)> = []
    pairs.append((zzz, earth))
    pairs.append((fire, earth))
    pairs.append((water, zzz))
    pairs.append((water, fire))
    ordered = prioritize_pairs(pairs, recipes)
    // scores: Zzz+Earth=1, Fire+Earth=2, Water+Zzz=4, Water+Fire=5
    o0a, o0b = ordered[0]
    assert o0a.name == "Water"
    assert o0b.name == "Fire"
    o1a, o1b = ordered[1]
    assert o1a.name == "Water"
    assert o1b.name == "Zzz"
    o2a, o2b = ordered[2]
    assert o2a.name == "Fire"
    assert o2b.name == "Earth"
    o3a, o3b = ordered[3]
    assert o3a.name == "Zzz"
    assert o3b.name == "Earth"
    // ties break on ascending canonical pair key, and the result is
    // independent of input order
    a = Element(name = "A", emoji = "", first = false)
    b = Element(name = "B", emoji = "", first = false)
    c = Element(name = "C", emoji = "", first = false)
    d = Element(name = "D", emoji = "", first = false)
    empty_recipes: Map<text, List<(text, text)>> = Map()
    tie1: List<(Element, Element)> = [(c, d), (a, b), (b, a)]
    t1 = prioritize_pairs(tie1, empty_recipes)
    t0a, t0b = t1[0]
    assert t0a.name == "A"
    t1a2, t1b2 = t1[1]
    assert t1a2.name == "B"
    assert t1b2.name == "A"
    t2a, t2b = t1[2]
    assert t2a.name == "C"
    // reversed-order pair (b, a) sorts by its CANONICAL key (A, B) but is
    // not reordered internally — (a,b) and (b,a) tie exactly, so their
    // priority_row_less falls through to its input-index tiebreak, so input
    // order is preserved without relying on the sort being stable
    // boundary adapter round-trip
    bpairs: List<(text, text, bool, text, text, bool)> = []
    bpairs.append(("Zzz", "", false, "Earth", "", false))
    bpairs.append(("Water", "", false, "Fire", "", false))
    bp = prioritize_pairs_boundary(bpairs, recipes)
    assert bp.length == 2
    bn0, be0, bf0, bn1, be1, bf1 = bp[0]
    assert bn0 == "Water"
    assert bn1 == "Fire"

test "crawl_generation_pairs sorted order tried and self-pairs"
    w = Element(name = "Water", emoji = "", first = false)
    f = Element(name = "Fire", emoji = "", first = false)
    pool: List<Element> = [w, f]
    tried: Set<text> = Set()
    pairs, keys = crawl_generation_pairs(pool, tried)
    // pool insertion order is Water,Fire; sorted-name ruling gives Fire
    // first; self-pairs included: (Fire,Fire), (Fire,Water), (Water,Water)
    assert pairs.length == 3
    assert keys.length == 3
    p0a, p0b = pairs[0]
    assert p0a.name == "Fire"
    assert p0b.name == "Fire"
    p1a, p1b = pairs[1]
    assert p1a.name == "Fire"
    assert p1b.name == "Water"
    p2a, p2b = pairs[2]
    assert p2a.name == "Water"
    assert p2b.name == "Water"
    // feeding the returned keys back marks everything tried
    tried2: Set<text> = Set()
    for k in keys
        tried2.add(k)
    pairs2, keys2 = crawl_generation_pairs(pool, tried2)
    assert pairs2.length == 0
    assert keys2.length == 0
    // boundary round-trip
    pool_t: List<(text, text, bool)> = [("Water", "", false), ("Fire", "", false)]
    empty_keys: List<text> = []
    bp, bk = crawl_generation_pairs_boundary(pool_t, empty_keys)
    assert bp.length == 3
    assert bk.length == 3
    bp2, bk2 = crawl_generation_pairs_boundary(pool_t, bk)
    assert bp2.length == 0
    assert bk2.length == 0

test "is_unfilled empty list ruling"
    recipes: Map<text, List<(text, text)>> = Map()
    empty_pairs: List<(text, text)> = []
    recipes["Ghost"] = empty_pairs
    recipes["Steam"] = [("Fire", "Water")]
    // owner ruling 2026-08-07: empty list = unfilled, absent = unfilled,
    // non-empty = filled, base elements never unfilled
    assert is_unfilled("Ghost", recipes)
    assert is_unfilled("Mystery", recipes)
    assert not is_unfilled("Steam", recipes)
    assert not is_unfilled("Water", recipes)
    els: List<(text, text, bool)> = [("Water", "", false), ("Ghost", "", false), ("Steam", "", false), ("Mystery", "", false)]
    un = unfilled_names_boundary(els, recipes)
    assert un.length == 2
    assert un[0] == "Ghost"
    assert un[1] == "Mystery"

test "title_case resolve get_by_name add record"
    // Contractions keep the letter after ' lower; single-letter stems
    // (O'Brien) still capitalize — not Python str.title()'s "Don'T".
    assert title_case("baker's dozen") == "Baker's Dozen"
    assert title_case("you don't") == "You Don't"
    assert title_case("You Don't") == "You Don't"
    assert title_case("o'brien") == "O'Brien"
    assert title_case("O'BRIEN") == "O'Brien"
    // U+2019 curly apostrophe behaves identically to ASCII ' — paste and
    // phone autocorrect both produce it, so `is_apostrophe` accepts both.
    assert title_case("you don’t") == "You Don’t"
    assert title_case("o’brien") == "O’Brien"
    assert title_case("co2 gas") == "Co2 Gas"
    assert title_case("3d printer") == "3D Printer"
    assert title_case("HELLO world") == "Hello World"
    assert title_case("under_score name") == "Under_Score Name"
    els: List<Element> = []
    els.append(Element(name = "Baking Soda", emoji = "🧂", first = false))
    els.append(Element(name = "Fire", emoji = "🔥", first = false))
    els.append(Element(name = "You Don't", emoji = "🤷", first = false))
    hit = resolve_element(els, "Fire")
    assert hit.name == "Fire"
    assert hit.emoji == "🔥"
    titled = resolve_element(els, "baking soda")
    assert titled.name == "Baking Soda"
    // Exact + title_case + case-insensitive paths (same apostrophe code point)
    assert resolve_element(els, "You Don't").name == "You Don't"
    assert resolve_element(els, "you don't").emoji == "🤷"
    assert resolve_element(els, "YOU DON'T").name == "You Don't"
    // ASCII ' and U+2019 are distinct element names — do not cross-match.
    curly_name: text = "You Don"
    curly_name.append(8217)
    curly_name = curly_name + "t"
    els2: List<Element> = []
    els2.append(Element(name = curly_name, emoji = "🤨", first = false))
    els2.append(Element(name = "Beach", emoji = "🏖️", first = false))
    // Typing ASCII ' against a curly-only inventory synthesizes ASCII form
    // (no emoji) rather than aliasing to the curly element.
    miss_cross = resolve_element(els2, "You Don't")
    assert miss_cross.emoji == ""
    assert miss_cross.name == "You Don't"
    // Typing/pasting the curly form still hits the stored curly element.
    hit_curly = resolve_element(els2, curly_name)
    assert hit_curly.emoji == "🤨"
    assert hit_curly.name == curly_name
    miss = resolve_element(els, "unicorn dust")
    assert miss.name == "Unicorn Dust"
    assert miss.emoji == ""
    assert miss.first == false
    // Unknown contraction synthesizes English title-case, not Don'T
    syn = resolve_element(els, "we don't")
    assert syn.name == "We Don't"
    assert syn.emoji == ""
    assert get_by_name(els, "fire").is_none()
    assert get_by_name(els, "Fire").is_some()
    assert is_base_element("Water")
    assert not is_base_element("Steam")
    recipes: Map<text, List<(text, text)>> = Map()
    record_recipe(recipes, "R", "A", "B")
    record_recipe(recipes, "R", "B", "A")
    pairs = recipes.get("R").unwrap()
    assert pairs.length == 1
    entries: List<(text, text, text)> = []
    entries.append(("S", "X", "Y"))
    entries.append(("S", "Y", "X"))
    record_recipes_batch(recipes, entries)
    assert recipes.get("S").unwrap().length == 1
    assert add_element(els, "Lava", "🌋", false)
    assert not add_element(els, "Lava", "xx", true)
    assert els[els.length - 1].first == false
    assert els[els.length - 1].emoji == "🌋"
    batch: List<(text, text, bool)> = []
    batch.append(("New1", "1", false))
    batch.append(("Lava", "2", true))
    batch.append(("New2", "3", true))
    n = add_elements_batch(els, batch)
    assert n == 2

test "sanitize_element_name strip and control chars"
    assert sanitize_element_name("  Water  ") == "Water"
    assert sanitize_element_name("Wa\u{0}ter") == "Water"
    assert sanitize_element_name("\u{7}Bell\u{1b}") == "Bell"
    assert sanitize_element_name("\u{9d}C1\u{85}") == "C1"
    assert sanitize_element_name("Line\u{2028}Sep\u{2029}") == "LineSep"
    assert sanitize_element_name("\u{0} spaced \u{0}") == " spaced "
    assert sanitize_element_name("Baker's Dozen") == "Baker's Dozen"
    assert sanitize_element_name("") == ""

test "ic_save_to_batches id resolution and sanitization"
    items: List<(int, text, text, bool)> = []
    items.append((0, "Water", "💧", false))
    items.append((1, "  Steam\u{0} ", "🌫️", true))
    items.append((7, "Fire", "🔥", false))
    refs: List<(int, int, int)> = []
    refs.append((1, 0, 7))
    refs.append((1, 0, 99))
    els, recs = ic_save_to_batches(items, refs)
    assert els.length == 3
    n1, e1, d1 = els[1]
    assert n1 == "Steam"
    assert d1
    assert recs.length == 1
    rr, ra, rb = recs[0]
    assert rr == "Steam"
    assert ra == "Water"
    assert rb == "Fire"
    // an item with missing/empty text is skipped, and refs to its id drop
    bad_items: List<(int, text, text, bool)> = []
    bad_items.append((0, "Water", "", false))
    bad_items.append((1, "  ", "", false))
    bad_refs: List<(int, int, int)> = []
    bad_refs.append((0, 0, 1))
    bad_els, bad_recs = ic_save_to_batches(bad_items, bad_refs)
    assert bad_els.length == 1
    assert bad_recs.length == 0

test "lineage_steps_to_batches dedup and skip malformed"
    steps: List<(text, text, text, text, text, text)> = []
    steps.append(("Fire", "🔥", "Water", "💧", "Steam", "🌫️"))
    steps.append(("Steam", "🌫️", "Wind", "🌬️", "Cloud", "☁️"))
    steps.append(("", "", "Water", "💧", "Broken", ""))
    els, recs = lineage_steps_to_batches(steps)
    // malformed step skipped entirely (no Broken element, no recipe)
    assert recs.length == 2
    assert els.length == 5
    n0, e0, d0 = els[0]
    assert n0 == "Fire"
    n2, e2, d2 = els[2]
    assert n2 == "Steam"
    n4, e4, d4 = els[4]
    assert n4 == "Cloud"
    r0r, r0a, r0b = recs[0]
    assert r0r == "Steam"
    r1r, r1a, r1b = recs[1]
    assert r1r == "Cloud"

test "build_export_items id remap no dangling"
    els: List<(text, text, bool)> = []
    els.append(("Water", "", false))
    els.append(("Steam", "", true))
    els.append(("Mystery Gas", "", false))
    els.append(("Orphan", "", false))
    recipes: Map<text, List<(text, text)>> = Map()
    recipes["Steam"] = [("Mystery Gas", "Water")]
    items, refs = build_export_items_boundary(els, recipes)
    // closure = bases + Steam + Mystery Gas; Orphan is referenced by no
    // recipe -> excluded; input order kept: Water, Steam, Mystery Gas
    assert items.length == 3
    i0, t0, e0, f0 = items[0]
    assert i0 == 0
    assert t0 == "Water"
    i1, t1, e1, f1 = items[1]
    assert t1 == "Steam"
    assert f1
    i2, t2, e2, f2 = items[2]
    assert t2 == "Mystery Gas"
    assert refs.length == 1
    rr, ra, rb = refs[0]
    assert rr == 1
    assert ra == 2
    assert rb == 0
    // an ingredient the closure includes but discoveries never stored:
    // its pair is dropped rather than emitted as a dangling id
    els2: List<(text, text, bool)> = []
    els2.append(("Water", "", false))
    els2.append(("Cloud", "", false))
    recipes2: Map<text, List<(text, text)>> = Map()
    recipes2["Cloud"] = [("Sky", "Water")]
    items2, refs2 = build_export_items_boundary(els2, recipes2)
    // Water + Cloud exported (Sky is in the closure but not stored)
    assert items2.length == 2
    assert refs2.length == 0
    // a referenced-but-recipeless element IS part of the closure: it must
    // be exported, not treated as an orphan
    els3: List<(text, text, bool)> = []
    els3.append(("Water", "", false))
    els3.append(("Steam", "", false))
    els3.append(("Mystery Gas", "", false))
    recipes3: Map<text, List<(text, text)>> = Map()
    recipes3["Steam"] = [("Mystery Gas", "Water")]
    items3, refs3 = build_export_items_boundary(els3, recipes3)
    assert items3.length == 3
    assert refs3.length == 1

test "trace_recipe outcomes"
    els: List<Element> = []
    els.append(Element(name = "Water", emoji = "", first = false))
    recipes: Map<text, List<(text, text)>> = Map()
    r = trace_recipe(els, recipes, "Water")
    match r
        case IsBase(n)
            assert n == "Water"
        case NotFound
            assert false
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0
        case Steps(t, steps)
            assert t.length < 0 or steps.length < 0
    els.append(Element(name = "Mystery", emoji = "", first = false))
    r = trace_recipe(els, recipes, "Mystery")
    match r
        case NoRecipe(n)
            assert n == "Mystery"
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0
        case Steps(t, steps)
            assert t.length < 0 or steps.length < 0
    r = trace_recipe(els, recipes, "Nope")
    match r
        case NotFound
            assert true
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0
        case Steps(t, steps)
            assert t.length < 0 or steps.length < 0
    els2: List<Element> = []
    els2.append(Element(name = "A", emoji = "", first = false))
    els2.append(Element(name = "B", emoji = "", first = false))
    recipes2: Map<text, List<(text, text)>> = Map()
    recipes2["A"] = [("B", "Water")]
    recipes2["B"] = [("A", "Fire")]
    r = trace_recipe(els2, recipes2, "A")
    match r
        case Unreachable(n)
            assert n == "A"
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Steps(t, steps)
            assert t.length < 0 or steps.length < 0
    els3: List<Element> = []
    els3.append(Element(name = "Steam", emoji = "", first = false))
    els3.append(Element(name = "Cloud", emoji = "", first = false))
    recipes3: Map<text, List<(text, text)>> = Map()
    recipes3["Steam"] = [("Fire", "Water")]
    recipes3["Cloud"] = [("Steam", "Wind")]
    r = trace_recipe(els3, recipes3, "Cloud")
    match r
        case Steps(t, steps)
            assert t == "Cloud"
            assert steps.length == 2
            assert steps[0].result == "Steam"
            assert steps[1].result == "Cloud"
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0

// Pins the four invariants the compute_layers perf rewrite depends on
// (DIVERGENCES.md §1). Each would silently regress if readiness were
// re-expressed, the key sort reintroduced, or the mid-layer break removed.
test "compute_layers readiness and ordering invariants"
    // (a) An ingredient with NO recipe entry is available (orphan/base-like).
    els: List<Element> = []
    els.append(Element(name = "Widget", emoji = "", first = false))
    recipes: Map<text, List<(text, text)>> = Map()
    recipes["Widget"] = [("Gift", "Water")]
    r = trace_recipe(els, recipes, "Widget")
    match r
        case Steps(t, steps)
            assert t == "Widget"
            assert steps.length == 1
            assert steps[0].a == "Gift"
            assert steps[0].result == "Widget"
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0

    // (b) An ingredient whose recipe list is EMPTY is likewise available,
    // and is itself never emitted as a layer result.
    els2: List<Element> = []
    els2.append(Element(name = "Thing", emoji = "", first = false))
    recipes2: Map<text, List<(text, text)>> = Map()
    recipes2["Blank"] = []
    recipes2["Thing"] = [("Blank", "Fire")]
    r = trace_recipe(els2, recipes2, "Thing")
    match r
        case Steps(t, steps)
            assert t == "Thing"
            assert steps.length == 1
            assert steps[0].a == "Blank"
            assert steps[0].b == "Fire"
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0

    // (c) First READY pair wins in list order — an unsatisfiable first pair
    // falls through to the second rather than stalling the result.
    els3: List<Element> = []
    els3.append(Element(name = "Deep", emoji = "", first = false))
    recipes3: Map<text, List<(text, text)>> = Map()
    recipes3["Never"] = [("Never", "Water")]
    recipes3["Deep"] = [("Never", "Water"), ("Fire", "Water")]
    r = trace_recipe(els3, recipes3, "Deep")
    match r
        case Steps(t, steps)
            assert t == "Deep"
            assert steps.length == 1
            assert steps[0].a == "Fire"
            assert steps[0].b == "Water"
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0

    // (d) Keys are unsorted and the scan stops at `target`, so siblings that
    // ripen in the same layer must not perturb the ancestor chain. Insertion
    // order deliberately puts the target FIRST and reverse-alphabetical.
    els4: List<Element> = []
    els4.append(Element(name = "Zeta", emoji = "", first = false))
    recipes4: Map<text, List<(text, text)>> = Map()
    recipes4["Zeta"] = [("Alpha", "Water")]
    recipes4["Alpha"] = [("Fire", "Wind")]
    recipes4["Beta"] = [("Water", "Earth")]
    r = trace_recipe(els4, recipes4, "Zeta")
    match r
        case Steps(t, steps)
            assert t == "Zeta"
            assert steps.length == 2
            assert steps[0].result == "Alpha"
            assert steps[1].result == "Zeta"
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0

// Scale guard for prioritize_pairs. Asserts ONLY the documented ordering
// contract — never which algorithm produces it, and no timing — at a size
// where a quadratic implementation cannot finish inside the test timeout.
// 200 elements choose-2 = 19,900 pairs, the shape of /permute on a real
// inventory. n log n is well under a second; n squared is ~400M comparisons
// and blows the timeout, which is the failure signal.
//
// This exists because the kernel shipped a hand-rolled heapsort from v1.8.4
// to v1.9.2 purely because the stdlib sort was quadratic, and nothing in the
// suite would have caught either the original problem or a reintroduction:
// the next largest ordering test uses three recipes.
test "prioritize_pairs order contract at scale"
    els: List<Element> = []
    for i = 0 to 199
        els.append(Element(name = "E" + int_to_text(i), emoji = "", first = false))
    recipes: Map<text, List<(text, text)>> = Map()
    for i = 0 to 199
        if i mod 3 == 0
            recipes["R" + int_to_text(i)] = [(els[i].name, els[(i + 7) mod 200].name)]
    pairs: List<(Element, Element)> = []
    for i = 0 to els.length - 1
        for j = i + 1 to els.length - 1
            pairs.append((els[i], els[j]))
    assert pairs.length == 19900

    out = prioritize_pairs(pairs, recipes)

    // 1. It is a permutation of the input: nothing dropped, duplicated or
    //    invented. Every input pair is distinct, so key counts settle it.
    //    ("|" is an unambiguous joiner here: every name is E<digits>.)
    assert out.length == pairs.length
    in_keys: Set<text> = Set()
    for p in pairs
        pa, pb = p
        ka, kb = pair_key(pa.name, pb.name)
        in_keys.add(ka + "|" + kb)
    out_keys: Set<text> = Set()
    for p in out
        pa, pb = p
        ka, kb = pair_key(pa.name, pb.name)
        key = ka + "|" + kb
        assert in_keys.has(key)
        out_keys.add(key)
    assert out_keys.items().length == in_keys.items().length

    // 2. Adjacent outputs respect the documented order: higher score first,
    //    ties by ascending canonical pair key.
    counts = ingredient_usage_counts(recipes)
    seen_any = false
    prev_score = 0
    prev_k1: text = ""
    prev_k2: text = ""
    for p in out
        pa, pb = p
        score = counts.get(pa.name).get_or(0) + counts.get(pb.name).get_or(0)
        k1, k2 = pair_key(pa.name, pb.name)
        if seen_any
            assert prev_score >= score
            if prev_score == score
                c = strings.lex_compare(prev_k1, k1)
                assert c <= 0
                if c == 0
                    assert strings.lex_compare(prev_k2, k2) <= 0
        prev_score = score
        prev_k1 = k1
        prev_k2 = k2
        seen_any = true
    assert seen_any

test "boundary adapters smoke"
    // match_elements_boundary
    els: List<(text, text, bool)> = []
    els.append(("Water", "", false))
    els.append(("Fire", "", false))
    els.append(("Steam", "", false))
    m, err = match_elements_boundary(els, "tea")
    assert err.is_none()
    assert m.length == 1
    n, em, f = m[0]
    assert n == "Steam"
    m, err = match_elements_boundary(els, "")
    assert err.is_none()
    assert m.length == 0
    // resolve / get_by_name
    miss = resolve_element_boundary(els, "unicorn dust")
    n, em, f = miss
    assert n == "Unicorn Dust"
    found = get_by_name_boundary(els, "Water")
    assert found.is_some()
    assert get_by_name_boundary(els, "missing").is_none()
    // add
    assert add_element_boundary(els, "Lava", "🌋", false)
    assert not add_element_boundary(els, "Lava", "xx", true)
    batch: List<(text, text, bool)> = []
    batch.append(("X", "", false))
    assert add_elements_batch_boundary(els, batch) == 1
    empty_batch: List<(text, text, bool)> = []
    assert add_elements_batch_boundary(els, empty_batch) == 0
    // trace
    base_els: List<(text, text, bool)> = []
    base_els.append(("Water", "", false))
    base_recipes: Map<text, List<(text, text)>> = Map()
    status, name, steps = trace_recipe_boundary(base_els, base_recipes, "Water")
    assert status == 1
    assert name == "Water"
    assert steps.length == 0
    status0, name0, steps0 = trace_recipe_boundary(base_els, base_recipes, "Nope")
    assert status0 == 0
    // included / orphan / export
    recipes: Map<text, List<(text, text)>> = Map()
    recipes["Steam"] = [("Mystery Gas", "Water")]
    exp_els: List<(text, text, bool)> = []
    exp_els.append(("Water", "", false))
    exp_els.append(("Steam", "", false))
    exp_els.append(("Mystery Gas", "", false))
    exp_els.append(("Orphan", "", false))
    names = included_element_names_boundary(recipes)
    assert names.length >= 5
    empty_recipes: Map<text, List<(text, text)>> = Map()
    names_empty = included_element_names_boundary(empty_recipes)
    assert names_empty.length == 4
    orphans = orphan_candidates_boundary(exp_els, recipes)
    assert orphans.length == 1
    empty_orphans = orphan_candidates_boundary(exp_els, empty_recipes)
    // with only bases in closure, Steam/Mystery/Orphan are orphans (Water is base)
    assert empty_orphans.length == 3
    exported = export_elements_boundary(exp_els, recipes)
    assert exported.length == 3
    empty_export = export_elements_boundary(exp_els, empty_recipes)
    assert empty_export.length == 1
    // exhaust_pairs_boundary
    matches: List<(text, text, bool)> = []
    matches.append(("Water", "", false))
    matches.append(("Wind", "", false))
    all_e: List<(text, text, bool)> = []
    all_e.append(("Water", "", false))
    all_e.append(("Wind", "", false))
    all_e.append(("Fire", "", false))
    all_e.append(("Earth", "", false))
    ep = exhaust_pairs_boundary(matches, all_e)
    assert ep.length == 5
    empty_matches: List<(text, text, bool)> = []
    ep0 = exhaust_pairs_boundary(empty_matches, all_e)
    assert ep0.length == 0

// End of craft.sudo kernel v2.
