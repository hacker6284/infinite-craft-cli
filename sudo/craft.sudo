// Pure host-adapter-free Infinite Craft kernel (v2 / CLI v1.4.2).
// Single kernel behavior = Python CLI. No `_js` siblings.
// Matching uses vendored regex.sudo (linear-time; no safety gates/timeouts).

import std.strings
import std.regex

record Element
    name: text
    emoji: text
    first: bool

record RecipeStep
    a: text
    b: text
    result: text

enum RecipeResult
    NotFound
    IsBase(name: text)
    NoRecipe(name: text)
    Unreachable(name: text)
    Steps(target: text, steps: List<RecipeStep>)

// ---------------------------------------------------------------------------
// Base elements
// ---------------------------------------------------------------------------

export func is_base_element(name: text) -> bool
    return name == "Water" or name == "Fire" or name == "Wind" or name == "Earth"

// ---------------------------------------------------------------------------
// ASCII char helpers
// ---------------------------------------------------------------------------

func upper_char(c: int) -> int
    if c >= 'a' and c <= 'z'
        return c - 32
    return c

func lower_char(c: int) -> int
    if c >= 'A' and c <= 'Z'
        return c + 32
    return c

func is_alpha_ascii(c: int) -> bool
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')

func is_word_char(c: int) -> bool
    // Python regex \w = [A-Za-z0-9_]
    return is_alpha_ascii(c) or (c >= '0' and c <= '9') or c == '_'

// ---------------------------------------------------------------------------
// strip / substring helpers (stdlib has no trim/slice)
// ---------------------------------------------------------------------------

func is_ascii_space(c: int) -> bool
    return c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12

func strip_spaces(s: text) -> text
    start = 0
    end = s.length
    while start < end and is_ascii_space(s[start])
        start = start + 1
    while end > start and is_ascii_space(s[end - 1])
        end = end - 1
    out: text = ""
    for i = start to end - 1
        out.append(s[i])
    return out

func strip_prefix_one(s: text) -> text
    out: text = ""
    for i = 1 to s.length - 1
        out.append(s[i])
    return out

func text_slice(s: text, start: int, end: int) -> text
    out: text = ""
    i = start
    while i < end and i < s.length
        out.append(s[i])
        i = i + 1
    return out

func text_from(s: text, start: int) -> text
    return text_slice(s, start, s.length)

// Hand-rolled base-10 conversion — sudo has no built-in int-to-text.
func int_to_text(n: int) -> text
    if n == 0
        return "0"
    if n < 0
        return "-" + int_to_text(0 - n)
    digits: List<int> = []
    x = n
    while x > 0
        digits.append(x mod 10)
        x = x / 10
    out: text = ""
    for i = digits.length - 1 downto 0
        out.append('0' + digits[i])
    return out

func repeat_char(c: int, n: int) -> text
    out: text = ""
    for i = 1 to n
        out.append(c)
    return out

// ---------------------------------------------------------------------------
// Title-casing — ASCII approximation of Python str.title()
// ---------------------------------------------------------------------------

export func title_case(s: text) -> text
    out: text = ""
    prev_cased = false
    for c in s
        if is_alpha_ascii(c)
            if prev_cased
                out.append(lower_char(c))
            else
                out.append(upper_char(c))
            prev_cased = true
        else
            out.append(c)
            prev_cased = false
    return out

// ---------------------------------------------------------------------------
// Element-name storage normalization
// ---------------------------------------------------------------------------

export func sanitize_element_name(name: text) -> text
    // Normalization applied to API/import element names before storage
    // (owner ruling 2026-08-07): strip ASCII whitespace at both ends, then
    // drop control characters — C0 (U+0000–U+001F), DEL (U+007F), C1
    // (U+0080–U+009F) — and the Unicode line/paragraph separators
    // U+2028/U+2029. Hosts may additionally sanitize for DISPLAY (TTY
    // escapes, DOM escaping) at print time; this is the only normalization
    // that decides what gets persisted, so both hosts store identical
    // names for identical payloads.
    out: text = ""
    for c in strip_spaces(name)
        if c < 32 or c == 127 or (c >= 128 and c <= 159) or c == 8232 or c == 8233
            continue
        out.append(c)
    return out

// ---------------------------------------------------------------------------
// Name lookup / resolve
// ---------------------------------------------------------------------------

func get_by_name(elements: List<Element>, name: text) -> Option<Element>
    for e in elements
        if e.name == name
            return Some(e)
    return None

func resolve_element(elements: List<Element>, name: text) -> Element
    found = get_by_name(elements, name)
    if found.is_some()
        return found.unwrap()
    title = title_case(strip_spaces(name))
    if not (title == name)
        found2 = get_by_name(elements, title)
        if found2.is_some()
            return found2.unwrap()
    return Element(name = title, emoji = "", first = false)

// ---------------------------------------------------------------------------
// Sorted pair key / record_recipe
// ---------------------------------------------------------------------------

export func pair_key(a: text, b: text) -> (text, text)
    if strings.lex_compare(a, b) <= 0
        return (a, b)
    return (b, a)

func pair_in_list(pairs: List<(text, text)>, pair: (text, text)) -> bool
    for p in pairs
        if p == pair
            return true
    return false

export func record_recipe(recipes: inout Map<text, List<(text, text)>>, result_name: text, a_name: text, b_name: text)
    pair = pair_key(a_name, b_name)
    existing = recipes.get(result_name).get_or([])
    if not pair_in_list(existing, pair)
        existing.append(pair)
        recipes[result_name] = existing

export func record_recipes_batch(recipes: inout Map<text, List<(text, text)>>, entries: List<(text, text, text)>)
    for entry in entries
        result_name, a_name, b_name = entry
        record_recipe(recipes, result_name, a_name, b_name)

// ---------------------------------------------------------------------------
// add_element / batch (no discovered-flag promotion on re-add)
// ---------------------------------------------------------------------------

func find_index_by_name(elements: List<Element>, name: text) -> Option<int>
    for i = 0 to elements.length - 1
        if elements[i].name == name
            return Some(i)
    return None

func add_element(elements: inout List<Element>, name: text, emoji: text, first: bool) -> bool
    idx = find_index_by_name(elements, name)
    if idx.is_some()
        return false
    elements.append(Element(name = name, emoji = emoji, first = first))
    return true

func add_elements_batch(elements: inout List<Element>, items: List<(text, text, bool)>) -> int
    added = 0
    for item in items
        n, em, f = item
        if add_element(elements, n, em, f)
            added = added + 1
    return added

// ---------------------------------------------------------------------------
// Pair generation — exhaust / permute / cross / with
// ---------------------------------------------------------------------------

func exhaust_pairs(matches: List<Element>, all_elements: List<Element>) -> List<(Element, Element)>
    seen: Set<text> = Set()
    pairs: List<(Element, Element)> = []
    for target in matches
        for other in all_elements
            if other.name == target.name
                continue
            key = pair_key(target.name, other.name)
            ka, kb = key
            // Encode pair key as text for Set membership (text,text not settable).
            key_text = ka + "\u{0}" + kb
            if seen.has(key_text)
                continue
            seen.add(key_text)
            pairs.append((target, other))
    return pairs

func permute_pairs(matches: List<Element>) -> List<(Element, Element)>
    // Upper triangle: every unordered pair of distinct matches, in match
    // order — (m[0],m[1]), (m[0],m[2]), ..., (m[n-2],m[n-1]).
    pairs: List<(Element, Element)> = []
    for i = 0 to matches.length - 1
        for j = i + 1 to matches.length - 1
            pairs.append((matches[i], matches[j]))
    return pairs

func cross_pairs(left: List<Element>, right: List<Element>) -> List<(Element, Element)>
    // Left-major product, skipping same-name pairs, deduped on the
    // symmetric pair key (a+b == b+a).
    seen: Set<text> = Set()
    pairs: List<(Element, Element)> = []
    for a in left
        for b in right
            if a.name == b.name
                continue
            key = pair_key(a.name, b.name)
            ka, kb = key
            key_text = ka + "\u{0}" + kb
            if seen.has(key_text)
                continue
            seen.add(key_text)
            pairs.append((a, b))
    return pairs

func with_pairs(target: Element, others: List<Element>) -> List<(Element, Element)>
    // Target paired with each other match, in match order; the target
    // itself is skipped. No pair-key dedup needed: others are unique.
    pairs: List<(Element, Element)> = []
    for o in others
        if o.name == target.name
            continue
        pairs.append((target, o))
    return pairs

func sort_elements_by_name(items: inout List<Element>)
    for j = 1 to items.length - 1
        i = j
        while i > 0 and strings.lex_compare(items[i].name, items[i - 1].name) < 0
            items.swap(i, i - 1)
            i = i - 1

func crawl_generation_pairs(pool: List<Element>, tried: Set<text>) -> (List<(Element, Element)>, List<text>)
    // One crawl generation: every untried unordered pair over the pool,
    // INCLUDING self-pairs (j starts at i). owner rulings 2026-08-07 (see
    // DIVERGENCES.md): the pool is iterated in sorted-name order, so pair
    // order is deterministic across hosts regardless of how the pool
    // accumulated. Returns the pairs plus their encoded keys; the caller
    // adds the keys to its tried-set (hosts never build keys themselves).
    sorted_pool = pool
    sort_elements_by_name(sorted_pool)
    pairs: List<(Element, Element)> = []
    new_keys: List<text> = []
    for i = 0 to sorted_pool.length - 1
        for j = i to sorted_pool.length - 1
            key = pair_key(sorted_pool[i].name, sorted_pool[j].name)
            ka, kb = key
            key_text = ka + "\u{0}" + kb
            if tried.has(key_text)
                continue
            pairs.append((sorted_pool[i], sorted_pool[j]))
            new_keys.append(key_text)
    return (pairs, new_keys)

// ---------------------------------------------------------------------------
// Deterministic text sort (hand-rolled; do not use sorting.sudo sort_by)
// FIXME(zig): generic sort_by hits a Rust-backend cross-module inout bug.
// ---------------------------------------------------------------------------

func sort_texts(items: inout List<text>)
    for j = 1 to items.length - 1
        i = j
        while i > 0 and strings.lex_compare(items[i], items[i - 1]) < 0
            items.swap(i, i - 1)
            i = i - 1

func sorted_text_list(items: List<text>) -> List<text>
    out = items
    sort_texts(out)
    return out

// ---------------------------------------------------------------------------
// Recipe BFS / backtrack / trace (unbounded depth)
// ---------------------------------------------------------------------------

func is_available(n: text, visited: Set<text>, recipes: Map<text, List<(text, text)>>) -> bool
    if visited.has(n)
        return true
    if is_base_element(n)
        return true
    entry = recipes.get(n)
    if entry.is_none()
        return true
    return entry.unwrap().length == 0

func compute_layers(target: text, recipes: Map<text, List<(text, text)>>) -> (bool, Map<text, (text, text)>)
    parent: Map<text, (text, text)> = Map()
    visited: Set<text> = Set()
    visited.add("Water")
    visited.add("Fire")
    visited.add("Wind")
    visited.add("Earth")
    found = false
    while not found
        new_names: List<text> = []
        new_pairs: Map<text, (text, text)> = Map()
        keys = sorted_text_list(recipes.keys())
        for result_name in keys
            if visited.has(result_name)
                continue
            if new_pairs.has(result_name)
                continue
            pairs = recipes[result_name]
            for pair in pairs
                pa, pb = pair
                a_ok = is_available(pa, visited, recipes)
                b_ok = is_available(pb, visited, recipes)
                if a_ok and b_ok
                    new_pairs[result_name] = pair
                    new_names.append(result_name)
                    if result_name == target
                        found = true
                    break
        if new_names.length == 0
            break
        for rn in new_names
            pr = new_pairs[rn]
            parent[rn] = pr
            visited.add(rn)
    return (found, parent)

func backtrack_steps(target: text, parent: Map<text, (text, text)>) -> List<RecipeStep>
    resolved: Set<text> = Set()
    resolved.add("Water")
    resolved.add("Fire")
    resolved.add("Wind")
    resolved.add("Earth")
    to_resolve: List<text> = [target]
    steps: List<RecipeStep> = []
    while to_resolve.length > 0
        nm = to_resolve.pop()
        if resolved.has(nm)
            continue
        if not parent.has(nm)
            resolved.add(nm)
            continue
        pr = parent[nm]
        a, b = pr
        deferred = false
        for dep in [a, b]
            if resolved.has(dep)
                continue
            if not parent.has(dep) and not is_base_element(dep)
                resolved.add(dep)
                continue
            to_resolve.append(nm)
            to_resolve.append(dep)
            deferred = true
            break
        if not deferred
            steps.append(RecipeStep(a = a, b = b, result = nm))
            resolved.add(nm)
    return steps

func trace_recipe(elements: List<Element>, recipes: Map<text, List<(text, text)>>, name: text) -> RecipeResult
    stripped = strip_spaces(name)
    elem = get_by_name(elements, stripped)
    if elem.is_none()
        elem = get_by_name(elements, title_case(stripped))
    if elem.is_none()
        return NotFound
    target = elem.unwrap().name
    if is_base_element(target)
        return IsBase(target)
    target_pairs = recipes.get(target).get_or([])
    if target_pairs.length == 0
        return NoRecipe(target)
    found, parent = compute_layers(target, recipes)
    if not found
        return Unreachable(target)
    steps = backtrack_steps(target, parent)
    return Steps(target, steps)

// ---------------------------------------------------------------------------
// Export / prune closure (v1.4.2: recipes-only input)
// ---------------------------------------------------------------------------

func included_element_names(recipes: Map<text, List<(text, text)>>) -> Set<text>
    included: Set<text> = Set()
    included.add("Water")
    included.add("Fire")
    included.add("Wind")
    included.add("Earth")
    keys = sorted_text_list(recipes.keys())
    for name in keys
        pairs = recipes[name]
        if pairs.length > 0
            included.add(name)
    changed = true
    while changed
        changed = false
        names = sorted_text_list(included.items())
        for nm in names
            if not recipes.has(nm)
                continue
            for pair in recipes[nm]
                pa, pb = pair
                if not included.has(pa)
                    included.add(pa)
                    changed = true
                if not included.has(pb)
                    included.add(pb)
                    changed = true
    return included

func orphan_candidates(elements: List<Element>, recipes: Map<text, List<(text, text)>>) -> List<Element>
    included = included_element_names(recipes)
    out: List<Element> = []
    for e in elements
        if not included.has(e.name)
            out.append(e)
    return out

func export_elements(elements: List<Element>, recipes: Map<text, List<(text, text)>>) -> List<Element>
    included = included_element_names(recipes)
    out: List<Element> = []
    for e in elements
        if included.has(e.name)
            out.append(e)
    return out

// ---------------------------------------------------------------------------
// Unfilled predicate
// ---------------------------------------------------------------------------

export func is_unfilled(name: text, recipes: Map<text, List<(text, text)>>) -> bool
    // owner ruling 2026-08-07: an element whose recipes entry exists but is
    // an EMPTY list is unfilled — "we know no way to make it". Key presence
    // alone does not make an element filled (consistent with
    // included_element_names, which seeds only non-empty recipe results).
    // Base elements are never unfilled.
    if is_base_element(name)
        return false
    return recipes.get(name).get_or([]).length == 0

// ---------------------------------------------------------------------------
// Query filter / pattern match (regex.sudo; no safety gates)
// ---------------------------------------------------------------------------

export func parse_query_filter(query: text) -> (text, bool, bool)
    // owner ruling 2026-07-22: '!' (exclude) and '^' (only_new) prefixes
    // combine — both may appear, in either order ('!^x' and '^!x' both
    // set exclude=true and only_new=true). A repeated prefix consumes
    // only its first occurrence; the second instance stays in the
    // pattern text ('!!x' -> pattern "!x", still exclude=true).
    q = strip_spaces(query)
    exclude = false
    only_new = false
    took_bang = false
    took_caret = false
    keep_going = true
    while keep_going
        if q.length > 0 and q[0] == '!' and not took_bang
            exclude = true
            took_bang = true
            q = strip_prefix_one(q)
        else if q.length > 0 and q[0] == '^' and not took_caret
            only_new = true
            took_caret = true
            q = strip_prefix_one(q)
        else
            keep_going = false
    return (q, exclude, only_new)

export func is_delimited_regex(pattern: text) -> bool
    p = strip_spaces(pattern)
    return p.length >= 2 and p[0] == '/' and p[p.length - 1] == '/'

func is_glob_trigger(pattern: text) -> bool
    for c in pattern
        if c == '*' or c == '?' or c == '[' or c == ']'
            return true
    return false

export func element_matches_pattern(name: text, pattern: text) -> (bool, Option<text>)
    pattern = strip_spaces(pattern)
    if pattern.length == 0
        return (false, None)
    if is_delimited_regex(pattern)
        body = text_slice(pattern, 1, pattern.length - 1)
        // owner ruling 2026-07-22 (R4): an empty regex body ("//") is
        // a valid empty pattern that matches every name — standard
        // empty-regex semantics, not a special "no match" case.
        match regex.regex_search(body, name, true)
            case Err(msg)
                assert msg.length >= 0
                return (false, Some("Invalid regex pattern"))
            case Ok(matched)
                return (matched, None)
    if is_glob_trigger(pattern)
        return (regex.glob_match(pattern, name, true), None)
    return (strings.contains(strings.to_lower(name), strings.to_lower(pattern)), None)

func match_elements(elements: List<Element>, query: text) -> (List<Element>, Option<text>)
    empty: List<Element> = []
    if query.length > 512
        return (empty, Some("Query too long (max 512 characters)"))
    q, exclude, only_new = parse_query_filter(query)
    if strip_spaces(q).length == 0
        if exclude
            return (elements, None)
        if only_new
            firsts: List<Element> = []
            for e in elements
                if e.first
                    firsts.append(e)
            return (firsts, None)
        return (empty, None)
    matches: List<Element> = []
    for e in elements
        matched, err = element_matches_pattern(e.name, q)
        if err.is_some()
            return (empty, err)
        if exclude
            if not matched
                matches.append(e)
        else if matched
            matches.append(e)
    if only_new
        filtered: List<Element> = []
        for e in matches
            if e.first
                filtered.append(e)
        return (filtered, None)
    return (matches, None)

// ---------------------------------------------------------------------------
// Slash / command classification & validation
// ---------------------------------------------------------------------------

export func slash_args(line: text, command: text) -> Option<text>
    if line == command
        return Some("")
    prefix = command + " "
    if strings.starts_with(line, prefix)
        return Some(text_from(line, prefix.length))
    return None

export func is_local_command(line: text) -> bool
    if line == "/help" or line == "/list" or line == "/history" or line == "/clear" or line == "/queue"
        return true
    if line == "/unfilled" or strings.starts_with(line, "/unfilled ")
        return true
    if line == "/search" or strings.starts_with(line, "/search ")
        return true
    if line == "/recipe" or strings.starts_with(line, "/recipe ")
        return true
    return false

export func is_slash_command_attempt(line: text) -> bool
    // Port of re.match(r"/[^/]+/", line) then re.match(r"/\w", line).
    if line.length == 0 or line[0] != '/'
        return false
    // Delimited regex at start: /[^/]+/  → not a slash-command attempt.
    if line.length >= 3
        i = 1
        while i < line.length and line[i] != '/'
            i = i + 1
        if i > 1 and i < line.length and line[i] == '/'
            return false
    if line.length >= 2 and is_word_char(line[1])
        return true
    return false

func contains_plus_ws_pipe(s: text) -> bool
    // re.search(r"\+\s+\|", s): '+' then 1+ whitespace then '|'
    i = 0
    while i < s.length
        if s[i] == '+'
            j = i + 1
            if j < s.length and is_ascii_space(s[j])
                while j < s.length and is_ascii_space(s[j])
                    j = j + 1
                if j < s.length and s[j] == '|'
                    return true
        i = i + 1
    return false

func ends_with_space_plus(s: text) -> bool
    // re.search(r" \+$", line.rstrip())
    t = strip_spaces(s)
    // strip_spaces strips both ends; rstrip only trims right — rebuild rstrip.
    end = s.length
    while end > 0 and is_ascii_space(s[end - 1])
        end = end - 1
    if end < 2
        return false
    return s[end - 2] == ' ' and s[end - 1] == '+'

export func classify_command_line(line: text) -> Option<(text, text)>
    line = strip_spaces(line)
    if line.length == 0
        return None
    cmds: List<text> = ["/permute", "/permutate", "/import", "/fill", "/prune", "/export", "/exhaust", "/combine", "/crawl", "/with", "/cross"]
    for cmd in cmds
        rest_opt = slash_args(line, cmd)
        if rest_opt.is_some()
            kind = strip_prefix_one(cmd)
            return Some((kind, rest_opt.unwrap()))
    if is_slash_command_attempt(line)
        return None
    if contains_plus_ws_pipe(line)
        return Some(("bad+|", line))
    if strings.contains(line, " ++ ")
        return Some(("++", line))
    if strings.contains(line, "+|")
        return Some(("+|", line))
    if strings.contains(line, " * ")
        return Some(("*", line))
    if strings.contains(line, " + ") or ends_with_space_plus(line)
        return Some(("+", line))
    return None

export func parse_two_elements(rest: text) -> Option<(text, text)>
    rest = strip_spaces(rest)
    // split(None, 1): first whitespace run
    i = 0
    while i < rest.length and not is_ascii_space(rest[i])
        i = i + 1
    if i >= rest.length
        return None
    first = strip_spaces(text_slice(rest, 0, i))
    second = strip_spaces(text_from(rest, i))
    if first.length == 0 or second.length == 0
        return None
    return Some((first, second))

export func parse_with_args(rest: text) -> Option<(text, text)>
    return parse_two_elements(rest)

export func split_two_positional_args(rest: text) -> Option<(text, text)>
    rest = strip_spaces(rest)
    if rest.length == 0
        return None
    tokens: List<text> = []
    i = 0
    n = rest.length
    while i < n and tokens.length < 2
        while i < n and is_ascii_space(rest[i])
            i = i + 1
        if i >= n
            break
        token: text = ""
        if rest[i] == '/'
            j = i + 1
            found_close = false
            while j < n
                if rest[j] == '/'
                    found_close = true
                    break
                j = j + 1
            if not found_close
                j = i
                while j < n and not is_ascii_space(rest[j])
                    j = j + 1
                token = text_slice(rest, i, j)
                i = j
            else
                token = text_slice(rest, i, j + 1)
                i = j + 1
        else
            j = i
            while j < n and not is_ascii_space(rest[j])
                j = j + 1
            token = text_slice(rest, i, j)
            i = j
        token = strip_spaces(token)
        if token.length > 0
            tokens.append(token)
    if tokens.length != 2
        return None
    while i < n and is_ascii_space(rest[i])
        i = i + 1
    if i < n
        return None
    return Some((tokens[0], tokens[1]))

export func parse_cross_queries(rest: text) -> Option<(text, text)>
    return split_two_positional_args(rest)

// Validation errors are built as SEGMENT lists: (text, highlight) pairs.
// The message text lives here once; hosts only style — the Python CLI wraps
// highlighted segments in ANSI yellow, the browser trainer HTML-escapes every
// segment and wraps highlighted ones in a color span. Plain-text variants
// concatenate the segments unchanged.

func seg_concat(segs: List<(text, bool)>) -> text
    out: text = ""
    for seg in segs
        t, hl = seg
        assert hl == hl
        out = out + t
    return out

func plain_segment(msg: text) -> List<(text, bool)>
    return [(msg, false)]

func query_err_segments(err: Option<text>) -> Option<List<(text, bool)>>
    if err.is_none()
        return None
    return Some(plain_segment(err.unwrap()))

func bad_pipe_segments() -> List<(text, bool)>
    segs: List<(text, bool)> = []
    segs.append(("  Use <element> +| <query> (no space between + and |). Type ", false))
    segs.append(("/help", true))
    segs.append((" for commands.", false))
    return segs

func has_spaced_pipe_payload(rest: text) -> bool
    if contains_plus_ws_pipe(rest)
        return true
    parsed = parse_two_elements(rest)
    if parsed.is_some()
        pfirst, psecond = parsed.unwrap()
        assert pfirst == pfirst
        if psecond.length > 0 and psecond[0] == '|'
            return true
    return false

export func slash_combine_crawl_pipe_error_segments(rest: text) -> Option<List<(text, bool)>>
    if has_spaced_pipe_payload(rest)
        return Some(bad_pipe_segments())
    return None

export func slash_combine_crawl_pipe_error(rest: text) -> Option<text>
    segs = slash_combine_crawl_pipe_error_segments(rest)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

export func slash_combine_crawl_operator_error_segments(rest: text, kind: text) -> Option<List<(text, bool)>>
    if not strings.contains(rest, " + ")
        return None
    idx = strings.index_of(rest, " + ").unwrap()
    left = text_slice(rest, 0, idx)
    right = text_from(rest, idx + 3)
    positional = "/" + kind + " " + strip_spaces(left) + " " + strip_spaces(right)
    segs: List<(text, bool)> = []
    segs.append(("  Slash /" + kind + " uses positional args, not +. Try ", false))
    segs.append((strip_spaces(rest), true))
    segs.append((" (shorthand) or ", false))
    segs.append((positional, true))
    segs.append((".", false))
    return Some(segs)

export func slash_combine_crawl_operator_error(rest: text, kind: text) -> Option<text>
    segs = slash_combine_crawl_operator_error_segments(rest, kind)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

export func slash_cross_operator_error_segments(rest: text) -> Option<List<(text, bool)>>
    if not strings.contains(rest, " * ")
        return None
    idx = strings.index_of(rest, " * ").unwrap()
    left = text_slice(rest, 0, idx)
    right = text_from(rest, idx + 3)
    positional = "/cross " + strip_spaces(left) + " " + strip_spaces(right)
    segs: List<(text, bool)> = []
    segs.append(("  Slash /cross uses positional args, not *. Try ", false))
    segs.append((strip_spaces(rest), true))
    segs.append((" (shorthand) or ", false))
    segs.append((positional, true))
    segs.append((".", false))
    return Some(segs)

export func slash_cross_operator_error(rest: text) -> Option<text>
    segs = slash_cross_operator_error_segments(rest)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

export func validate_query_at_enqueue(query: text) -> Option<text>
    if query.length > 512
        return Some("  Query too long (max 512 characters)")
    q, qf_exclude, qf_only_new = parse_query_filter(query)
    if not is_delimited_regex(q)
        return None
    body = text_slice(q, 1, q.length - 1)
    if not regex.regex_is_valid(body)
        return Some("  Invalid regex pattern")
    return None

func first_ws_token(s: text) -> text
    s = strip_spaces(s)
    i = 0
    while i < s.length and not is_ascii_space(s[i])
        i = i + 1
    return text_slice(s, 0, i)

func split_once(s: text, sep: text) -> (text, text)
    // Split on first occurrence of sep; if missing, (s, "").
    idx_opt = strings.index_of(s, sep)
    if idx_opt.is_none()
        return (s, "")
    idx = idx_opt.unwrap()
    return (text_slice(s, 0, idx), text_from(s, idx + sep.length))

func rsplit_once_space_plus(s: text) -> text
    // payload.rsplit(" +", 1)[0] — last occurrence of " +"
    last = -1
    i = 0
    while i + 1 < s.length
        if s[i] == ' ' and s[i + 1] == '+'
            last = i
        i = i + 1
    if last < 0
        return s
    return text_slice(s, 0, last)

export func parse_operands(kind: text, payload: text) -> Option<(text, text)>
    // Operand extraction for the shorthand kinds returned by
    // classify_command_line ("++", "+|", "*", "+"). Python str.split(sep, 1)
    // semantics: split on the separator's FIRST occurrence, the right side
    // keeps any later separators ("A + B + C" -> ("A", "B + C")).
    // Owner ruling 2026-08-07: JS String.split's second argument is a
    // result-length limit, which silently truncated the tail; maxsplit
    // semantics are canonical.
    left: text = ""
    right: text = ""
    if kind == "++"
        left, right = split_once(payload, " ++ ")
    else if kind == "+|"
        left, right = split_once(payload, "+|")
    else if kind == "*"
        left, right = split_once(payload, " * ")
    else if kind == "+"
        if strings.contains(payload, " + ")
            left, right = split_once(payload, " + ")
        else
            left = rsplit_once_space_plus(payload)
            right = ""
    else
        return None
    l = strip_spaces(left)
    r = strip_spaces(right)
    if l.length == 0 or r.length == 0
        return None
    return Some((l, r))

export func validate_command_line_segments(line: text) -> Option<List<(text, bool)>>
    classified = classify_command_line(line)
    if classified.is_none()
        if is_slash_command_attempt(line)
            cmd = first_ws_token(line)
            segs: List<(text, bool)> = []
            segs.append(("  Unknown command: ", false))
            segs.append((cmd, true))
            segs.append((". Type ", false))
            segs.append(("/help", true))
            segs.append((" for commands.", false))
            return Some(segs)
        unk: List<(text, bool)> = []
        unk.append(("  Unknown input. Type ", false))
        unk.append(("/help", true))
        unk.append((" for commands.", false))
        return Some(unk)
    kind, payload = classified.unwrap()
    if kind == "bad+|"
        return Some(bad_pipe_segments())
    if kind == "permute" or kind == "permutate" or kind == "exhaust" or kind == "import"
        if strip_spaces(payload).length == 0
            if kind == "import"
                return Some(plain_segment("  Usage: /import <element>"))
            return Some(plain_segment("  Usage: /" + kind + " <query>"))
        if kind == "import"
            return None
        return query_err_segments(validate_query_at_enqueue(strip_spaces(payload)))
    if kind == "export" or kind == "fill" or kind == "prune"
        return None
    if kind == "combine" or kind == "crawl"
        pipe_err = slash_combine_crawl_pipe_error_segments(payload)
        if pipe_err.is_some()
            return pipe_err
        op_err = slash_combine_crawl_operator_error_segments(payload, kind)
        if op_err.is_some()
            return op_err
        if parse_two_elements(payload).is_none()
            return Some(plain_segment("  Usage: /" + kind + " <element> <element>"))
        return None
    if kind == "with"
        parsed = parse_with_args(payload)
        if parsed.is_none()
            return Some(plain_segment("  Usage: /with <element> <query>"))
        with_elem, query = parsed.unwrap()
        assert with_elem == with_elem
        return query_err_segments(validate_query_at_enqueue(query))
    if kind == "cross"
        op_err = slash_cross_operator_error_segments(payload)
        if op_err.is_some()
            return op_err
        parsed = parse_cross_queries(payload)
        if parsed.is_none()
            return Some(plain_segment("  Usage: /cross <query> <query>"))
        left_q, right_q = parsed.unwrap()
        err = validate_query_at_enqueue(left_q)
        if err.is_some()
            return query_err_segments(err)
        return query_err_segments(validate_query_at_enqueue(right_q))
    if kind == "++"
        if parse_operands(kind, payload).is_none()
            return Some(plain_segment("  Usage: <element> ++ <element>"))
        return None
    if kind == "+|"
        operands = parse_operands(kind, payload)
        if operands.is_none()
            return Some(plain_segment("  Usage: <element> +| <query>"))
        op_left, op_right = operands.unwrap()
        assert op_left == op_left
        return query_err_segments(validate_query_at_enqueue(op_right))
    if kind == "*"
        operands = parse_operands(kind, payload)
        if operands.is_none()
            return Some(plain_segment("  Usage: <query> * <query>"))
        op_left, op_right = operands.unwrap()
        err = validate_query_at_enqueue(op_left)
        if err.is_some()
            return query_err_segments(err)
        return query_err_segments(validate_query_at_enqueue(op_right))
    if kind == "+"
        if parse_operands(kind, payload).is_none()
            return Some(plain_segment("  Usage: <element> + <element>"))
        return None
    return None

export func validate_command_line(line: text) -> Option<text>
    segs = validate_command_line_segments(line)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

// ---- boundary adapters: tuple/primitive-only shapes for export funcs ----
// Records/enums must not cross export func signatures (toolchain limitation).

func element_from_tuple(t: (text, text, bool)) -> Element
    n, em, f = t
    return Element(name = n, emoji = em, first = f)

func element_to_tuple(e: Element) -> (text, text, bool)
    return (e.name, e.emoji, e.first)

func elements_from_tuples(ts: List<(text, text, bool)>) -> List<Element>
    out: List<Element> = []
    for t in ts
        out.append(element_from_tuple(t))
    return out

func elements_to_tuples(es: List<Element>) -> List<(text, text, bool)>
    out: List<(text, text, bool)> = []
    for e in es
        out.append(element_to_tuple(e))
    return out

func recipe_result_to_tuple(r: RecipeResult) -> (int, text, List<(text, text, text)>)
    match r
        case NotFound
            empty: List<(text, text, text)> = []
            return (0, "", empty)
        case IsBase(n)
            empty: List<(text, text, text)> = []
            return (1, n, empty)
        case NoRecipe(n)
            empty: List<(text, text, text)> = []
            return (2, n, empty)
        case Unreachable(n)
            empty: List<(text, text, text)> = []
            return (3, n, empty)
        case Steps(t, steps)
            out: List<(text, text, text)> = []
            for s in steps
                out.append((s.a, s.b, s.result))
            return (4, t, out)

export func resolve_element_boundary(elements: List<(text, text, bool)>, name: text) -> (text, text, bool)
    return element_to_tuple(resolve_element(elements_from_tuples(elements), name))

export func get_by_name_boundary(elements: List<(text, text, bool)>, name: text) -> Option<(text, text, bool)>
    found = get_by_name(elements_from_tuples(elements), name)
    match found
        case Some(e)
            return Some(element_to_tuple(e))
        case None
            return None

export func add_element_boundary(elements: inout List<(text, text, bool)>, name: text, emoji: text, first: bool) -> bool
    es = elements_from_tuples(elements)
    result = add_element(es, name, emoji, first)
    elements = elements_to_tuples(es)
    return result

export func add_elements_batch_boundary(elements: inout List<(text, text, bool)>, items: List<(text, text, bool)>) -> int
    es = elements_from_tuples(elements)
    result = add_elements_batch(es, items)
    elements = elements_to_tuples(es)
    return result

export func trace_recipe_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>, name: text) -> (int, text, List<(text, text, text)>)
    r = trace_recipe(elements_from_tuples(elements), recipes, name)
    return recipe_result_to_tuple(r)

export func included_element_names_boundary(recipes: Map<text, List<(text, text)>>) -> List<text>
    return sorted_text_list(included_element_names(recipes).items())

export func orphan_candidates_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<(text, text, bool)>
    return elements_to_tuples(orphan_candidates(elements_from_tuples(elements), recipes))

export func export_elements_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<(text, text, bool)>
    return elements_to_tuples(export_elements(elements_from_tuples(elements), recipes))

export func match_elements_boundary(elements: List<(text, text, bool)>, query: text) -> (List<(text, text, bool)>, Option<text>)
    matches, err = match_elements(elements_from_tuples(elements), query)
    return (elements_to_tuples(matches), err)

func element_pairs_to_boundary(pairs: List<(Element, Element)>) -> List<(text, text, bool, text, text, bool)>
    out: List<(text, text, bool, text, text, bool)> = []
    for p in pairs
        a, b = p
        out.append((a.name, a.emoji, a.first, b.name, b.emoji, b.first))
    return out

export func exhaust_pairs_boundary(matches: List<(text, text, bool)>, all_elements: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(exhaust_pairs(elements_from_tuples(matches), elements_from_tuples(all_elements)))

export func permute_pairs_boundary(matches: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(permute_pairs(elements_from_tuples(matches)))

export func cross_pairs_boundary(left: List<(text, text, bool)>, right: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(cross_pairs(elements_from_tuples(left), elements_from_tuples(right)))

export func with_pairs_boundary(target: (text, text, bool), others: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(with_pairs(element_from_tuple(target), elements_from_tuples(others)))

export func crawl_generation_pairs_boundary(pool: List<(text, text, bool)>, tried_keys: List<text>) -> (List<(text, text, bool, text, text, bool)>, List<text>)
    tried: Set<text> = Set()
    for k in tried_keys
        tried.add(k)
    pairs, new_keys = crawl_generation_pairs(elements_from_tuples(pool), tried)
    return (element_pairs_to_boundary(pairs), new_keys)

export func unfilled_names_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<text>
    // Element-list order is preserved (both hosts display in storage order).
    out: List<text> = []
    for e in elements_from_tuples(elements)
        if is_unfilled(e.name, recipes)
            out.append(e.name)
    return out

// ---- import/export folds ----
// Hosts do JSON traversal and I/O only; id resolution, name sanitization,
// dedup, and id remapping all happen here.

export func ic_save_to_batches(items: List<(int, text, text, bool)>, recipe_refs: List<(int, int, int)>) -> (List<(text, text, bool)>, List<(text, text, text)>)
    // .ic save import: items are (id, text, emoji, discovered) — the host
    // merges the save's discovery/discovered spellings into one flag —
    // and recipe_refs are (result_id, a_id, b_id). Names are sanitized;
    // refs whose ids don't resolve are dropped (no dangling references).
    id_name: Map<text, text> = Map()
    elements: List<(text, text, bool)> = []
    for it in items
        iid, txt, em, disc = it
        nm = sanitize_element_name(txt)
        // Missing or all-control text sanitizes to "": skip the item
        // entirely — its id stays unresolvable, so refs to it drop too.
        if nm.length == 0
            continue
        id_name[int_to_text(iid)] = nm
        elements.append((nm, em, disc))
    recipes_out: List<(text, text, text)> = []
    for ref in recipe_refs
        rid, aid, bid = ref
        rk = int_to_text(rid)
        ak = int_to_text(aid)
        bk = int_to_text(bid)
        if not id_name.has(rk) or not id_name.has(ak) or not id_name.has(bk)
            continue
        recipes_out.append((id_name[rk], id_name[ak], id_name[bk]))
    return (elements, recipes_out)

func lineage_add_unique(elements: inout List<(text, text, bool)>, seen: inout Set<text>, name: text, emoji: text)
    if seen.has(name)
        return
    seen.add(name)
    elements.append((name, emoji, false))

export func lineage_steps_to_batches(steps: List<(text, text, text, text, text, text)>) -> (List<(text, text, bool)>, List<(text, text, text)>)
    // Infinibrowser lineage fold: steps are (a_name, a_emoji, b_name,
    // b_emoji, result_name, result_emoji), after the host's tolerant
    // id-or-text JSON extraction. Names are sanitized; steps with any
    // empty name are skipped (owner ruling 2026-08-07: tolerate malformed
    // payloads instead of erroring). The element batch is deduped by name
    // (first occurrence wins, a/b/result order per step); the recipe
    // batch stays in step order.
    seen: Set<text> = Set()
    elements: List<(text, text, bool)> = []
    recipes_out: List<(text, text, text)> = []
    for st in steps
        a_raw, a_em, b_raw, b_em, r_raw, r_em = st
        a = sanitize_element_name(a_raw)
        b = sanitize_element_name(b_raw)
        r = sanitize_element_name(r_raw)
        if a.length == 0 or b.length == 0 or r.length == 0
            continue
        recipes_out.append((r, a, b))
        lineage_add_unique(elements, seen, a, a_em)
        lineage_add_unique(elements, seen, b, b_em)
        lineage_add_unique(elements, seen, r, r_em)
    return (elements, recipes_out)

export func build_export_items_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> (List<(int, text, text, bool)>, List<(int, int, int)>)
    // .ic export builder (owner ruling 2026-08-07): fresh sequential ids
    // 0..n over the export closure in input (storage) order, recipe pairs
    // remapped to those ids, pairs referencing excluded elements dropped —
    // an export can never contain a dangling id.
    selected = export_elements(elements_from_tuples(elements), recipes)
    name_id: Map<text, int> = Map()
    items: List<(int, text, text, bool)> = []
    idx = 0
    for e in selected
        name_id[e.name] = idx
        items.append((idx, e.name, e.emoji, e.first))
        idx = idx + 1
    refs: List<(int, int, int)> = []
    for e in selected
        if not recipes.has(e.name)
            continue
        for pair in recipes[e.name]
            pa, pb = pair
            if name_id.has(pa) and name_id.has(pb)
                refs.append((name_id[e.name], name_id[pa], name_id[pb]))
    return (items, refs)

// ===========================================================================
// Tests
// ===========================================================================

func parity_fixture() -> List<Element>
    els: List<Element> = []
    els.append(Element(name = "Water", emoji = "💧", first = false))
    els.append(Element(name = "Fire", emoji = "🔥", first = false))
    els.append(Element(name = "Wind", emoji = "🌬️", first = false))
    els.append(Element(name = "Earth", emoji = "🌍", first = false))
    els.append(Element(name = "Firewall", emoji = "🧱", first = true))
    return els

func match_names(els: List<Element>, query: text) -> (Set<text>, Option<text>)
    matches, err = match_elements(els, query)
    names: Set<text> = Set()
    for e in matches
        names.add(e.name)
    return (names, err)

test "is_local_command parity"
    assert is_local_command("/help")
    assert is_local_command("/list")
    assert is_local_command("/history")
    assert is_local_command("/clear")
    assert is_local_command("/queue")
    assert is_local_command("/unfilled")
    assert is_local_command("/unfilled extra")
    assert is_local_command("/search")
    assert is_local_command("/search water")
    assert is_local_command("/recipe")
    assert is_local_command("/recipe Fire")
    assert not is_local_command("/combine Water + Fire")
    assert not is_local_command("/fill")
    assert not is_local_command("/prune")
    assert not is_local_command("/permutate w*")
    assert not is_local_command("Water + Fire")

test "parse_query_filter parity"
    p, ex, on = parse_query_filter("!fire*")
    assert p == "fire*"
    assert ex
    assert not on
    p, ex, on = parse_query_filter("!")
    assert p == ""
    assert ex
    assert not on
    p, ex, on = parse_query_filter("!  ")
    assert p == ""
    assert ex
    assert not on
    p, ex, on = parse_query_filter("^fire*")
    assert p == "fire*"
    assert not ex
    assert on
    p, ex, on = parse_query_filter("^")
    assert p == ""
    assert not ex
    assert on
    p, ex, on = parse_query_filter("/^fi/")
    assert p == "/^fi/"
    assert not ex
    assert not on
    p, ex, on = parse_query_filter("water")
    assert p == "water"
    assert not ex
    assert not on
    // owner ruling 2026-07-22: prefixes combine, either order
    p, ex, on = parse_query_filter("!^steam*")
    assert p == "steam*"
    assert ex
    assert on
    p, ex, on = parse_query_filter("^!steam*")
    assert p == "steam*"
    assert ex
    assert on
    // owner ruling 2026-07-22: repeated prefix consumes only the first
    // occurrence; the second stays in the pattern text
    p, ex, on = parse_query_filter("!!x")
    assert p == "!x"
    assert ex
    assert not on
    p, ex, on = parse_query_filter("^^x")
    assert p == "^x"
    assert not ex
    assert on

test "match_elements parity fixture"
    els = parity_fixture()
    names, err = match_names(els, "!fire*")
    assert err.is_none()
    assert names.has("Water")
    assert names.has("Wind")
    assert names.has("Earth")
    assert not names.has("Fire")
    assert not names.has("Firewall")
    names, err = match_names(els, "!")
    assert err.is_none()
    assert names.has("Water")
    assert names.has("Fire")
    assert names.has("Wind")
    assert names.has("Earth")
    assert names.has("Firewall")
    names, err = match_names(els, "!/wall/")
    assert err.is_none()
    assert names.has("Water")
    assert names.has("Fire")
    assert names.has("Wind")
    assert names.has("Earth")
    assert not names.has("Firewall")
    names, err = match_names(els, "^fire*")
    assert err.is_none()
    assert names.has("Firewall")
    assert not names.has("Fire")
    names, err = match_names(els, "/^fi/")
    assert err.is_none()
    assert names.has("Fire")
    assert names.has("Firewall")
    assert not names.has("Water")
    // owner ruling 2026-07-22: combined prefixes work end-to-end through
    // match_elements too (exclude AND only_new applied together)
    names, err = match_names(els, "!^wind")
    assert err.is_none()
    assert names.has("Firewall")
    assert names.items().length == 1
    names, err = match_names(els, "^!wind")
    assert err.is_none()
    assert names.has("Firewall")
    assert names.items().length == 1

test "parse_two_elements and cross helpers"
    r = parse_two_elements("Water Fire")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "Water"
    assert b == "Fire"
    r = parse_two_elements("Water + Fire")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "Water"
    assert b == "+ Fire"
    assert parse_two_elements("Water+Fire").is_none()
    assert parse_two_elements("fire").is_none()
    r = parse_cross_queries("fire* water*")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "fire*"
    assert b == "water*"
    r = split_two_positional_args("/a b/ /c d/")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "/a b/"
    assert b == "/c d/"
    r = parse_with_args("Water fire*")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "Water"
    assert b == "fire*"

test "classify_command_line parity"
    c = classify_command_line("Water + | Fire")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "bad+|"
    c = classify_command_line("Water +| Fire")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "+|"
    c = classify_command_line("/^fi/ * /^wa/")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "*"
    c = classify_command_line("/combine Water + Fire")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "combine"
    assert p == "Water + Fire"
    c = classify_command_line("/combine Water + | Fire")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "combine"
    c = classify_command_line("Water +")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "+"
    c = classify_command_line("Water + Fire")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "+"
    assert not is_slash_command_attempt("/^fi/ * /^wa/")
    assert is_slash_command_attempt("/notacommand")
    assert not is_slash_command_attempt("Water + Fire")

test "validate_command_line error presence"
    assert validate_command_line("/combine Water Fire").is_none()
    assert validate_command_line("/crawl Water Fire").is_none()
    assert validate_command_line("/cross Water Fire").is_none()
    assert validate_command_line("/combine Water + Fire").is_some()
    assert validate_command_line("/cross fire* * water*").is_some()
    assert validate_command_line("Water + | Fire").is_some()
    assert validate_command_line("/combine Water + | Fire").is_some()
    assert validate_command_line("Water +").is_some()
    assert validate_command_line("Water + Fire").is_none()
    assert validate_command_line("/^fi/ * /^wa/").is_none()
    assert validate_command_line("/cross /^fi/ /^wa/").is_none()
    assert validate_command_line("/^fi/").is_some()
    assert validate_command_line("/notacommand").is_some()
    assert validate_command_line("Water Fire").is_some()
    assert validate_command_line("/permute").is_some()
    assert validate_command_line("/with Water").is_some()
    assert validate_command_line("Water ++").is_some()
    assert validate_command_line("/import").is_some()

test "parse_operands maxsplit semantics"
    // The tail keeps later separators (Python split(sep, 1) semantics) —
    // these four inputs are exactly where the old JS length-limit split
    // truncated the second operand.
    r = parse_operands("+", "A + B + C")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "A"
    assert b == "B + C"
    r = parse_operands("++", "A ++ B ++ C")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "A"
    assert b == "B ++ C"
    r = parse_operands("+|", "A+|b+|c")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "A"
    assert b == "b+|c"
    r = parse_operands("*", "x * y * z")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "x"
    assert b == "y * z"
    r = parse_operands("+", "Water + Fire")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "Water"
    assert b == "Fire"
    // operands are stripped
    r = parse_operands("+|", "  Water  +|  fire*  ")
    assert r.is_some()
    a, b = r.unwrap()
    assert a == "Water"
    assert b == "fire*"
    // missing/empty operands
    assert parse_operands("+", "Water +").is_none()
    assert parse_operands("+", "Water").is_none()
    assert parse_operands("++", "A ++ ").is_none()
    assert parse_operands("++", " ++ B").is_none()
    assert parse_operands("+|", "A+|").is_none()
    assert parse_operands("*", " * y").is_none()
    // non-shorthand kinds are not this function's job
    assert parse_operands("combine", "Water Fire").is_none()
    assert parse_operands("", "Water + Fire").is_none()

test "validate_command_line exact messages"
    err = validate_command_line("/combine Water + Fire")
    assert err.is_some()
    assert err.unwrap() == "  Slash /combine uses positional args, not +. Try Water + Fire (shorthand) or /combine Water Fire."
    err = validate_command_line("/cross fire* * water*")
    assert err.is_some()
    assert err.unwrap() == "  Slash /cross uses positional args, not *. Try fire* * water* (shorthand) or /cross fire* water*."
    err = validate_command_line("Water + | Fire")
    assert err.is_some()
    assert err.unwrap() == "  Use <element> +| <query> (no space between + and |). Type /help for commands."
    err = validate_command_line("/combine Water + | Fire")
    assert err.is_some()
    assert err.unwrap() == "  Use <element> +| <query> (no space between + and |). Type /help for commands."
    err = validate_command_line("Water +")
    assert err.is_some()
    assert err.unwrap() == "  Usage: <element> + <element>"
    err = validate_command_line("/^fi/")
    assert err.is_some()
    assert err.unwrap() == "  Unknown input. Type /help for commands."
    err = validate_command_line("/notacommand")
    assert err.is_some()
    assert err.unwrap() == "  Unknown command: /notacommand. Type /help for commands."
    err = validate_command_line("Water Fire")
    assert err.is_some()
    assert err.unwrap() == "  Unknown input. Type /help for commands."
    err = validate_command_line("/crawl Banana")
    assert err.is_some()
    assert err.unwrap() == "  Usage: /crawl <element> <element>"

test "validate_command_line segments highlights"
    segs_opt = validate_command_line_segments("/notacommand")
    assert segs_opt.is_some()
    segs = segs_opt.unwrap()
    assert segs.length == 5
    t0, h0 = segs[0]
    assert t0 == "  Unknown command: "
    assert not h0
    t1, h1 = segs[1]
    assert t1 == "/notacommand"
    assert h1
    t3, h3 = segs[3]
    assert t3 == "/help"
    assert h3
    op_segs = slash_combine_crawl_operator_error_segments("Water + Fire", "combine")
    assert op_segs.is_some()
    o = op_segs.unwrap()
    assert o.length == 5
    s1t, s1h = o[1]
    assert s1t == "Water + Fire"
    assert s1h
    s3t, s3h = o[3]
    assert s3t == "/combine Water Fire"
    assert s3h
    x_segs = slash_cross_operator_error_segments("fire* * water*")
    assert x_segs.is_some()
    x = x_segs.unwrap()
    x3t, x3h = x[3]
    assert x3t == "/cross fire* water*"
    assert x3h
    // segments concat == plain validate for every error shape
    for bad_line in ["Water +", "/notacommand", "Water Fire", "/combine Water + Fire", "Water + | Fire", "/permute", "/with Water", "/cross fire* * water*", "/^fi/"]
        v = validate_command_line(bad_line)
        assert v.is_some()
        sv = validate_command_line_segments(bad_line)
        assert sv.is_some()
        assert seg_concat(sv.unwrap()) == v.unwrap()
    // no-error lines yield no segments
    assert validate_command_line_segments("Water + Fire").is_none()
    assert validate_command_line_segments("/combine Water Fire").is_none()

test "pair_key and exhaust_pairs parity"
    k1 = pair_key("Water", "Fire")
    k2 = pair_key("Fire", "Water")
    a1, b1 = k1
    a2, b2 = k2
    assert a1 == a2
    assert b1 == b2
    matches: List<Element> = []
    matches.append(Element(name = "Water", emoji = "", first = false))
    matches.append(Element(name = "Wind", emoji = "", first = false))
    all_els: List<Element> = []
    all_els.append(Element(name = "Water", emoji = "", first = false))
    all_els.append(Element(name = "Wind", emoji = "", first = false))
    all_els.append(Element(name = "Fire", emoji = "", first = false))
    all_els.append(Element(name = "Earth", emoji = "", first = false))
    pairs = exhaust_pairs(matches, all_els)
    assert pairs.length == 5
    keys: Set<text> = Set()
    for p in pairs
        ta, tb = p
        pk = pair_key(ta.name, tb.name)
        ka, kb = pk
        keys.add(ka + "\u{0}" + kb)
    assert keys.items().length == 5

test "permute cross with pair generation"
    a = Element(name = "A", emoji = "", first = false)
    b = Element(name = "B", emoji = "", first = false)
    c = Element(name = "C", emoji = "", first = false)
    // permute: upper triangle in match order
    pp = permute_pairs([a, b, c])
    assert pp.length == 3
    p0a, p0b = pp[0]
    assert p0a.name == "A"
    assert p0b.name == "B"
    p1a, p1b = pp[1]
    assert p1a.name == "A"
    assert p1b.name == "C"
    p2a, p2b = pp[2]
    assert p2a.name == "B"
    assert p2b.name == "C"
    single: List<Element> = [a]
    assert permute_pairs(single).length == 0
    empty_els: List<Element> = []
    assert permute_pairs(empty_els).length == 0
    // cross: left-major, same-name skipped, symmetric dedup
    cp = cross_pairs([a, b], [b, c])
    // (A,B), (A,C), (B,C) — B+B skipped
    assert cp.length == 3
    c0a, c0b = cp[0]
    assert c0a.name == "A"
    assert c0b.name == "B"
    c1a, c1b = cp[1]
    assert c1a.name == "A"
    assert c1b.name == "C"
    c2a, c2b = cp[2]
    assert c2a.name == "B"
    assert c2b.name == "C"
    // overlap dedup: (A,B) from left-major once only even if reversed later
    cp2 = cross_pairs([a, b], [b, a])
    assert cp2.length == 1
    // with: target x others, self skipped, order preserved
    wp = with_pairs(b, [a, b, c])
    assert wp.length == 2
    w0a, w0b = wp[0]
    assert w0a.name == "B"
    assert w0b.name == "A"
    w1a, w1b = wp[1]
    assert w1a.name == "B"
    assert w1b.name == "C"
    // boundary adapters
    tuples: List<(text, text, bool)> = [("A", "", false), ("B", "", false), ("C", "", false)]
    assert permute_pairs_boundary(tuples).length == 3
    bn, be, bf, cn, ce, cf = permute_pairs_boundary(tuples)[2]
    assert bn == "B"
    assert cn == "C"
    left_t: List<(text, text, bool)> = [("A", "", false), ("B", "", false)]
    right_t: List<(text, text, bool)> = [("B", "", false), ("C", "", false)]
    assert cross_pairs_boundary(left_t, right_t).length == 3
    assert with_pairs_boundary(("B", "", false), tuples).length == 2

test "element_matches_pattern branches"
    m, err = element_matches_pattern("Firewall", "fire*")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("Water", "fire*")
    assert err.is_none()
    assert not m
    m, err = element_matches_pattern("Fire", "/^fi/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("Steam", "tea")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("Steam", "")
    assert err.is_none()
    assert not m
    m, err = element_matches_pattern("x", "/[abc/")
    assert err.is_some()
    assert err.unwrap() == "Invalid regex pattern"
    assert not m
    m, err = element_matches_pattern("//", "//")
    // owner ruling 2026-07-22 (R4): empty regex body matches every name
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("Anything At All", "//")
    assert err.is_none()
    assert m

test "match_elements exclude only_new error abort"
    els = parity_fixture()
    matches, err = match_elements(els, "")
    assert err.is_none()
    assert matches.length == 0
    matches, err = match_elements(els, "^")
    assert err.is_none()
    assert matches.length == 1
    assert matches[0].name == "Firewall"
    matches, err = match_elements(els, "zzzz")
    assert err.is_none()
    assert matches.length == 0
    // invalid regex aborts and discards partial matches
    matches, err = match_elements(els, "/[abc/")
    assert err.is_some()
    assert err.unwrap() == "Invalid regex pattern"
    assert matches.length == 0
    // query too long
    long_q = repeat_char('a', 513)
    matches, err = match_elements(els, long_q)
    assert err.is_some()
    assert err.unwrap() == "Query too long (max 512 characters)"
    assert matches.length == 0

test "ex-gate pathological patterns now work"
    // 12+ wildcards glob
    assert regex.glob_match("*a*b*c*d*e*f*g*h*", "axbxcxdxexfxgxh", true)
    m, err = element_matches_pattern("axbxcxdxexfxgxh", "*a*b*c*d*e*f*g*h*")
    assert err.is_none()
    assert m
    // delimited regex body longer than 200
    body = repeat_char('a', 201)
    pat = "/" + body + "/"
    m, err = element_matches_pattern(body, pat)
    assert err.is_none()
    assert m
    m, err = element_matches_pattern(repeat_char('a', 200), pat)
    assert err.is_none()
    assert not m
    // /a|b/ is now real alternation (a OR b), not a literal 3-char pipe
    // run — see DIVERGENCES.md ruling: upstream both hosts reject any '|'
    // as "too complex"; kernel's linear-time NFA engine makes that fear
    // obsolete, so it performs real alternation instead.
    m, err = element_matches_pattern("xa|by", "/a|b/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("a", "/a|b/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("b", "/a|b/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("xyz", "/a|b/")
    assert err.is_none()
    assert not m
    // validate_query accepts long/pipe patterns (no "too complex")
    assert validate_query_at_enqueue("/a|b/").is_none()
    assert validate_query_at_enqueue(pat).is_none()
    assert validate_query_at_enqueue("/[abc/").is_some()
    assert validate_query_at_enqueue("/[abc/").unwrap() == "  Invalid regex pattern"

test "element_matches_pattern real alternation cat or dog"
    m, err = element_matches_pattern("Watchdog", "/cat|dog/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("Elephant", "/cat|dog/")
    assert err.is_none()
    assert not m

test "element_matches_pattern backslash escape digits"
    m, err = element_matches_pattern("Area 51", "/\\d+/")
    assert err.is_none()
    assert m
    m, err = element_matches_pattern("AreaX", "/\\d+/")
    assert err.is_none()
    assert not m

test "trace_recipe unbounded depth over 200 layers"
    els: List<Element> = []
    recipes: Map<text, List<(text, text)>> = Map()
    recipes["C0"] = [("Fire", "Water")]
    els.append(Element(name = "C0", emoji = "", first = false))
    for i = 1 to 300
        name = "C" + int_to_text(i)
        prev = "C" + int_to_text(i - 1)
        recipes[name] = [(prev, "Water")]
        els.append(Element(name = name, emoji = "", first = false))
    r = trace_recipe(els, recipes, "C300")
    match r
        case Steps(t, steps)
            assert t == "C300"
            assert steps.length == 301
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0

test "included_element_names orphan export v1.4.2"
    els: List<Element> = []
    els.append(Element(name = "Water", emoji = "", first = false))
    els.append(Element(name = "Fire", emoji = "", first = false))
    els.append(Element(name = "Wind", emoji = "", first = false))
    els.append(Element(name = "Earth", emoji = "", first = false))
    els.append(Element(name = "Steam", emoji = "", first = false))
    els.append(Element(name = "Mystery Gas", emoji = "", first = false))
    els.append(Element(name = "Orphan", emoji = "", first = false))
    recipes: Map<text, List<(text, text)>> = Map()
    recipes["Steam"] = [("Mystery Gas", "Water")]
    included = included_element_names(recipes)
    assert included.has("Water")
    assert included.has("Fire")
    assert included.has("Wind")
    assert included.has("Earth")
    assert included.has("Steam")
    assert included.has("Mystery Gas")
    assert not included.has("Orphan")
    exported = export_elements(els, recipes)
    assert exported.length == 6
    orphans = orphan_candidates(els, recipes)
    assert orphans.length == 1
    assert orphans[0].name == "Orphan"
    // empty recipe list does not include the result name
    recipes2: Map<text, List<(text, text)>> = Map()
    empty_pairs: List<(text, text)> = []
    recipes2["Ghost"] = empty_pairs
    included2 = included_element_names(recipes2)
    assert not included2.has("Ghost")

test "crawl_generation_pairs sorted order tried and self-pairs"
    w = Element(name = "Water", emoji = "", first = false)
    f = Element(name = "Fire", emoji = "", first = false)
    pool: List<Element> = [w, f]
    tried: Set<text> = Set()
    pairs, keys = crawl_generation_pairs(pool, tried)
    // pool insertion order is Water,Fire; sorted-name ruling gives Fire
    // first; self-pairs included: (Fire,Fire), (Fire,Water), (Water,Water)
    assert pairs.length == 3
    assert keys.length == 3
    p0a, p0b = pairs[0]
    assert p0a.name == "Fire"
    assert p0b.name == "Fire"
    p1a, p1b = pairs[1]
    assert p1a.name == "Fire"
    assert p1b.name == "Water"
    p2a, p2b = pairs[2]
    assert p2a.name == "Water"
    assert p2b.name == "Water"
    // feeding the returned keys back marks everything tried
    tried2: Set<text> = Set()
    for k in keys
        tried2.add(k)
    pairs2, keys2 = crawl_generation_pairs(pool, tried2)
    assert pairs2.length == 0
    assert keys2.length == 0
    // boundary round-trip
    pool_t: List<(text, text, bool)> = [("Water", "", false), ("Fire", "", false)]
    empty_keys: List<text> = []
    bp, bk = crawl_generation_pairs_boundary(pool_t, empty_keys)
    assert bp.length == 3
    assert bk.length == 3
    bp2, bk2 = crawl_generation_pairs_boundary(pool_t, bk)
    assert bp2.length == 0
    assert bk2.length == 0

test "is_unfilled empty list ruling"
    recipes: Map<text, List<(text, text)>> = Map()
    empty_pairs: List<(text, text)> = []
    recipes["Ghost"] = empty_pairs
    recipes["Steam"] = [("Fire", "Water")]
    // owner ruling 2026-08-07: empty list = unfilled, absent = unfilled,
    // non-empty = filled, base elements never unfilled
    assert is_unfilled("Ghost", recipes)
    assert is_unfilled("Mystery", recipes)
    assert not is_unfilled("Steam", recipes)
    assert not is_unfilled("Water", recipes)
    els: List<(text, text, bool)> = [("Water", "", false), ("Ghost", "", false), ("Steam", "", false), ("Mystery", "", false)]
    un = unfilled_names_boundary(els, recipes)
    assert un.length == 2
    assert un[0] == "Ghost"
    assert un[1] == "Mystery"

test "title_case resolve get_by_name add record"
