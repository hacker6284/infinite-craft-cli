// Pure host-adapter-free Infinite Craft kernel (v2 / CLI v1.4.2).
// Single kernel behavior = Python CLI. No `_js` siblings.
// Matching uses vendored regex.sudo (linear-time; no safety gates/timeouts).

import std.strings
import std.regex
import std.sorting

record Element
    name: text
    emoji: text
    first: bool

record RecipeStep
    a: text
    b: text
    result: text

enum RecipeResult
    NotFound
    IsBase(name: text)
    NoRecipe(name: text)
    Unreachable(name: text)
    Steps(target: text, steps: List<RecipeStep>)

// ---------------------------------------------------------------------------
// Base elements
// ---------------------------------------------------------------------------

export func is_base_element(name: text) -> bool
    return name == "Water" or name == "Fire" or name == "Wind" or name == "Earth"

// ---------------------------------------------------------------------------
// ASCII char helpers
// ---------------------------------------------------------------------------

func upper_char(c: int) -> int
    if c >= 'a' and c <= 'z'
        return c - 32
    return c

func lower_char(c: int) -> int
    if c >= 'A' and c <= 'Z'
        return c + 32
    return c

func is_alpha_ascii(c: int) -> bool
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')

func is_word_char(c: int) -> bool
    // Python regex \w = [A-Za-z0-9_]
    return is_alpha_ascii(c) or (c >= '0' and c <= '9') or c == '_'

// ---------------------------------------------------------------------------
// strip / substring helpers (stdlib has no trim/slice)
// ---------------------------------------------------------------------------

func is_ascii_space(c: int) -> bool
    return c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12

func strip_spaces(s: text) -> text
    start = 0
    end = s.length
    while start < end and is_ascii_space(s[start])
        start = start + 1
    while end > start and is_ascii_space(s[end - 1])
        end = end - 1
    out: text = ""
    for i = start to end - 1
        out.append(s[i])
    return out

func strip_prefix_one(s: text) -> text
    out: text = ""
    for i = 1 to s.length - 1
        out.append(s[i])
    return out

func text_slice(s: text, start: int, end: int) -> text
    out: text = ""
    i = start
    while i < end and i < s.length
        out.append(s[i])
        i = i + 1
    return out

func text_from(s: text, start: int) -> text
    return text_slice(s, start, s.length)

// Hand-rolled base-10 conversion — sudo has no built-in int-to-text.
func int_to_text(n: int) -> text
    if n == 0
        return "0"
    if n < 0
        return "-" + int_to_text(0 - n)
    digits: List<int> = []
    x = n
    while x > 0
        digits.append(x mod 10)
        x = x / 10
    out: text = ""
    for i = digits.length - 1 downto 0
        out.append('0' + digits[i])
    return out

func repeat_char(c: int, n: int) -> text
    out: text = ""
    for i = 1 to n
        out.append(c)
    return out

// ---------------------------------------------------------------------------
// Title-casing — ASCII approximation of Python str.title(), with one
// intentional divergence: apostrophes do not start a new word.
// ---------------------------------------------------------------------------

func is_apostrophe(c: int) -> bool
    // ASCII ' (39) and Unicode right single quotation mark U+2019 (8217),
    // which paste/autocorrect often produce in contractions like "don't".
    return c == 39 or c == 8217

export func title_case(s: text) -> text
    // Like Python str.title() for spaces/punctuation/digits, with a targeted
    // fix for apostrophes in Infinite Craft names:
    //
    // Python title() resets the word boundary on every non-letter, so
    // "you don't" becomes "You Don'T". That form both misses stored
    // contraction names and is sent to the pair API for undiscovered
    // operands (screenshot: `Beach + You Don't` → displayed/sent as
    // `You Don'T` → Nothing).
    //
    // Rule: an apostrophe does not start a new word when the letters so
    // far in the current word are a multi-letter stem (don't → Don't,
    // baker's → Baker's). A single letter before the apostrophe still
    // capitalizes the next letter (o'brien → O'Brien), matching names
    // like O'Brien / O'Clock.
    out: text = ""
    prev_cased = false
    letters_in_word = 0
    for c in s
        if is_alpha_ascii(c)
            // Capitalize when starting a word, or right after an
            // apostrophe that followed a single-letter stem (O'Brien).
            start_word = not prev_cased
            if start_word
                out.append(upper_char(c))
            else
                out.append(lower_char(c))
            prev_cased = true
            letters_in_word = letters_in_word + 1
        else if is_apostrophe(c)
            out.append(c)
            // Multi-letter stem (don't): stay in-word so 't' stays lower.
            // Single-letter stem (o'): drop in-word so 'b' capitalizes.
            if letters_in_word == 1
                prev_cased = false
            // else leave prev_cased true; letters_in_word unchanged
        else
            out.append(c)
            prev_cased = false
            letters_in_word = 0
    return out

// ---------------------------------------------------------------------------
// Element-name storage normalization
// ---------------------------------------------------------------------------

export func sanitize_element_name(name: text) -> text
    // Normalization applied to API/import element names before storage
    // (owner ruling 2026-08-07): strip ASCII whitespace at both ends, then
    // drop control characters — C0 (U+0000–U+001F), DEL (U+007F), C1
    // (U+0080–U+009F) — and the Unicode line/paragraph separators
    // U+2028/U+2029. Hosts may additionally sanitize for DISPLAY (TTY
    // escapes, DOM escaping) at print time; this is the only normalization
    // that decides what gets persisted, so both hosts store identical
    // names for identical payloads.
    out: text = ""
    for c in strip_spaces(name)
        if c < 32 or c == 127 or (c >= 128 and c <= 159) or c == 8232 or c == 8233
            continue
        out.append(c)
    return out

// ---------------------------------------------------------------------------
// Name lookup / resolve
// ---------------------------------------------------------------------------

func get_by_name(elements: List<Element>, name: text) -> Option<Element>
    for e in elements
        if e.name == name
            return Some(e)
    return None

func ascii_lower_text(s: text) -> text
    out: text = ""
    for c in s
        out.append(lower_char(c))
    return out

func get_by_name_ci(elements: List<Element>, name: text) -> Option<Element>
    // ASCII case-insensitive scan only — first hit wins. Apostrophe code
    // points are NOT folded: the live pair API treats "You Don't" (U+0027)
    // and "You Don't" (U+2019) as distinct element names, so inventory and
    // resolve must keep them separate.
    needle = ascii_lower_text(name)
    for e in elements
        if ascii_lower_text(e.name) == needle
            return Some(e)
    return None

func resolve_element(elements: List<Element>, name: text) -> Element
    // Lookups are inlined (not get_by_name / get_by_name_ci). sudoc deep-copies
    // every List parameter on entry, so calling those helpers would re-dup the
    // entire inventory up to four times per resolve — multi-second on large
    // saves when hosts format multi-step /recipe output. One list ownership
    // here, several linear scans.
    for e in elements
        if e.name == name
            return e
    stripped = strip_spaces(name)
    if not (stripped == name)
        for e in elements
            if e.name == stripped
                return e
    // title_case preserves the input's apostrophe code point (straight or
    // curly); it only changes letter case.
    title = title_case(stripped)
    if not (title == stripped)
        for e in elements
            if e.name == title
                return e
    needle = ascii_lower_text(stripped)
    for e in elements
        if ascii_lower_text(e.name) == needle
            return e
    return Element(name = title, emoji = "", first = false)

// ---------------------------------------------------------------------------
// Sorted pair key / record_recipe
// ---------------------------------------------------------------------------

export func pair_key(a: text, b: text) -> (text, text)
    if strings.lex_compare(a, b) <= 0
        return (a, b)
    return (b, a)

export func record_recipe(recipes: inout Map<text, List<(text, text)>>, result_name: text, a_name: text, b_name: text)
    // Pair-membership check is inlined: a helper taking the pair list would
    // deep-copy it on every record_recipe call (sudoc List arg semantics).
    pair = pair_key(a_name, b_name)
    existing = recipes.get(result_name).get_or([])
    has = false
    for p in existing
        if p == pair
            has = true
            break
    if not has
        existing.append(pair)
        recipes[result_name] = existing

export func record_recipes_batch(recipes: inout Map<text, List<(text, text)>>, entries: List<(text, text, text)>)
    for entry in entries
        result_name, a_name, b_name = entry
        record_recipe(recipes, result_name, a_name, b_name)

// ---------------------------------------------------------------------------
// add_element / batch (no discovered-flag promotion on re-add)
// ---------------------------------------------------------------------------

func add_element(elements: inout List<Element>, name: text, emoji: text, first: bool) -> bool
    // Membership scan inlined (not find_index_by_name): that helper would
    // deep-copy the whole element list on every insert-or-ignore check —
    // catastrophic inside add_elements_batch on large inventories.
    for i = 0 to elements.length - 1
        if elements[i].name == name
            return false
    elements.append(Element(name = name, emoji = emoji, first = first))
    return true

func add_elements_batch(elements: inout List<Element>, items: List<(text, text, bool)>) -> int
    // Single ownership of `elements` for the whole batch: do not call
    // add_element (a separate function taking the list) per item — each call
    // would re-enter and, with nested helpers, re-dup. Inline the same
    // insert-or-ignore rule once per item against the shared list.
    added = 0
    for item in items
        n, em, f = item
        found = false
        for i = 0 to elements.length - 1
            if elements[i].name == n
                found = true
                break
        if not found
            elements.append(Element(name = n, emoji = em, first = f))
            added = added + 1
    return added

// ---------------------------------------------------------------------------
// Deterministic sorts — std.sorting.sort_by (stable merge sort, O(n log n)
// since sudoc v0.6.0) with top-level comparators; sudo has no closures, so anything a comparison
// needs must live in the sorted items themselves.
// NOTE: sorting.sort_by historically hit a Rust-backend cross-module
// `inout` codegen bug (see DIVERGENCES.md, "sudo language friction");
// fixed in sudoc v0.3.0, so present in the v0.4.0 toolchain this repo
// pins; regression-covered upstream by conformance/multimodule/xmod_inout.
// ---------------------------------------------------------------------------

func text_lex_less(a: text, b: text) -> bool
    return strings.lex_compare(a, b) < 0

func element_name_less(a: Element, b: Element) -> bool
    return strings.lex_compare(a.name, b.name) < 0

func sorted_text_list(items: List<text>) -> List<text>
    out = items
    sorting.sort_by(out, text_lex_less)
    return out

// ---------------------------------------------------------------------------
// Pair generation — exhaust / permute / cross / with
// ---------------------------------------------------------------------------

func exhaust_pairs(matches: List<Element>, all_elements: List<Element>) -> List<(Element, Element)>
    seen: Set<text> = Set()
    pairs: List<(Element, Element)> = []
    for target in matches
        for other in all_elements
            if other.name == target.name
                continue
            key = pair_key(target.name, other.name)
            ka, kb = key
            // Encode pair key as text for Set membership (text,text not settable).
            key_text = ka + "\u{0}" + kb
            if seen.has(key_text)
                continue
            seen.add(key_text)
            pairs.append((target, other))
    return pairs

func permute_pairs(matches: List<Element>) -> List<(Element, Element)>
    // Upper triangle: every unordered pair of distinct matches, in match
    // order — (m[0],m[1]), (m[0],m[2]), ..., (m[n-2],m[n-1]).
    pairs: List<(Element, Element)> = []
    for i = 0 to matches.length - 1
        for j = i + 1 to matches.length - 1
            pairs.append((matches[i], matches[j]))
    return pairs

func cross_pairs(left: List<Element>, right: List<Element>) -> List<(Element, Element)>
    // Left-major product, skipping same-name pairs, deduped on the
    // symmetric pair key (a+b == b+a).
    seen: Set<text> = Set()
    pairs: List<(Element, Element)> = []
    for a in left
        for b in right
            if a.name == b.name
                continue
            key = pair_key(a.name, b.name)
            ka, kb = key
            key_text = ka + "\u{0}" + kb
            if seen.has(key_text)
                continue
            seen.add(key_text)
            pairs.append((a, b))
    return pairs

func with_pairs(target: Element, others: List<Element>) -> List<(Element, Element)>
    // Target paired with each other match, in match order; the target
    // itself is skipped. No pair-key dedup needed: others are unique.
    pairs: List<(Element, Element)> = []
    for o in others
        if o.name == target.name
            continue
        pairs.append((target, o))
    return pairs

func crawl_generation_pairs(pool: List<Element>, tried: Set<text>) -> (List<(Element, Element)>, List<text>)
    // One crawl generation: every untried unordered pair over the pool,
    // INCLUDING self-pairs (j starts at i). owner rulings 2026-08-07 (see
    // DIVERGENCES.md): the pool is iterated in sorted-name order, so pair
    // order is deterministic across hosts regardless of how the pool
    // accumulated. Returns the pairs plus their encoded keys; the caller
    // adds the keys to its tried-set (hosts never build keys themselves).
    sorted_pool = pool
    sorting.sort_by(sorted_pool, element_name_less)
    pairs: List<(Element, Element)> = []
    new_keys: List<text> = []
    for i = 0 to sorted_pool.length - 1
        for j = i to sorted_pool.length - 1
            key = pair_key(sorted_pool[i].name, sorted_pool[j].name)
            ka, kb = key
            key_text = ka + "\u{0}" + kb
            if tried.has(key_text)
                continue
            pairs.append((sorted_pool[i], sorted_pool[j]))
            new_keys.append(key_text)
    return (pairs, new_keys)

// ---------------------------------------------------------------------------
// Pair prioritization (owner rulings 2026-08-07, prioritizer release):
// batch API pairs execute proven combiners first. Score = ingredient-usage
// count of a + count of b, descending; ties break on ascending canonical
// pair key. The sort is spelled out here — no host may rely on its own
// sort's stability or ordering.
// ---------------------------------------------------------------------------

export func ingredient_usage_counts(recipes: Map<text, List<(text, text)>>) -> Map<text, int>
    // +1 per ingredient slot per recorded recipe: a self-pair [X, X]
    // counts X twice; results do not count, only ingredient slots.
    // Iteration order does not affect the counts map — do not sort keys
    // (sorting the keys is pure overhead on every bulk command; it was
    // outright quadratic back when sort_by was insertion sort).
    counts: Map<text, int> = Map()
    for name in recipes.keys()
        for pair in recipes[name]
            pa, pb = pair
            counts[pa] = counts.get(pa).get_or(0) + 1
            counts[pb] = counts.get(pb).get_or(0) + 1
    return counts

func priority_row_less(a: (int, text, text, int), b: (int, text, text, int)) -> bool
    // Decorated row: (score, key_first, key_second, input_index).
    // Higher score first; equal scores order by ascending canonical pair
    // key; identical (score, key) falls back to input order, making the
    // order a total one independent of sort stability.
    a_score, a_k1, a_k2, a_idx = a
    b_score, b_k1, b_k2, b_idx = b
    if a_score != b_score
        return a_score > b_score
    c = strings.lex_compare(a_k1, b_k1)
    if c != 0
        return c < 0
    c2 = strings.lex_compare(a_k2, b_k2)
    if c2 != 0
        return c2 < 0
    return a_idx < b_idx

func prioritize_pairs(pairs: List<(Element, Element)>, recipes: Map<text, List<(text, text)>>) -> List<(Element, Element)>
    counts = ingredient_usage_counts(recipes)
    rows: List<(int, text, text, int)> = []
    idx = 0
    for p in pairs
        a, b = p
        score = counts.get(a.name).get_or(0) + counts.get(b.name).get_or(0)
        ka, kb = pair_key(a.name, b.name)
        rows.append((score, ka, kb, idx))
        idx = idx + 1
    // One stdlib call. This was a hand-inlined heapsort until sudoc v0.7.1.
    // sort_by was insertion sort (O(n²)) through v0.5.0; v0.6.0 made it a
    // merge sort but the generated code still deep-copied the whole list four
    // times per merge pass, so the builtin lost to the heapsort. v0.7.1 fixed
    // the swap and added copy-on-write lists; v0.7.3 made that COW uniform and
    // stopped read-only destructures copying. Measured on 441 choose-2 =
    // 97,020 pairs, py backend, byte-identical output ordering throughout:
    // heapsort 40.2s, this 6.6s.
    sorting.sort_by(rows, priority_row_less)
    out: List<(Element, Element)> = []
    for row in rows
        r_score, r_k1, r_k2, r_idx = row
        assert r_score == r_score
        assert r_k1 == r_k1
        assert r_k2 == r_k2
        out.append(pairs[r_idx])
    return out

// Cache-first promotion: pairs whose canonical key the host already holds a
// result for execute first — they consume no rate-limit slot, so a bulk run
// surfaces every already-known result immediately instead of stranding cache
// hits behind rate-limited misses. Stable partition: priority order is
// preserved within the hits and within the misses. `cached` uses the same
// NUL-joined canonical keys as lucky_pairs' tried list.
func cache_first_pairs(ordered: List<(Element, Element)>, cached: List<text>) -> List<(Element, Element)>
    if cached.length == 0
        return ordered
    seen: Set<text> = Set()
    for k in cached
        seen.add(k)
    hits: List<(Element, Element)> = []
    misses: List<(Element, Element)> = []
    for p in ordered
        a, b = p
        ka, kb = pair_key(a.name, b.name)
        if seen.has(ka + "\u{0}" + kb)
            hits.append(p)
        else
            misses.append(p)
    for m in misses
        hits.append(m)
    return hits

// ---------------------------------------------------------------------------
// Recipe BFS / backtrack / trace (unbounded depth)
// ---------------------------------------------------------------------------

// Layered BFS from the four bases: each pass collects every not-yet-visited
// result whose first ready pair has both ingredients available, then commits
// them to `visited`/`parent` together, so same-layer results cannot depend
// on each other. The first ready pair in list order wins for each result.
//
// Readiness is inlined against the precomputed `has_pairs` set, the key list
// is never sorted, and the scan stops the moment `target` is reached. All
// three avoid work that made `/recipe` hang on real saves; DIVERGENCES.md §1
// carries the rationale and the invariants that keep them output-equivalent
// to the old form.
func compute_layers(target: text, recipes: Map<text, List<(text, text)>>) -> (bool, Map<text, (text, text)>)
    parent: Map<text, (text, text)> = Map()
    visited: Set<text> = Set()
    visited.add("Water")
    visited.add("Fire")
    visited.add("Wind")
    visited.add("Earth")
    keys = recipes.keys()
    has_pairs: Set<text> = Set()
    for k in keys
        if recipes[k].length > 0
            has_pairs.add(k)
    found = false
    while not found
        new_names: List<text> = []
        new_pairs: Map<text, (text, text)> = Map()
        for result_name in keys
            // Target found mid-layer: ancestors are already in `parent` from
            // prior layers, and backtrack only walks parent links from the
            // target, so co-layer siblings are unnecessary. Stop scanning.
            if found
                break
            if visited.has(result_name)
                continue
            if new_pairs.has(result_name)
                continue
            if not has_pairs.has(result_name)
                continue
            pairs = recipes[result_name]
            for pair in pairs
                pa, pb = pair
                // Inlined readiness (see performance notes above).
                a_ok = visited.has(pa) or is_base_element(pa) or not has_pairs.has(pa)
                b_ok = visited.has(pb) or is_base_element(pb) or not has_pairs.has(pb)
                if a_ok and b_ok
                    new_pairs[result_name] = pair
                    new_names.append(result_name)
                    if result_name == target
                        found = true
                    break
        if new_names.length == 0
            break
        for rn in new_names
            pr = new_pairs[rn]
            parent[rn] = pr
            visited.add(rn)
    return (found, parent)

func backtrack_steps(target: text, parent: Map<text, (text, text)>) -> List<RecipeStep>
    resolved: Set<text> = Set()
    resolved.add("Water")
    resolved.add("Fire")
    resolved.add("Wind")
    resolved.add("Earth")
    to_resolve: List<text> = [target]
    steps: List<RecipeStep> = []
    while to_resolve.length > 0
        nm = to_resolve.pop()
        if resolved.has(nm)
            continue
        if not parent.has(nm)
            resolved.add(nm)
            continue
        pr = parent[nm]
        a, b = pr
        deferred = false
        for dep in [a, b]
            if resolved.has(dep)
                continue
            if not parent.has(dep) and not is_base_element(dep)
                resolved.add(dep)
                continue
            to_resolve.append(nm)
            to_resolve.append(dep)
            deferred = true
            break
        if not deferred
            steps.append(RecipeStep(a = a, b = b, result = nm))
            resolved.add(nm)
    return steps

func trace_recipe(elements: List<Element>, recipes: Map<text, List<(text, text)>>, name: text) -> RecipeResult
    stripped = strip_spaces(name)
    elem = get_by_name(elements, stripped)
    if elem.is_none()
        elem = get_by_name(elements, title_case(stripped))
    if elem.is_none()
        return NotFound
    target = elem.unwrap().name
    if is_base_element(target)
        return IsBase(target)
    target_pairs = recipes.get(target).get_or([])
    if target_pairs.length == 0
        return NoRecipe(target)
    found, parent = compute_layers(target, recipes)
    if not found
        return Unreachable(target)
    steps = backtrack_steps(target, parent)
    return Steps(target, steps)

// ---------------------------------------------------------------------------
// Export / prune closure (v1.4.2: recipes-only input)
// ---------------------------------------------------------------------------

func included_element_names(recipes: Map<text, List<(text, text)>>) -> Set<text>
    // Transitive closure of recipe ingredients. The final Set is independent
    // of scan order, so we never sort keys/items here — sorted_text_list is
    // re-sorting on every closure iteration made export/prune lag on large
    // saves, and is wasted work at any complexity. The public boundary still
    // returns a sorted name list.
    included: Set<text> = Set()
    included.add("Water")
    included.add("Fire")
    included.add("Wind")
    included.add("Earth")
    for name in recipes.keys()
        pairs = recipes[name]
        if pairs.length > 0
            included.add(name)
    changed = true
    while changed
        changed = false
        // Snapshot current members; order does not affect the fixed point.
        names = included.items()
        for nm in names
            if not recipes.has(nm)
                continue
            for pair in recipes[nm]
                pa, pb = pair
                if not included.has(pa)
                    included.add(pa)
                    changed = true
                if not included.has(pb)
                    included.add(pb)
                    changed = true
    return included

func orphan_candidates(elements: List<Element>, recipes: Map<text, List<(text, text)>>) -> List<Element>
    included = included_element_names(recipes)
    out: List<Element> = []
    for e in elements
        if not included.has(e.name)
            out.append(e)
    return out

func export_elements(elements: List<Element>, recipes: Map<text, List<(text, text)>>) -> List<Element>
    included = included_element_names(recipes)
    out: List<Element> = []
    for e in elements
        if included.has(e.name)
            out.append(e)
    return out

// ---------------------------------------------------------------------------
// Unfilled predicate
// ---------------------------------------------------------------------------

export func is_unfilled(name: text, recipes: Map<text, List<(text, text)>>) -> bool
    // owner ruling 2026-08-07: an element whose recipes entry exists but is
    // an EMPTY list is unfilled — "we know no way to make it". Key presence
    // alone does not make an element filled (consistent with
    // included_element_names, which seeds only non-empty recipe results).
    // Base elements are never unfilled.
    //
    // Cost note: sudoc deep-copies Map args on entry, so a hot loop of
    // is_unfilled(name, recipes) is O(n · |recipes|) in marshalling. Prefer
    // unfilled_names_boundary for bulk scans — it precomputes a filled set
    // once. Hosts that re-check after each /fill lineage should track a
    // local filled set rather than calling this per name.
    if is_base_element(name)
        return false
    return recipes.get(name).get_or([]).length == 0

// ---------------------------------------------------------------------------
// Query filter / pattern match (regex.sudo; no safety gates)
// ---------------------------------------------------------------------------

export func parse_query_filter(query: text) -> (text, bool, bool)
    // owner ruling 2026-07-22: '!' (exclude) and '^' (only_new) prefixes
    // combine — both may appear, in either order ('!^x' and '^!x' both
    // set exclude=true and only_new=true). A repeated prefix consumes
    // only its first occurrence; the second instance stays in the
    // pattern text ('!!x' -> pattern "!x", still exclude=true).
    q = strip_spaces(query)
    exclude = false
    only_new = false
    took_bang = false
    took_caret = false
    keep_going = true
    while keep_going
        if q.length > 0 and q[0] == '!' and not took_bang
            exclude = true
            took_bang = true
            q = strip_prefix_one(q)
        else if q.length > 0 and q[0] == '^' and not took_caret
            only_new = true
            took_caret = true
            q = strip_prefix_one(q)
        else
            keep_going = false
    return (q, exclude, only_new)

export func is_delimited_regex(pattern: text) -> bool
    p = strip_spaces(pattern)
    return p.length >= 2 and p[0] == '/' and p[p.length - 1] == '/'

func is_glob_trigger(pattern: text) -> bool
    for c in pattern
        if c == '*' or c == '?' or c == '[' or c == ']'
            return true
    return false

export func element_matches_pattern(name: text, pattern: text) -> (bool, Option<text>)
    pattern = strip_spaces(pattern)
    if pattern.length == 0
        return (false, None)
    if is_delimited_regex(pattern)
        body = text_slice(pattern, 1, pattern.length - 1)
        // owner ruling 2026-07-22 (R4): an empty regex body ("//") is
        // a valid empty pattern that matches every name — standard
        // empty-regex semantics, not a special "no match" case.
        match regex.regex_search(body, name, true)
            case Err(msg)
                assert msg.length >= 0
                return (false, Some("Invalid regex pattern"))
            case Ok(matched)
                return (matched, None)
    if is_glob_trigger(pattern)
        return (regex.glob_match(pattern, name, true), None)
    return (strings.contains(strings.to_lower(name), strings.to_lower(pattern)), None)

func match_elements(elements: List<Element>, query: text) -> (List<Element>, Option<text>)
    empty: List<Element> = []
    if query.length > 512
        return (empty, Some("Query too long (max 512 characters)"))
    q, exclude, only_new = parse_query_filter(query)
    if strip_spaces(q).length == 0
        if exclude
            return (elements, None)
        if only_new
            firsts: List<Element> = []
            for e in elements
                if e.first
                    firsts.append(e)
            return (firsts, None)
        return (empty, None)
    matches: List<Element> = []
    for e in elements
        matched, err = element_matches_pattern(e.name, q)
        if err.is_some()
            return (empty, err)
        if exclude
            if not matched
                matches.append(e)
        else if matched
            matches.append(e)
    if only_new
        filtered: List<Element> = []
        for e in matches
            if e.first
                filtered.append(e)
        return (filtered, None)
    return (matches, None)

// ---------------------------------------------------------------------------
// Slash / command classification & validation
// ---------------------------------------------------------------------------

export func slash_args(line: text, command: text) -> Option<text>
    if line == command
        return Some("")
    prefix = command + " "
    if strings.starts_with(line, prefix)
        return Some(text_from(line, prefix.length))
    return None

export func is_local_command(line: text) -> bool
    if line == "/help" or line == "/list" or line == "/history" or line == "/clear" or line == "/queue"
        return true
    if line == "/unfilled" or strings.starts_with(line, "/unfilled ")
        return true
    if line == "/search" or strings.starts_with(line, "/search ")
        return true
    if line == "/recipe" or strings.starts_with(line, "/recipe ")
        return true
    if line == "/target" or strings.starts_with(line, "/target ")
        return true
    if line == "/auto" or strings.starts_with(line, "/auto ")
        return true
    if line == "/relay" or strings.starts_with(line, "/relay ")
        return true
    return false

// Infinibrowser-backed long commands — independent host queue from pair API.
export func is_ib_command(line: text) -> bool
    if line == "/import" or strings.starts_with(line, "/import ")
        return true
    if line == "/fill" or strings.starts_with(line, "/fill ")
        return true
    if line == "/prune" or strings.starts_with(line, "/prune ")
        return true
    return false

// Always-script dispatch (v2): a line starting with "/" is a slash command
// only when its first token names a known command; anything else (e.g. a
// /regex/ statement) is a script. First token = up to first whitespace.
// The canonical command inventory — the single source of truth that the
// docs-drift test checks every documentation surface against (README,
// CLI /help, trainer /help, the GitHub Pages site).
export func known_slash_commands() -> List<text>
    return ["/help", "/search", "/recipe", "/list", "/history", "/target", "/auto", "/relay", "/clear", "/unfilled", "/queue", "/import", "/fill", "/prune", "/export", "/combine", "/crawl", "/with", "/cross", "/permute", "/permutate", "/exhaust", "/script", "/lucky"]

export func is_known_slash_command(line: text) -> bool
    stripped = strip_spaces(line)
    if stripped.length == 0 or stripped[0] != '/'
        return false
    end = 0
    while end < stripped.length and not is_ascii_space(stripped[end])
        end = end + 1
    head = text_slice(stripped, 0, end)
    for k in known_slash_commands()
        if head == k
            return true
    return false

// v2.0.1: pure, loop-free scripts run like local commands — a bare query
// such as `/steam|mist/` or `a* , b*` cannot touch the save and should not
// wait behind a running bulk command (matching /search's interleaving).
// Loops (until/while/foreach) always queue: the queue's cancel machinery is
// the only brake on an unbounded pure loop.
export func runs_local(line: text) -> bool
    if is_local_command(line)
        return true
    stripped = strip_spaces(line)
    if stripped.length == 0
        return false
    if is_known_slash_command(stripped) or is_ib_command(stripped)
        return false
    ok, nodes, kids, muts, err, pos = script_parse(stripped)
    if not ok or nodes.length == 0
        return false
    if muts[nodes.length - 1]
        return false
    for node in nodes
        kind, a, b, c, sval = node
        if kind == "until" or kind == "while" or kind == "foreach"
            return false
    return true

// Host queue routing: "local" | "ib" | "pair".
// Local runs immediately; ib and pair are independent FIFO workers.
export func command_queue_lane(line: text) -> text
    if is_local_command(line)
        return "local"
    if is_ib_command(line)
        return "ib"
    return "pair"

// Pure enqueue accept decision. Hosts keep validation, membership snapshots,
// append, worker wake, paint, message chrome. Returns "dup" | "full" | "ok".
// Idle current is "" — hosts store "" (not None/null) for idle worker current.
export func queue_accept(line: text, current: text, lane_queue: List<text>, total_pending: int, max_depth: int) -> text
    // /lucky is exempt from dedup: identical text means N MORE random
    // pairs, not the same work (stress-test round 4).
    stripped = strip_spaces(line)
    lucky = stripped == "/lucky" or strings.starts_with(stripped, "/lucky ")
    if not lucky
        // Idle current is "" — do not false-dup empty line unless empty is queued.
        if current.length > 0 and line == current
            return "dup"
        for item in lane_queue
            if item == line
                return "dup"
    if total_pending >= max_depth
        return "full"
    return "ok"

// Pure lane-busy / deferred-ack predicate. Hosts map session flags only:
// current non-empty (running cmd string), pending_len (lane queue depth),
// confirm_active (pair confirm / bulk / folded workerRunning). True → show
// "Queued:" ack; validation, append, wake, paint stay host-side.
export func queue_lane_busy(current: text, pending_len: int, confirm_active: bool) -> bool
    return current.length > 0 or pending_len > 0 or confirm_active

// Dual-queue cancel-reset policy for shared cancelled flag across pair/IB.
// lane in {"pair","ib"}. Hosts map peer_busy (other lane current non-empty)
// and confirm_active (pair confirm wait); hosts own the actual reset side-effect.
// Start-of-job: pair resets only when not peer_busy; ib when not peer_busy and
// not confirm_active. Soft-skip: pair always; ib only when not peer_busy.
export func lane_should_reset_cancel(lane: text, peer_busy: bool, confirm_active: bool) -> bool
    if lane == "ib"
        return not peer_busy and not confirm_active
    // "pair"
    return not peer_busy

export func lane_should_soft_reset_cancel(lane: text, peer_busy: bool) -> bool
    if lane == "ib"
        return not peer_busy
    return true

// Bulk-confirm gate (hosts prompt when pair count exceeds threshold).
export func may_bulk_confirm(line: text) -> bool
    s = strip_spaces(line)
    end = 0
    while end < s.length and not is_ascii_space(s[end])
        end = end + 1
    head = text_slice(s, 0, end)
    if head == "/permutate" or head == "/permute" or head == "/exhaust" or head == "/cross" or head == "/with" or head == "/lucky"
        return true
    if is_known_slash_command(s) or is_local_command(s) or is_ib_command(s)
        return false
    // v2.0: a script may bulk-confirm iff it contains a mutating statement.
    ok, nodes, kids, muts, err, pos = script_parse(s)
    if not ok or nodes.length == 0
        return false
    return muts[nodes.length - 1]

// Pair-count bulk-warn predicate (strict greater-than). Hosts keep threshold constants.
export func should_bulk_warn(n: int, threshold: int) -> bool
    return n > threshold

// /target pure rules — hosts own session state and confirm UI.
// parse_target_arg returns (action, name) with action in {"show","clear","set"}.
// name is non-empty only for "set" (already sanitize_element_name'd).
export func parse_target_arg(arg: text) -> (text, text)
    rest = strip_spaces(arg)
    if rest.length == 0
        return ("show", "")
    low = ascii_lower_text(rest)
    if low == "clear" or low == "off" or low == "none" or low == "-"
        return ("clear", "")
    return ("set", sanitize_element_name(rest))

// Exact name match; empty target or empty result is never a hit.
export func is_target_hit(target: text, result_name: text) -> bool
    if target.length == 0 or result_name.length == 0
        return false
    return target == result_name

// Outcome of a /target command after parse_target_arg.
// Returns (kind, new_state, detail) with kind in
// {show_empty, show, clear_empty, clear, set}.
// show+empty→show_empty; show+set→show (new_state=prev);
// clear+empty prev→clear_empty; clear+had prev→clear (detail=prev);
// else set (new_state=sanitize name). Hosts format wording; no display strings.
export func target_outcome(prev: text, action: text, name: text) -> (text, text, text)
    if action == "show"
        if prev.length == 0
            return ("show_empty", "", "")
        return ("show", prev, "")
    if action == "clear"
        if prev.length == 0
            return ("clear_empty", "", "")
        return ("clear", "", prev)
    // "set"
    return ("set", sanitize_element_name(name), "")

// Apply parse_target_arg action to session target (empty text = no target).
export func apply_target_state(current: text, action: text, name: text) -> text
    kind, new_state, detail = target_outcome(current, action, name)
    return new_state

// /auto: session auto-approve for bulk-size y/n confirms. Bare /auto
// toggles (the impatient path); on/off/status are explicit. Returns
// (kind, new_state) with kind in {on, off, show_on, show_off, invalid}.
// Hosts format wording; target-hit confirms are NOT covered — /target is
// an explicit per-session opt-in to pausing, so it always asks.
export func auto_approve_outcome(prev: bool, arg: text) -> (text, bool)
    rest = ascii_lower_text(strip_spaces(arg))
    if rest.length == 0
        if prev
            return ("off", false)
        return ("on", true)
    if rest == "on" or rest == "y" or rest == "yes" or rest == "always"
        return ("on", true)
    if rest == "off" or rest == "n" or rest == "no" or rest == "never"
        return ("off", false)
    if rest == "show" or rest == "status"
        if prev
            return ("show_on", true)
        return ("show_off", false)
    return ("invalid", prev)

// /relay: session toggle for the hive-mind shared-cache tier. Same grammar
// as /auto (bare toggles; on/off/status explicit) — deliberately the same
// state machine, aliased so hosts wire intent, not a lookalike.
export func relay_toggle_outcome(prev: bool, arg: text) -> (text, bool)
    return auto_approve_outcome(prev, arg)

// Re-seed payload for the hive-mind relay: every (a, b) → result edge the
// recipe store knows, canonicalized and deduped by pair key, with the
// result's emoji joined from the element list. Deterministic order
// (ascending result name, then recipe order; first claim per pair wins)
// so both backends emit identical lists.
export func relay_reseed_entries(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<(text, text, text, text)>
    emojis: Map<text, text> = Map()
    for e in elements
        n, em, f = e
        emojis[n] = em
    names: List<text> = []
    for k in recipes.keys()
        names.append(k)
    sorting.sort_by(names, text_lex_less)
    seen: Set<text> = Set()
    out: List<(text, text, text, text)> = []
    for name in names
        for pr in recipes[name]
            pa, pb = pr
            ka, kb = pair_key(pa, pb)
            key = ka + "\u{0}" + kb
            if seen.has(key)
                continue
            seen.add(key)
            out.append((ka, kb, name, emojis.get(name).get_or("")))
    return out

// Bulk confirm gate with session auto-approve folded in.
export func bulk_confirm_required(n: int, threshold: int, auto_approve: bool) -> bool
    if auto_approve
        return false
    return should_bulk_warn(n, threshold)

// Confirm key normalize: strip + ascii-lower full key.
export func confirm_answer_key(answer: text) -> text
    return strip_spaces(ascii_lower_text(answer))

// Confirm policy: single-key y continues; anything else stops.
export func confirm_should_continue(answer: text) -> bool
    return confirm_answer_key(answer) == "y"

// Confirm key gate: single-key y/n only (reject "", "yes", "no", multi-char).
export func is_confirm_answer(answer: text) -> bool
    key = confirm_answer_key(answer)
    return key == "y" or key == "n"

// Confirm input route: classify y/n against waiting Future vs bulk buffer.
// ignore = not a confirm key (or no waiter/buffer sink); deliver = set Future;
// buffer = stash until bulk awaiter is ready. Hosts own Future/buffer I/O.
export func confirm_input_route(answer: text, waiting: bool, bulk_pending: bool) -> text
    if not is_confirm_answer(answer)
        return "ignore"
    if waiting
        return "deliver"
    if bulk_pending
        return "buffer"
    return "ignore"

// ---------------------------------------------------------------------------
// HTTP retry policy (pure). Hosts own sockets, timers, and abort plumbing;
// the kernel owns how many attempts, which failures retry, and the backoff
// schedule, so the CLI and trainer cannot drift apart (they had: the trainer
// retried Infinibrowser 429s, the CLI gave up on first error).
// Attempts are 0-based; backoff(attempt) is the wait after that attempt fails.
// Status 0 means a transport-level failure (network error / timeout).
// ---------------------------------------------------------------------------

export func fetch_timeout_ms() -> int
    return 30000

export func pair_retry_max_attempts() -> int
    return 3

// 1s, 2s, 4s, ... doubling from 1000ms.
export func pair_retry_backoff_ms(attempt: int) -> int
    ms = 1000
    i = 0
    while i < attempt
        ms = ms * 2
        i = i + 1
    return ms

export func pair_should_retry(attempt: int) -> bool
    // The pair API retries any failure: transport, bad status, bad body.
    return attempt + 1 < pair_retry_max_attempts()

export func ib_retry_max_attempts() -> int
    return 4

// 2s, 4s, 8s, ... doubling from 2000ms.
export func ib_retry_backoff_ms(attempt: int) -> int
    ms = 2000
    i = 0
    while i < attempt
        ms = ms * 2
        i = i + 1
    return ms

export func ib_should_retry(status: int, attempt: int) -> bool
    // Infinibrowser retries only rate limiting and transport failures; any
    // other status (404, 5xx) is a real answer the caller interprets.
    if status != 429 and status != 0
        return false
    return attempt + 1 < ib_retry_max_attempts()


// ---------------------------------------------------------------------------
// Script language v0.6 — tokenizer
// (docs/superpowers/specs/2026-08-20-script-language-v0.6.md §1)
//
// Token kinds: "word" (pattern/ident/number material; may contain single
// spaces), "str" (quoted element reference, quotes stripped), "op"
// (standalone operator), "post" (postfix * ** ! attached after ) ] []),
// "atid" (@ident binder), and structural: "(" ")" "{" "}" ";" "," "@"
// "[" "]" "[]" "|" "^(".
// The standalone/attached rule: attached characters belong to the pattern;
// operator spellings are operators only when whitespace-delimited.
// ---------------------------------------------------------------------------

func sl_is_ident_char(c: int) -> bool
    if c >= 'a' and c <= 'z'
        return true
    if c >= 'A' and c <= 'Z'
        return true
    if c >= '0' and c <= '9'
        return true
    return c == '_'

// Reserved everywhere: seeing one always ends/blocks a pattern token.
// 34 = double quote, 39 = single quote, 35 = '#'.
func sl_is_reserved(c: int) -> bool
    if c == '(' or c == ')' or c == '{' or c == '}' or c == ';' or c == ','
        return true
    if c == '@' or c == '|' or c == 34 or c == 39 or c == 35
        return true
    return false

// Characters allowed immediately AFTER a standalone operator (besides
// whitespace/EOF): openers of the constructs an operand can start with.
// '^' is deliberately NOT here: `/^best /` after a boundary must lex as a
// regex pattern, not op-slash + junk (write `a / ^(b)` with the space).
func sl_op_after_ok(c: int) -> bool
    return c == '(' or c == '{' or c == '[' or c == '|' or c == 34 or c == 39

// Longest-first standalone operator match at position i (which must be a
// token boundary). Returns (spelling, next_index) or ("", i) on no match.
func sl_match_op(source: text, i: int) -> (text, int)
    n = source.length
    two: List<text> = [":=", "->", "&&", "||", "==", "!=", ">=", "<=", "++"]
    for op in two
        if i + 1 < n and source[i] == op[0] and source[i + 1] == op[1]
            j = i + 2
            if j >= n or is_ascii_space(source[j]) or sl_op_after_ok(source[j])
                return (op, j)
    singles: List<int> = ['+', '-', '*', '/', '%', '&', '~', '?', ':', '>', '<']
    for s in singles
        if source[i] == s
            j = i + 1
            if j >= n or is_ascii_space(source[j]) or sl_op_after_ok(source[j])
                out: text = ""
                out.append(s)
                return (out, j)
    return ("", i)

// Postfix scan directly after a ")" "]" or "[]" token (no whitespace).
// Returns (spelling, next_index) or ("", i).
func sl_match_postfix(source: text, i: int) -> (text, int)
    n = source.length
    if i >= n
        return ("", i)
    if source[i] == '!'
        return ("!", i + 1)
    if source[i] == '?'
        return ("?", i + 1)
    if source[i] == '*'
        if i + 1 < n and source[i + 1] == '*'
            return ("**", i + 2)
        return ("*", i + 1)
    if source[i] >= '0' and source[i] <= '9'
        j = i
        digits: text = ""
        while j < n and source[j] >= '0' and source[j] <= '9'
            digits.append(source[j])
            j = j + 1
        return (digits, j)
    return ("", i)

// Scan one word/pattern token starting at i (first char already known to be
// non-space, non-reserved, not an op/structural start). Greedy across single
// spaces; stops at newline, reserved chars, or a space followed by a
// standalone operator / quote / newline. A token whose FIRST char is '/'
// consumes a /regex/ span raw (spaces and reserved chars inside belong to
// the regex body).
func sl_scan_word(source: text, start: int) -> (text, int)
    n = source.length
    buf: text = ""
    i = start
    if source[i] == '/'
        buf.append('/')
        i = i + 1
        while i < n and source[i] != '/' and source[i] != 10
            buf.append(source[i])
            i = i + 1
        if i < n and source[i] == '/'
            buf.append('/')
            i = i + 1
    while i < n
        c = source[i]
        if c == 10
            break
        if sl_is_reserved(c)
            break
        if is_ascii_space(c)
            j = i
            while j < n and is_ascii_space(source[j]) and source[j] != 10
                j = j + 1
            if j >= n or source[j] == 10
                break
            c2 = source[j]
            if sl_is_reserved(c2)
                break
            // Standalone brackets after a space end the word: `[ expr ]`
            // closers/openers are structure. Attached `[dg]` classes reach
            // here only when the space is followed by `[x` (x not space/]),
            // which stays pattern material.
            if c2 == ']'
                break
            if c2 == '[' and (j + 1 >= n or is_ascii_space(source[j + 1]) or source[j + 1] == ']')
                break
            op, unused = sl_match_op(source, j)
            if op.length > 0
                break
            if c2 == '^' and j + 1 < n and source[j + 1] == '('
                break
            buf.append(' ')
            i = j
            continue
        buf.append(c)
        i = i + 1
    return (buf, i)

// Tokenize a script. Returns (ok, tokens, err, err_pos); tokens are
// (kind, sval, pos).
export func script_tokenize(source: text) -> (bool, List<(text, text, int)>, text, int)
    tokens: List<(text, text, int)> = []
    n = source.length
    i = 0
    while i < n
        c = source[i]
        if is_ascii_space(c)
            i = i + 1
            continue
        if c == 35
            while i < n and source[i] != 10
                i = i + 1
            continue
        if c == 34 or c == 39
            q = c
            j = i + 1
            buf: text = ""
            while j < n and source[j] != q
                buf.append(source[j])
                j = j + 1
            if j >= n
                return (false, tokens, "Unterminated string", i)
            tokens.append(("str", buf, i))
            i = j + 1
            continue
        if c == '(' or c == '{' or c == '}' or c == ';' or c == ','
            kind: text = ""
            kind.append(c)
            tokens.append((kind, kind, i))
            i = i + 1
            continue
        if c == ')'
            tokens.append((")", ")", i))
            i = i + 1
            post, pi = sl_match_postfix(source, i)
            while post.length > 0
                tokens.append(("post", post, i))
                i = pi
                post, pi = sl_match_postfix(source, i)
            continue
        if c == '['
            if i + 1 < n and source[i + 1] == ']'
                tokens.append(("[]", "[]", i))
                i = i + 2
                post2, pi2 = sl_match_postfix(source, i)
                while post2.length > 0
                    tokens.append(("post", post2, i))
                    i = pi2
                    post2, pi2 = sl_match_postfix(source, i)
                continue
            if i + 1 >= n or is_ascii_space(source[i + 1])
                tokens.append(("[", "[", i))
                i = i + 1
                continue
            // attached: leading character class — pattern material
            word, wi = sl_scan_word(source, i)
            tokens.append(("word", word, i))
            i = wi
            continue
        if c == ']'
            tokens.append(("]", "]", i))
            i = i + 1
            post3, pi3 = sl_match_postfix(source, i)
            while post3.length > 0
                tokens.append(("post", post3, i))
                i = pi3
                post3, pi3 = sl_match_postfix(source, i)
            continue
        if c == '@'
            if i + 1 < n and sl_is_ident_char(source[i + 1]) and not (source[i + 1] >= '0' and source[i + 1] <= '9')
                j2 = i + 1
                name: text = ""
                while j2 < n and sl_is_ident_char(source[j2])
                    name.append(source[j2])
                    j2 = j2 + 1
                tokens.append(("atid", name, i))
                i = j2
                continue
            tokens.append(("@", "@", i))
            i = i + 1
            continue
        if c == '^' and i + 1 < n and source[i + 1] == '('
            tokens.append(("^(", "^(", i))
            i = i + 2
            continue
        if c == '|'
            op2, oi = sl_match_op(source, i)
            if op2 == "||"
                tokens.append(("op", "||", i))
                i = oi
                continue
            tokens.append(("|", "|", i))
            i = i + 1
            continue
        op3, oi3 = sl_match_op(source, i)
        if op3.length > 0
            tokens.append(("op", op3, i))
            i = oi3
            continue
        word2, wi2 = sl_scan_word(source, i)
        if word2.length == 0
            return (false, tokens, "Unexpected character", i)
        tokens.append(("word", word2, i))
        i = wi2
    return (true, tokens, "", 0)

// Compact repr for tests: kind:sval joined by section signs.
export func script_tokens_repr(tokens: List<(text, text, int)>) -> text
    out: text = ""
    first = true
    for tok in tokens
        kind, sval, pos = tok
        if not first
            out = out + "\u{a7}"
        first = false
        if kind == "word" or kind == "str" or kind == "op" or kind == "post" or kind == "atid"
            out = out + kind + ":" + sval
        else
            out = out + kind
    return out


// ---------------------------------------------------------------------------
// Script language v0.6 — parser
//
// AST is a flat node table (boundary-safe primitives). Node fields:
//   (kind, a, b, c, sval)
// Kinds and field use:
//   script/block  a = kids index (statement list)
//   assign        sval = name, a = value node
//   union         a = kids index (operands)
//   combine/diff/cross/intersect/canrec/cantrec/crawl   a = left, b = right
//   permute/permutate/exhaust/first/newset/size         a = inner
//   newreg        ([])
//   pattern/ref/strref                                  sval = text
//   foreach       a = set expr, b = body, sval = binder ("_" anonymous)
//   until/while   a = body, b = cond
//   ternary       a = cond, b = then, c = else
//   or/and        a = kids index
//   cmp           a = left num, b = right num, sval = operator
//   num           a = integer value
//   narith        a = left, b = right, sval = operator
// Root node is the last appended (nodes.length - 1).
// muts[i] = true when evaluating node i can mutate the discovery set.
// ---------------------------------------------------------------------------

func sp_word_is_number(s: text) -> bool
    if s.length == 0
        return false
    for c in s
        if c < '0' or c > '9'
            return false
    return true

func sp_word_is_ident(s: text) -> bool
    if s.length == 0
        return false
    if s[0] >= '0' and s[0] <= '9'
        return false
    for c in s
        if not sl_is_ident_char(c)
            return false
    return true

func sp_word_has_meta(s: text) -> bool
    for c in s
        if c == '*' or c == '?' or c == '[' or c == ']' or c == '/' or c == '!' or c == '^'
            return true
    return false

func sp_node_is_mutating_kind(kind: text) -> bool
    return kind == "combine" or kind == "cross" or kind == "crawl" or kind == "permute" or kind == "permutate" or kind == "exhaust"

func sp_add(nodes: inout List<(text, int, int, int, text)>, muts: inout List<bool>, kind: text, a: int, b: int, c: int, sval: text) -> int
    mut = sp_node_is_mutating_kind(kind)
    if not mut
        // Containers inherit child mutation so the purity checks see through
        // pure wrappers: `a - (b* * c*)` is a mutating expression.
        // For script/block/union/and/or, a is a kids index, not a node id —
        // those OR their children at the call site via sp_kids_mut.
        unary = kind == "first" or kind == "newset" or kind == "size" or kind == "assign" or kind == "permute" or kind == "permutate" or kind == "exhaust" or kind == "shuffle"
        binary = kind == "diff" or kind == "intersect" or kind == "canrec" or kind == "cantrec" or kind == "narith" or kind == "cmp" or kind == "take" or kind == "sample"
        if (unary or binary) and a >= 0 and a < muts.length and muts[a]
            mut = true
        if binary and b >= 0 and b < muts.length and muts[b]
            mut = true
    nodes.append((kind, a, b, c, sval))
    muts.append(mut)
    return nodes.length - 1

func sp_kids_mut(muts: List<bool>, ids: List<int>) -> bool
    for id in ids
        if muts[id]
            return true
    return false

func sp_tok_kind(tokens: List<(text, text, int)>, i: int) -> text
    if i >= tokens.length
        return ""
    kind, sval, pos = tokens[i]
    return kind

func sp_tok_sval(tokens: List<(text, text, int)>, i: int) -> text
    if i >= tokens.length
        return ""
    kind, sval, pos = tokens[i]
    return sval

func sp_tok_pos(tokens: List<(text, text, int)>, i: int) -> int
    if i >= tokens.length
        return -1
    kind, sval, pos = tokens[i]
    return pos

func sp_is_op(tokens: List<(text, text, int)>, i: int, spelling: text) -> bool
    return sp_tok_kind(tokens, i) == "op" and sp_tok_sval(tokens, i) == spelling

// Parser state threading: every parse function returns
// (node_id, next_index, err, err_pos); node_id = -1 and err non-empty on
// failure. Binders is the lexical stack of @ binder names in scope.

func sp_err(msg: text, pos: int) -> (int, int, text, int)
    return (-1, 0, msg, pos)

// Primary: pattern / ref / strref / number(error at expr level) / (expr) /
// ^( expr ) / [ expr ] / [] / postfix chains.
// Returns an extra "wrapped" flag via c-slot convention: instead, the
// wrapped flag is returned by sp_parse_postfix through its tuple.

func sp_parse_primary(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int, bool)
    if depth > 64
        return (-1, 0, "Script too deeply nested", sp_tok_pos(tokens, i), false)
    kind = sp_tok_kind(tokens, i)
    pos = sp_tok_pos(tokens, i)
    if kind == "("
        node, ni, err, epos = sp_parse_expr(tokens, i + 1, depth + 1, nodes, kids, muts, binders)
        if err.length > 0
            return (-1, 0, err, epos, false)
        if sp_tok_kind(tokens, ni) != ")"
            return (-1, 0, "Expected )", sp_tok_pos(tokens, ni), false)
        return (node, ni + 1, "", 0, true)
    if kind == "^("
        node2, ni2, err2, epos2 = sp_parse_expr(tokens, i + 1, depth + 1, nodes, kids, muts, binders)
        if err2.length > 0
            return (-1, 0, err2, epos2, false)
        if sp_tok_kind(tokens, ni2) != ")"
            return (-1, 0, "Expected )", sp_tok_pos(tokens, ni2), false)
        f = sp_add(nodes, muts, "first", node2, -1, -1, "")
        return (f, ni2 + 1, "", 0, false)
    if kind == "["
        node3, ni3, err3, epos3 = sp_parse_expr(tokens, i + 1, depth + 1, nodes, kids, muts, binders)
        if err3.length > 0
            return (-1, 0, err3, epos3, false)
        if sp_tok_kind(tokens, ni3) != "]"
            return (-1, 0, "Expected ]", sp_tok_pos(tokens, ni3), false)
        ns = sp_add(nodes, muts, "newset", node3, -1, -1, "")
        return (ns, ni3 + 1, "", 0, false)
    if kind == "[]"
        nr = sp_add(nodes, muts, "newreg", -1, -1, -1, "")
        return (nr, i + 1, "", 0, false)
    if kind == "str"
        sr = sp_add(nodes, muts, "strref", -1, -1, -1, sp_tok_sval(tokens, i))
        return (sr, i + 1, "", 0, false)
    if kind == "word"
        w = sp_tok_sval(tokens, i)
        if sp_word_is_number(w)
            return (-1, 0, "Numbers are only legal inside conditions (quote an element named like a number)", pos, false)
        if w[0] == '/' and not is_delimited_regex(w)
            return (-1, 0, "Slash commands cannot appear inside scripts (a /regex/ pattern needs a closing /)", pos, false)
        if w == "_"
            found = false
            for b in binders
                if b == "_"
                    found = true
            if not found
                return (-1, 0, "_ only means something inside an anonymous @ body", pos, false)
            r0 = sp_add(nodes, muts, "ref", -1, -1, -1, "_")
            return (r0, i + 1, "", 0, false)
        if sp_word_has_meta(w)
            p = sp_add(nodes, muts, "pattern", -1, -1, -1, w)
            return (p, i + 1, "", 0, false)
        r = sp_add(nodes, muts, "ref", -1, -1, -1, w)
        return (r, i + 1, "", 0, false)
    if kind == ""
        return (-1, 0, "Unexpected end of script", pos, false)
    return (-1, 0, "Unexpected token: " + sp_tok_sval(tokens, i), pos, false)

func sp_parse_postfix(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int, bool)
    node, ni, err, epos, wrapped = sp_parse_primary(tokens, i, depth, nodes, kids, muts, binders)
    if err.length > 0
        return (-1, 0, err, epos, false)
    while true
        kind = sp_tok_kind(tokens, ni)
        if kind == "post"
            op = sp_tok_sval(tokens, ni)
            if op == "*"
                node = sp_add(nodes, muts, "permute", node, -1, -1, "")
                ni = ni + 1
            else if op == "**"
                node = sp_add(nodes, muts, "permutate", node, -1, -1, "")
                ni = ni + 1
            else if op == "!"
                node = sp_add(nodes, muts, "exhaust", node, -1, -1, "")
                ni = ni + 1
            else if op == "?"
                // bare ?: shuffle the whole set
                node = sp_add(nodes, muts, "shuffle", node, -1, -1, "")
                ni = ni + 1
            else
                // digit-run: a take count — becomes sample if ? follows
                v = 0
                for c in op
                    v = v * 10 + (c - '0')
                cnum = sp_add(nodes, muts, "num", v, -1, -1, "")
                if sp_tok_kind(tokens, ni + 1) == "post" and sp_tok_sval(tokens, ni + 1) == "?"
                    node = sp_add(nodes, muts, "sample", node, cnum, -1, "")
                    ni = ni + 2
                else
                    node = sp_add(nodes, muts, "take", node, cnum, -1, "")
                    ni = ni + 1
            wrapped = false
            continue
        if kind == "(" and sp_count_group_attaches(tokens, ni)
            // dynamic count group: (expr)(num_expr) or (expr)(num_expr)? —
            // legal only when the "(" is ATTACHED directly after ) ] [] or
            // a postfix token, mirroring the tokenizer's attachment rule.
            // A spaced or word-adjacent "(" still errors as juxtaposition.
            cnode, ci, cerr, cepos = sp_parse_num(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
            if cerr.length > 0
                return (-1, 0, cerr, cepos, false)
            if sp_tok_kind(tokens, ci) != ")"
                return (-1, 0, "Expected ) after the count expression", sp_tok_pos(tokens, ci), false)
            if muts[cnode]
                return (-1, 0, "Count expressions must be pure - no combines, crosses, or bulk operations inside a count", sp_tok_pos(tokens, ni), false)
            ci = ci + 1
            if sp_tok_kind(tokens, ci) == "post" and sp_tok_sval(tokens, ci) == "?"
                node = sp_add(nodes, muts, "sample", node, cnode, -1, "")
                ci = ci + 1
            else
                node = sp_add(nodes, muts, "take", node, cnode, -1, "")
            ni = ci
            wrapped = false
            continue
        break
    return (node, ni, "", 0, wrapped)

// Width of a token for adjacency checks (accurate for the closers and
// postfix tokens a count group may follow).
func sp_tok_width(kind: text, sval: text) -> int
    if kind == "[]" or kind == "^("
        return 2
    if kind == "post" or kind == "word" or kind == "op"
        return sval.length
    if kind == "str"
        return sval.length + 2
    if kind == "atid"
        return sval.length + 1
    return 1

func sp_count_group_attaches(tokens: List<(text, text, int)>, i: int) -> bool
    if i == 0
        return false
    pk = sp_tok_kind(tokens, i - 1)
    if not (pk == ")" or pk == "]" or pk == "[]" or pk == "post")
        return false
    prev_end = sp_tok_pos(tokens, i - 1) + sp_tok_width(pk, sp_tok_sval(tokens, i - 1))
    return sp_tok_pos(tokens, i) == prev_end

func sp_parse_crawl(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int, bool)
    node, ni, err, epos, wrapped = sp_parse_postfix(tokens, i, depth, nodes, kids, muts, binders)
    if err.length > 0
        return (-1, 0, err, epos, false)
    while sp_is_op(tokens, ni, "++")
        right, ri, rerr, repos, unusedw = sp_parse_postfix(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
        if rerr.length > 0
            return (-1, 0, rerr, repos, false)
        node = sp_add(nodes, muts, "crawl", node, right, -1, "")
        wrapped = false
        ni = ri
    return (node, ni, "", 0, wrapped)

func sp_parse_mul(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int, bool)
    node, ni, err, epos, wrapped = sp_parse_crawl(tokens, i, depth, nodes, kids, muts, binders)
    if err.length > 0
        return (-1, 0, err, epos, false)
    while sp_is_op(tokens, ni, "*") or sp_is_op(tokens, ni, "/") or sp_is_op(tokens, ni, "%") or sp_is_op(tokens, ni, "&")
        op = sp_tok_sval(tokens, ni)
        // `Best *` reads as cross-with-nothing: a standalone * is the cross
        // operator. Point at the two pattern spellings instead.
        if op == "*"
            nk = sp_tok_kind(tokens, ni + 1)
            if nk == ")" or nk == "]" or nk == "}" or nk == ";" or nk == "|" or nk == ""
                return (-1, 0, "A standalone * is the cross operator - for a pattern like Best * write Best ?* (attached wildcard) or a regex /^best /", sp_tok_pos(tokens, ni), false)
        right, ri, rerr, repos, unusedw = sp_parse_crawl(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
        if rerr.length > 0
            return (-1, 0, rerr, repos, false)
        kindname = "cross"
        if op == "/"
            kindname = "canrec"
        if op == "%"
            kindname = "cantrec"
        if op == "&"
            kindname = "intersect"
        node = sp_add(nodes, muts, kindname, node, right, -1, "")
        wrapped = false
        ni = ri
    return (node, ni, "", 0, wrapped)

func sp_parse_add(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int, bool)
    node, ni, err, epos, wrapped = sp_parse_mul(tokens, i, depth, nodes, kids, muts, binders)
    if err.length > 0
        return (-1, 0, err, epos, false)
    while sp_is_op(tokens, ni, "+") or sp_is_op(tokens, ni, "-")
        op = sp_tok_sval(tokens, ni)
        // Targeted migration error: `A +| B` (adjacent +|) was removed in 2.0.
        if op == "+" and sp_tok_kind(tokens, ni + 1) == "|" and sp_tok_pos(tokens, ni + 1) == sp_tok_pos(tokens, ni) + 1
            return (-1, 0, "+| was removed in 2.0 — use * (cross): A * B combines each of A with each of B", sp_tok_pos(tokens, ni), false)
        right, ri, rerr, repos, unusedw = sp_parse_mul(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
        if rerr.length > 0
            return (-1, 0, rerr, repos, false)
        kindname = "combine"
        if op == "-"
            kindname = "diff"
        node = sp_add(nodes, muts, kindname, node, right, -1, "")
        wrapped = false
        ni = ri
    return (node, ni, "", 0, wrapped)

func sp_parse_union(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int)
    first_pos = sp_tok_pos(tokens, i)
    node, ni, err, epos, wrapped = sp_parse_add(tokens, i, depth, nodes, kids, muts, binders)
    if err.length > 0
        return (-1, 0, err, epos)
    if sp_tok_kind(tokens, ni) != ","
        return (node, ni, "", 0)
    ids: List<int> = [node]
    wraps: List<bool> = [wrapped]
    while sp_tok_kind(tokens, ni) == ","
        right, ri, rerr, repos, rwrapped = sp_parse_add(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
        if rerr.length > 0
            return (-1, 0, rerr, repos)
        ids.append(right)
        wraps.append(rwrapped)
        ni = ri
    for k = 0 to ids.length - 1
        id = ids[k]
        nkind, na, nb, nc, nsval = nodes[id]
        if muts[id] and not wraps[k] and not (nkind == "permute" or nkind == "permutate" or nkind == "exhaust" or nkind == "newset")
            return (-1, 0, "Mutating expression inside a union list — wrap it in parentheses", first_pos)
    kidx = kids.length
    kids.append(ids)
    u = sp_add(nodes, muts, "union", kidx, -1, -1, "")
    if sp_kids_mut(muts, ids)
        muts[u] = true
    return (u, ni, "", 0)

func sp_parse_expr(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int)
    if depth > 64
        return sp_err("Script too deeply nested", sp_tok_pos(tokens, i))
    // Walrus: ident := expr (right-associative).
    if sp_tok_kind(tokens, i) == "word" and sp_is_op(tokens, i + 1, ":=")
        name = sp_tok_sval(tokens, i)
        if not sp_word_is_ident(name) or sp_word_is_number(name) or name == "_"
            return sp_err("Invalid variable name: " + name, sp_tok_pos(tokens, i))
        value, ni, err, epos = sp_parse_expr(tokens, i + 2, depth + 1, nodes, kids, muts, binders)
        if err.length > 0
            return (-1, 0, err, epos)
        a = sp_add(nodes, muts, "assign", value, -1, -1, name)
        return (a, ni, "", 0)
    return sp_parse_union(tokens, i, depth, nodes, kids, muts, binders)

// ── Conditions ──────────────────────────────────────────────────────

func sp_parse_natom(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int)
    kind = sp_tok_kind(tokens, i)
    if kind == "|"
        inner, ni, err, epos = sp_parse_expr(tokens, i + 1, depth + 1, nodes, kids, muts, binders)
        if err.length > 0
            return (-1, 0, err, epos)
        if sp_tok_kind(tokens, ni) != "|"
            return sp_err("Expected closing |", sp_tok_pos(tokens, ni))
        s = sp_add(nodes, muts, "size", inner, -1, -1, "")
        return (s, ni + 1, "", 0)
    if kind == "word" and sp_word_is_number(sp_tok_sval(tokens, i))
        w = sp_tok_sval(tokens, i)
        v = 0
        for c in w
            v = v * 10 + (c - '0')
        n = sp_add(nodes, muts, "num", v, -1, -1, "")
        return (n, i + 1, "", 0)
    if kind == "("
        inner2, ni2, err2, epos2 = sp_parse_num(tokens, i + 1, depth + 1, nodes, kids, muts, binders)
        if err2.length > 0
            return (-1, 0, err2, epos2)
        if sp_tok_kind(tokens, ni2) != ")"
            return sp_err("Expected )", sp_tok_pos(tokens, ni2))
        return (inner2, ni2 + 1, "", 0)
    return sp_err("Expected a size |...|, a number, or (arithmetic)", sp_tok_pos(tokens, i))

func sp_parse_nterm(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int)
    node, ni, err, epos = sp_parse_natom(tokens, i, depth, nodes, kids, muts, binders)
    if err.length > 0
        return (-1, 0, err, epos)
    while sp_is_op(tokens, ni, "*") or sp_is_op(tokens, ni, "/") or sp_is_op(tokens, ni, "%")
        op = sp_tok_sval(tokens, ni)
        right, ri, rerr, repos = sp_parse_natom(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
        if rerr.length > 0
            return (-1, 0, rerr, repos)
        node = sp_add(nodes, muts, "narith", node, right, -1, op)
        ni = ri
    return (node, ni, "", 0)

func sp_parse_num(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int)
    node, ni, err, epos = sp_parse_nterm(tokens, i, depth, nodes, kids, muts, binders)
    if err.length > 0
        return (-1, 0, err, epos)
    while sp_is_op(tokens, ni, "+") or sp_is_op(tokens, ni, "-")
        op = sp_tok_sval(tokens, ni)
        right, ri, rerr, repos = sp_parse_nterm(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
        if rerr.length > 0
            return (-1, 0, rerr, repos)
        node = sp_add(nodes, muts, "narith", node, right, -1, op)
        ni = ri
    return (node, ni, "", 0)

func sp_is_cmp_op(tokens: List<(text, text, int)>, i: int) -> bool
    if sp_tok_kind(tokens, i) != "op"
        return false
    s = sp_tok_sval(tokens, i)
    return s == ">=" or s == "<=" or s == ">" or s == "<" or s == "==" or s == "!="

// cond atom: comparison | set expr (truthy when non-empty) | bare numeric |
// parenthesized cond. Distinguishing "(cond)" from "(expr)" needs
// backtrack-free lookahead: a leading | or digit means numeric-side.
func sp_parse_catom(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int)
    if depth > 64
        return sp_err("Script too deeply nested", sp_tok_pos(tokens, i))
    kind = sp_tok_kind(tokens, i)
    if kind == "|" or (kind == "word" and sp_word_is_number(sp_tok_sval(tokens, i)))
        left, ni, err, epos = sp_parse_num(tokens, i, depth + 1, nodes, kids, muts, binders)
        if err.length > 0
            return (-1, 0, err, epos)
        if sp_is_cmp_op(tokens, ni)
            op = sp_tok_sval(tokens, ni)
            right, ri, rerr, repos = sp_parse_num(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
            if rerr.length > 0
                return (-1, 0, rerr, repos)
            cnode = sp_add(nodes, muts, "cmp", left, right, -1, op)
            return (cnode, ri, "", 0)
        return (left, ni, "", 0)
    // Set expression as condition (true when non-empty).
    node, ni2, err2, epos2 = sp_parse_expr(tokens, i, depth + 1, nodes, kids, muts, binders)
    if err2.length > 0
        return (-1, 0, err2, epos2)
    return (node, ni2, "", 0)

func sp_parse_cand(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int)
    node, ni, err, epos = sp_parse_catom(tokens, i, depth, nodes, kids, muts, binders)
    if err.length > 0
        return (-1, 0, err, epos)
    if not sp_is_op(tokens, ni, "&&")
        return (node, ni, "", 0)
    ids: List<int> = [node]
    while sp_is_op(tokens, ni, "&&")
        right, ri, rerr, repos = sp_parse_catom(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
        if rerr.length > 0
            return (-1, 0, rerr, repos)
        ids.append(right)
        ni = ri
    kidx = kids.length
    kids.append(ids)
    a = sp_add(nodes, muts, "and", kidx, -1, -1, "")
    if sp_kids_mut(muts, ids)
        muts[a] = true
    return (a, ni, "", 0)

func sp_parse_cond(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int)
    node, ni, err, epos = sp_parse_cand(tokens, i, depth, nodes, kids, muts, binders)
    if err.length > 0
        return (-1, 0, err, epos)
    if sp_is_op(tokens, ni, "||")
        ids: List<int> = [node]
        while sp_is_op(tokens, ni, "||")
            right, ri, rerr, repos = sp_parse_cand(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
            if rerr.length > 0
                return (-1, 0, rerr, repos)
            ids.append(right)
            ni = ri
        kidx = kids.length
        kids.append(ids)
        node = sp_add(nodes, muts, "or", kidx, -1, -1, "")
        if sp_kids_mut(muts, ids)
            muts[node] = true
    return (node, ni, "", 0)

// ── Statements ──────────────────────────────────────────────────────

func sp_parse_body(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int)
    if sp_tok_kind(tokens, i) == "{"
        inner, ni, err, epos = sp_parse_script_nodes(tokens, i + 1, depth + 1, nodes, kids, muts, binders, true)
        if err.length > 0
            return (-1, 0, err, epos)
        if sp_tok_kind(tokens, ni) != "}"
            return sp_err("Expected }", sp_tok_pos(tokens, ni))
        return (inner, ni + 1, "", 0)
    return sp_parse_stmt(tokens, i, depth + 1, nodes, kids, muts, binders)

func sp_parse_stmt(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int)
    if depth > 64
        return sp_err("Script too deeply nested", sp_tok_pos(tokens, i))
    start_pos = sp_tok_pos(tokens, i)
    if sp_tok_kind(tokens, i) == "{"
        node, ni, err, epos = sp_parse_body(tokens, i, depth, nodes, kids, muts, binders)
        if err.length > 0
            return (-1, 0, err, epos)
        if not (sp_is_op(tokens, ni, "->") or sp_is_op(tokens, ni, "~"))
            return sp_err("A { block } statement needs -> or ~ after it", start_pos)
        return sp_parse_loop_tail(tokens, ni, depth, node, nodes, kids, muts, binders)
    // General statement: parse as cond-superset, then classify by what follows.
    node, ni, err, epos = sp_parse_cond(tokens, i, depth, nodes, kids, muts, binders)
    if err.length > 0
        return (-1, 0, err, epos)
    nkind, na, nb, nc, nsval = nodes[node]
    if sp_tok_kind(tokens, ni) == "@" or sp_tok_kind(tokens, ni) == "atid"
        if sp_is_cond_only_kind(nkind)
            return sp_err("@ needs a set on its left", start_pos)
        binder = "_"
        if sp_tok_kind(tokens, ni) == "atid"
            binder = sp_tok_sval(tokens, ni)
        binders2: List<text> = []
        for b in binders
            binders2.append(b)
        binders2.append(binder)
        body, bi, berr, bepos = sp_parse_body(tokens, ni + 1, depth + 1, nodes, kids, muts, binders2)
        if berr.length > 0
            return (-1, 0, berr, bepos)
        f = sp_add(nodes, muts, "foreach", node, body, -1, binder)
        muts[f] = muts[node] or muts[body]
        return (f, bi, "", 0)
    if sp_is_op(tokens, ni, "?")
        if muts[node]
            return sp_err("Conditions must be pure — no combines, crosses, or bulk operations inside a condition", start_pos)
        thenb, ti, terr, tepos = sp_parse_body(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
        if terr.length > 0
            return (-1, 0, terr, tepos)
        if not sp_is_op(tokens, ti, ":")
            return sp_err("Expected : for the ternary else branch", sp_tok_pos(tokens, ti))
        elseb, ei, eerr, eepos = sp_parse_body(tokens, ti + 1, depth + 1, nodes, kids, muts, binders)
        if eerr.length > 0
            return (-1, 0, eerr, eepos)
        t = sp_add(nodes, muts, "ternary", node, thenb, elseb, "")
        muts[t] = muts[thenb] or muts[elseb]
        return (t, ei, "", 0)
    if sp_is_op(tokens, ni, "->") or sp_is_op(tokens, ni, "~")
        if sp_is_cond_only_kind(nkind)
            return sp_err("The left side of a loop must be a statement, not a condition", start_pos)
        return sp_parse_loop_tail(tokens, ni, depth, node, nodes, kids, muts, binders)
    if sp_is_cond_only_kind(nkind)
        return sp_err("A condition needs ? or a loop around it", start_pos)
    return (node, ni, "", 0)

func sp_is_cond_only_kind(kind: text) -> bool
    return kind == "cmp" or kind == "and" or kind == "or" or kind == "size" or kind == "num" or kind == "narith"

func sp_parse_loop_tail(tokens: List<(text, text, int)>, i: int, depth: int, body: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>) -> (int, int, text, int)
    node = body
    ni = i
    while sp_is_op(tokens, ni, "->") or sp_is_op(tokens, ni, "~")
        loop_kind = "until"
        if sp_tok_sval(tokens, ni) == "~"
            loop_kind = "while"
        cond_pos = sp_tok_pos(tokens, ni + 1)
        cond, ci, cerr, cepos = sp_parse_cond(tokens, ni + 1, depth + 1, nodes, kids, muts, binders)
        if cerr.length > 0
            return (-1, 0, cerr, cepos)
        if muts[cond]
            return sp_err("Conditions must be pure — no combines, crosses, or bulk operations inside a condition", cond_pos)
        prev_mut = muts[node]
        node = sp_add(nodes, muts, loop_kind, node, cond, -1, "")
        muts[node] = prev_mut
        ni = ci
    return (node, ni, "", 0)

func sp_parse_script_nodes(tokens: List<(text, text, int)>, i: int, depth: int, nodes: inout List<(text, int, int, int, text)>, kids: inout List<List<int>>, muts: inout List<bool>, binders: List<text>, in_block: bool) -> (int, int, text, int)
    ids: List<int> = []
    ni = i
    any_mut = false
    while true
        // tolerate empty statements / trailing semicolons
        while sp_tok_kind(tokens, ni) == ";"
            ni = ni + 1
        if sp_tok_kind(tokens, ni) == ""
            break
        if in_block and sp_tok_kind(tokens, ni) == "}"
            break
        node, si, err, epos = sp_parse_stmt(tokens, ni, depth + 1, nodes, kids, muts, binders)
        if err.length > 0
            return (-1, 0, err, epos)
        ids.append(node)
        if muts[node]
            any_mut = true
        ni = si
        if sp_tok_kind(tokens, ni) == ";"
            continue
        if sp_tok_kind(tokens, ni) == ""
            break
        if in_block and sp_tok_kind(tokens, ni) == "}"
            break
        // A spaced postfix — `(w*) !` — lexes as the all-elements pattern
        // "!" (or word "**"); point at the attachment rule instead of the
        // generic separator message.
        stray = sp_tok_sval(tokens, ni)
        if sp_tok_kind(tokens, ni) == "word" and (stray == "!" or stray == "**")
            return sp_err("Postfix operators attach directly to ) or ]: write (expr)" + stray + " with no space", sp_tok_pos(tokens, ni))
        return sp_err("Expected ; between statements", sp_tok_pos(tokens, ni))
    kidx = kids.length
    kids.append(ids)
    kindname = "script"
    if in_block
        kindname = "block"
    s = sp_add(nodes, muts, kindname, kidx, -1, -1, "")
    muts[s] = any_mut
    return (s, ni, "", 0)

// Boundary: parse a script. Returns (ok, nodes, kids, muts, err, err_pos).
// Root node is nodes.length - 1 when ok.
export func script_parse(source: text) -> (bool, List<(text, int, int, int, text)>, List<List<int>>, List<bool>, text, int)
    nodes: List<(text, int, int, int, text)> = []
    kids: List<List<int>> = []
    muts: List<bool> = []
    ok, tokens, terr, tpos = script_tokenize(source)
    if not ok
        return (false, nodes, kids, muts, terr, tpos)
    binders: List<text> = []
    root, ni, err, epos = sp_parse_script_nodes(tokens, 0, 0, nodes, kids, muts, binders, false)
    if err.length > 0
        return (false, nodes, kids, muts, err, epos)
    return (true, nodes, kids, muts, "", 0)

// S-expression repr for tests.
export func script_ast_repr(nodes: List<(text, int, int, int, text)>, kids: List<List<int>>, id: int) -> text
    kind, a, b, c, sval = nodes[id]
    if kind == "pattern" or kind == "ref" or kind == "strref"
        return kind + ":" + sval
    if kind == "num"
        out: text = kind + ":"
        v = a
        if v == 0
            out = out + "0"
        else
            digits: text = ""
            while v > 0
                d = v - (v / 10) * 10
                ch = d + '0'
                rev: text = ""
                rev.append(ch)
                digits = rev + digits
                v = v / 10
            out = out + digits
        return out
    if kind == "newreg"
        return "newreg"
    out2: text = "(" + kind
    if kind == "assign" or kind == "foreach"
        out2 = out2 + " " + sval
    if kind == "cmp" or kind == "narith"
        out2 = out2 + " " + sval
    if kind == "script" or kind == "block" or kind == "union" or kind == "and" or kind == "or"
        for kid in kids[a]
            out2 = out2 + " " + script_ast_repr(nodes, kids, kid)
    else
        if a >= 0
            out2 = out2 + " " + script_ast_repr(nodes, kids, a)
        if b >= 0
            out2 = out2 + " " + script_ast_repr(nodes, kids, b)
        if c >= 0
            out2 = out2 + " " + script_ast_repr(nodes, kids, c)
    out2 = out2 + ")"
    return out2


// ---------------------------------------------------------------------------
// Script language v0.6 — pure evaluation
//
// The kernel evaluates every statically-pure subtree in one call; hosts walk
// only mutating spines and control flow, performing effects with the
// existing bulk machinery. Env crosses the boundary as parallel lists
// (names / value sets), already flattened for shadowing by the host.
// ---------------------------------------------------------------------------

func se_resolve_ref(elements: List<Element>, name: text) -> (bool, Element)
    // Mirrors resolve_element's chain but reports misses instead of echoing
    // the input back: script bare words must fail loud (spec §4.2).
    for e in elements
        if e.name == name
            return (true, e)
    stripped = strip_spaces(name)
    for e2 in elements
        if e2.name == stripped
            return (true, e2)
    title = title_case(stripped)
    for e3 in elements
        if e3.name == title
            return (true, e3)
    // Case-insensitive last resort, matching interactive forgiveness.
    low = ascii_lower_text(stripped)
    for e4 in elements
        if ascii_lower_text(e4.name) == low
            return (true, e4)
    dummy = Element("", "", false)
    return (false, dummy)

func se_append_unique(out: inout List<Element>, seen: inout Set<text>, e: Element)
    if not seen.has(e.name)
        seen.add(e.name)
        out.append(e)

func se_recipe_pair_keys(recipes: Map<text, List<(text, text)>>) -> Set<text>
    keys: Set<text> = Set()
    for name in recipes.keys()
        for pair in recipes[name]
            pa, pb = pair
            ka, kb = pair_key(pa, pb)
            keys.add(ka + "\u{0}" + kb)
    return keys

func se_binary_setop(kind: text, lset: List<Element>, rset: List<Element>, recipes: Map<text, List<(text, text)>>) -> List<Element>
    out: List<Element> = []
    if kind == "diff" or kind == "intersect"
        rnames: Set<text> = Set()
        for re in rset
            rnames.add(re.name)
        for le in lset
            if kind == "diff" and not rnames.has(le.name)
                out.append(le)
            if kind == "intersect" and rnames.has(le.name)
                out.append(le)
        return out
    pair_keys = se_recipe_pair_keys(recipes)
    for le2 in lset
        has_known = false
        for re2 in rset
            ka, kb = pair_key(le2.name, re2.name)
            if pair_keys.has(ka + "\u{0}" + kb)
                has_known = true
                break
        if kind == "canrec" and has_known
            out.append(le2)
        if kind == "cantrec" and not has_known
            out.append(le2)
    return out

// Hosts call this when a pure set operator has a mutating operand: children
// are evaluated by the host walk, the operator itself stays kernel-owned.
export func script_set_op_boundary(op: text, a: List<(text, text, bool)>, b: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<(text, text, bool)>
    return elements_to_tuples(se_binary_setop(op, elements_from_tuples(a), elements_from_tuples(b), recipes))

func se_shuffle(items: List<Element>, seed: int) -> List<Element>
    out: List<Element> = []
    for e in items
        out.append(e)
    state = seed
    if state <= 0
        state = 1
    i = out.length - 1
    while i > 0
        state = lucky_next(state)
        j = state - (state / (i + 1)) * (i + 1)
        tmp = out[i]
        out[i] = out[j]
        out[j] = tmp
        i = i - 1
    return out

func se_env_lookup(env_names: List<text>, env_values: List<List<Element>>, name: text) -> (bool, List<Element>)
    // Later entries shadow earlier ones (host appends inner scopes last).
    i = env_names.length - 1
    while i >= 0
        if env_names[i] == name
            return (true, env_values[i])
        i = i - 1
    empty: List<Element> = []
    return (false, empty)

func se_eval(nodes: List<(text, int, int, int, text)>, kids: List<List<int>>, id: int, elements: List<Element>, recipes: Map<text, List<(text, text)>>, env_names: List<text>, env_values: List<List<Element>>, newreg: List<Element>, se_seed: int) -> (bool, List<Element>, text)
    empty: List<Element> = []
    kind, a, b, c, sval = nodes[id]
    if kind == "pattern"
        matches, err = match_elements(elements, sval)
        match err
            case Some(msg)
                return (false, empty, msg)
            case None
                return (true, matches, "")
    if kind == "ref"
        found, bound = se_env_lookup(env_names, env_values, sval)
        if found
            return (true, bound, "")
        rfound, elem = se_resolve_ref(elements, sval)
        if not rfound
            return (false, empty, "Element not found: " + sval)
        single: List<Element> = [elem]
        return (true, single, "")
    if kind == "strref"
        sfound, selem = se_resolve_ref(elements, sval)
        if not sfound
            return (false, empty, "Element not found: " + sval)
        single2: List<Element> = [selem]
        return (true, single2, "")
    if kind == "newreg"
        return (true, newreg, "")
    if kind == "newset"
        // Statically-pure inner: nothing can be newly added, so the value is
        // the empty set (spec §5.4) — but the inner still evaluates so its
        // errors (bad refs, bad regex) surface.
        nok, nres, nerr = se_eval(nodes, kids, a, elements, recipes, env_names, env_values, newreg, se_seed)
        if not nok
            return (false, empty, nerr)
        return (true, empty, "")
    if kind == "first"
        iok, inner, ierr = se_eval(nodes, kids, a, elements, recipes, env_names, env_values, newreg, se_seed)
        if not iok
            return (false, empty, ierr)
        firsts: List<Element> = []
        for e in inner
            if e.first
                firsts.append(e)
        return (true, firsts, "")
    if kind == "take" or kind == "sample" or kind == "shuffle"
        tok, tset, terr = se_eval(nodes, kids, a, elements, recipes, env_names, env_values, newreg, se_seed)
        if not tok
            return (false, empty, terr)
        n = tset.length
        if kind != "shuffle"
            nok, nv, nerr = se_eval_num(nodes, kids, b, elements, recipes, env_names, env_values, newreg, se_seed)
            if not nok
                return (false, empty, nerr)
            n = nv
        if n <= 0
            return (true, empty, "")
        if kind == "take"
            out_t: List<Element> = []
            for idx = 0 to tset.length - 1
                if idx >= n
                    break
                out_t.append(tset[idx])
            return (true, out_t, "")
        // shuffle / sample: seeded Fisher-Yates, then take n. The seed is
        // host-supplied (per-evaluation), mixed with the node id so several
        // random nodes in one script draw distinct streams.
        shuffled = se_shuffle(tset, se_seed + id * 7919 + 1)
        out_s: List<Element> = []
        for idx2 = 0 to shuffled.length - 1
            if idx2 >= n
                break
            out_s.append(shuffled[idx2])
        return (true, out_s, "")
    if kind == "union"
        out: List<Element> = []
        seen: Set<text> = Set()
        for kid in kids[a]
            kok, kset, kerr = se_eval(nodes, kids, kid, elements, recipes, env_names, env_values, newreg, se_seed)
            if not kok
                return (false, empty, kerr)
            for e2 in kset
                se_append_unique(out, seen, e2)
        return (true, out, "")
    if kind == "diff" or kind == "intersect" or kind == "canrec" or kind == "cantrec"
        lok, lset, lerr = se_eval(nodes, kids, a, elements, recipes, env_names, env_values, newreg, se_seed)
        if not lok
            return (false, empty, lerr)
        rok, rset, rerr = se_eval(nodes, kids, b, elements, recipes, env_names, env_values, newreg, se_seed)
        if not rok
            return (false, empty, rerr)
        return (true, se_binary_setop(kind, lset, rset, recipes), "")
    return (false, empty, "Not a pure set expression: " + kind)

func se_eval_num(nodes: List<(text, int, int, int, text)>, kids: List<List<int>>, id: int, elements: List<Element>, recipes: Map<text, List<(text, text)>>, env_names: List<text>, env_values: List<List<Element>>, newreg: List<Element>, se_seed: int) -> (bool, int, text)
    kind, a, b, c, sval = nodes[id]
    if kind == "num"
        return (true, a, "")
    if kind == "size"
        sok, sset, serr = se_eval(nodes, kids, a, elements, recipes, env_names, env_values, newreg, se_seed)
        if not sok
            return (false, 0, serr)
        return (true, sset.length, "")
    if kind == "narith"
        lok, lv, lerr = se_eval_num(nodes, kids, a, elements, recipes, env_names, env_values, newreg, se_seed)
        if not lok
            return (false, 0, lerr)
        rok, rv, rerr = se_eval_num(nodes, kids, b, elements, recipes, env_names, env_values, newreg, se_seed)
        if not rok
            return (false, 0, rerr)
        if sval == "+"
            return (true, lv + rv, "")
        if sval == "-"
            return (true, lv - rv, "")
        if sval == "*"
            return (true, lv * rv, "")
        if rv == 0
            return (false, 0, "Division by zero in condition")
        if sval == "/"
            return (true, lv / rv, "")
        return (true, lv - (lv / rv) * rv, "")
    return (false, 0, "Not a numeric expression: " + kind)

func se_eval_cond(nodes: List<(text, int, int, int, text)>, kids: List<List<int>>, id: int, elements: List<Element>, recipes: Map<text, List<(text, text)>>, env_names: List<text>, env_values: List<List<Element>>, newreg: List<Element>, se_seed: int) -> (bool, bool, text)
    kind, a, b, c, sval = nodes[id]
    if kind == "or" or kind == "and"
        for kid in kids[a]
            kok, ktruth, kerr = se_eval_cond(nodes, kids, kid, elements, recipes, env_names, env_values, newreg, se_seed)
            if not kok
                return (false, false, kerr)
            if kind == "or" and ktruth
                return (true, true, "")
            if kind == "and" and not ktruth
                return (true, false, "")
        return (true, kind == "and", "")
    if kind == "cmp"
        lok, lv, lerr = se_eval_num(nodes, kids, a, elements, recipes, env_names, env_values, newreg, se_seed)
        if not lok
            return (false, false, lerr)
        rok, rv, rerr = se_eval_num(nodes, kids, b, elements, recipes, env_names, env_values, newreg, se_seed)
        if not rok
            return (false, false, rerr)
        if sval == ">="
            return (true, lv >= rv, "")
        if sval == "<="
            return (true, lv <= rv, "")
        if sval == ">"
            return (true, lv > rv, "")
        if sval == "<"
            return (true, lv < rv, "")
        if sval == "=="
            return (true, lv == rv, "")
        return (true, lv != rv, "")
    if kind == "size" or kind == "num" or kind == "narith"
        nok, nv, nerr = se_eval_num(nodes, kids, id, elements, recipes, env_names, env_values, newreg, se_seed)
        if not nok
            return (false, false, nerr)
        return (true, nv != 0, "")
    eok, eset, eerr = se_eval(nodes, kids, id, elements, recipes, env_names, env_values, newreg, se_seed)
    if not eok
        return (false, false, eerr)
    return (true, eset.length > 0, "")

// ── Boundaries ──────────────────────────────────────────────────────

func se_env_from_tuples(env_values: List<List<(text, text, bool)>>) -> List<List<Element>>
    out: List<List<Element>> = []
    for tuples in env_values
        out.append(elements_from_tuples(tuples))
    return out

export func script_eval_expr_boundary(nodes: List<(text, int, int, int, text)>, kids: List<List<int>>, id: int, elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>, env_names: List<text>, env_values: List<List<(text, text, bool)>>, newreg: List<(text, text, bool)>, seed: int) -> (bool, List<(text, text, bool)>, text)
    ok, result, err = se_eval(nodes, kids, id, elements_from_tuples(elements), recipes, env_names, se_env_from_tuples(env_values), elements_from_tuples(newreg), seed)
    return (ok, elements_to_tuples(result), err)

export func script_eval_cond_boundary(nodes: List<(text, int, int, int, text)>, kids: List<List<int>>, id: int, elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>, env_names: List<text>, env_values: List<List<(text, text, bool)>>, newreg: List<(text, text, bool)>, seed: int) -> (bool, bool, text)
    return se_eval_cond(nodes, kids, id, elements_from_tuples(elements), recipes, env_names, se_env_from_tuples(env_values), elements_from_tuples(newreg), seed)

export func script_eval_num_boundary(nodes: List<(text, int, int, int, text)>, kids: List<List<int>>, id: int, elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>, env_names: List<text>, env_values: List<List<(text, text, bool)>>, newreg: List<(text, text, bool)>, seed: int) -> (bool, int, text)
    return se_eval_num(nodes, kids, id, elements_from_tuples(elements), recipes, env_names, se_env_from_tuples(env_values), elements_from_tuples(newreg), seed)

// Take / shuffle / sample over already-evaluated tuple sets — hosts call
// these when the inner expression was mutating (host-walked).
export func script_take_tuples(items: List<(text, text, bool)>, n: int) -> List<(text, text, bool)>
    out: List<(text, text, bool)> = []
    if n <= 0
        return out
    for t in items
        if out.length >= n
            break
        out.append(t)
    return out

export func script_sample_tuples(items: List<(text, text, bool)>, n: int, seed: int) -> List<(text, text, bool)>
    shuffled = se_shuffle(elements_from_tuples(items), seed)
    out: List<Element> = []
    if n > 0
        for e in shuffled
            if out.length >= n
                break
            out.append(e)
    return elements_to_tuples(out)

// Order-preserving name-deduped union of two tuple sets — hosts use this to
// fold products and to merge mutating union operands without re-implementing
// set identity.
export func script_union_tuples(a: List<(text, text, bool)>, b: List<(text, text, bool)>) -> List<(text, text, bool)>
    out: List<(text, text, bool)> = []
    seen: Set<text> = Set()
    for t in a
        name, emoji, first = t
        if not seen.has(name)
            seen.add(name)
            out.append(t)
    for t2 in b
        name2, emoji2, first2 = t2
        if not seen.has(name2)
            seen.add(name2)
            out.append(t2)
    return out


// ---------------------------------------------------------------------------
// /lucky — uniform random untried pairs (entropy from within: the untried
// pair space the proven-combiner prioritization systematically neglects).
// The kernel stays deterministic for parity: hosts supply the seed; a given
// (elements, recipes, tried, n, seed) always yields the same pairs.
// ---------------------------------------------------------------------------

func lucky_next(state: int) -> int
    // LCG, arbitrary-precision arithmetic modulo 2^31.
    m = 2147483648
    s = state * 1103515245 + 12345
    return s - (s / m) * m

func lucky_pairs(elements: List<Element>, recipes: Map<text, List<(text, text)>>, tried: List<text>, n: int, seed: int) -> List<(Element, Element)>
    out: List<(Element, Element)> = []
    count = elements.length
    if count == 0 or n <= 0
        return out
    // Unordered pairs including self-pairs: row i holds (count - i) pairs.
    total = count * (count + 1) / 2
    seen: Set<text> = Set()
    for t in tried
        seen.add(t)
    known = se_recipe_pair_keys(recipes)
    state = seed
    if state <= 0
        state = 1
    // Large requests: rejection sampling degenerates as the untried space
    // shrinks relative to n (stress-test round 4: /lucky 19000 churned ~1M
    // rejected draws). Enumerate the untried space, shuffle it, take n.
    if n * 4 >= total
        untried: List<(Element, Element)> = []
        for i2 = 0 to count - 1
            for j2 = i2 to count - 1
                a2 = elements[i2]
                b2 = elements[j2]
                ka2, kb2 = pair_key(a2.name, b2.name)
                key2 = ka2 + "\u{0}" + kb2
                if not seen.has(key2) and not known.has(key2)
                    untried.append((a2, b2))
        // Fisher-Yates over the untried pairs
        fi = untried.length - 1
        while fi > 0
            state = lucky_next(state)
            fj = state - (state / (fi + 1)) * (fi + 1)
            tmp = untried[fi]
            untried[fi] = untried[fj]
            untried[fj] = tmp
            fi = fi - 1
        for p2 in untried
            if out.length >= n
                break
            out.append(p2)
        return out
    picked: Set<text> = Set()
    attempts = 0
    max_attempts = n * 50 + 100
    while out.length < n and attempts < max_attempts
        attempts = attempts + 1
        state = lucky_next(state)
        k = state - (state / total) * total
        i = 0
        kk = k
        while kk >= count - i
            kk = kk - (count - i)
            i = i + 1
        j = i + kk
        a = elements[i]
        b = elements[j]
        ka, kb = pair_key(a.name, b.name)
        key = ka + "\u{0}" + kb
        if seen.has(key) or known.has(key) or picked.has(key)
            continue
        picked.add(key)
        out.append((a, b))
    return out

export func lucky_pairs_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>, tried: List<text>, n: int, seed: int) -> List<(text, text, bool, text, text, bool)>
    pairs = lucky_pairs(elements_from_tuples(elements), recipes, tried, n, seed)
    out: List<(text, text, bool, text, text, bool)> = []
    for p in pairs
        a, b = p
        out.append((a.name, a.emoji, a.first, b.name, b.emoji, b.first))
    return out

// ---------------------------------------------------------------------------
// Rate-window chrome math (pure). Hosts own clocks, deques, HTTP, paint.
// Times are integer milliseconds (or any consistent unit).
// ---------------------------------------------------------------------------

// Note shown beside the rate bar while the request window is exhausted.
export func rate_status_note(remaining: int) -> text
    if remaining <= 0
        return "Rate limiting in progress"
    return ""

export func rate_slots_left(used: int, max_requests: int) -> int
    if max_requests <= 0
        return 0
    left = max_requests - used
    if left < 0
        return 0
    return left

// Progress toward the next free slot, in thousandths [0, 1000].
// Idle (no timestamps) → 1000 (left bar full). Resets when a slot frees
// (has_last_freed + last_freed_ms), then fills over the inter-drop interval.
export func rate_next_slot_frac_milli(
    now_ms: int,
    oldest_ms: int,
    last_freed_ms: int,
    window_ms: int,
    has_timestamps: bool,
    has_last_freed: bool
) -> int
    if not has_timestamps
        return 1000
    if window_ms <= 0
        return 1000
    next_free = oldest_ms + window_ms
    start = oldest_ms
    if has_last_freed and last_freed_ms >= oldest_ms
        start = last_freed_ms
    span = next_free - start
    if span <= 0
        return 1000
    elapsed = now_ms - start
    if elapsed <= 0
        return 0
    milli = (elapsed * 1000) / span
    if milli < 0
        return 0
    if milli > 1000
        return 1000
    return milli

// Segmented bar cell counts: left = next-slot wait, right = remaining capacity.
// frac_milli is [0, 1000]. Rounding matches common half-up via +width/2 style.
export func rate_bar_fills(
    remaining: int,
    max_requests: int,
    frac_milli: int,
    left_width: int,
    right_width: int
) -> (int, int)
    left_filled = 0
    if left_width > 0
        fm = frac_milli
        if fm < 0
            fm = 0
        if fm > 1000
            fm = 1000
        left_filled = (fm * left_width + 500) / 1000
        if left_filled > left_width
            left_filled = left_width
    right_filled = 0
    if right_width > 0 and max_requests > 0
        rem = remaining
        if rem < 0
            rem = 0
        if rem > max_requests
            rem = max_requests
        right_filled = (rem * right_width + max_requests / 2) / max_requests
        if right_filled > right_width
            right_filled = right_width
    return (left_filled, right_filled)

// Hive split of the capacity half: cyan = remaining, gold ▒ = slots spent
// serving fleet bounties, dark ░ = own spend. Gold gets a minimum of one
// cell whenever any fleet spend exists (small spend must stay visible) and
// never crowds out remaining's cells.
export func rate_bar_fills_split(
    remaining: int,
    fleet_used: int,
    max_requests: int,
    frac_milli: int,
    left_width: int,
    right_width: int
) -> (int, int, int)
    left_filled, cyan_filled = rate_bar_fills(remaining, max_requests, frac_milli, left_width, right_width)
    gold_filled = 0
    if right_width > 0 and max_requests > 0 and fleet_used > 0
        fu = fleet_used
        if fu > max_requests
            fu = max_requests
        gold_filled = (fu * right_width + max_requests / 2) / max_requests
        if gold_filled < 1
            gold_filled = 1
        if gold_filled > right_width - cyan_filled
            gold_filled = right_width - cyan_filled
        if gold_filled < 0
            gold_filled = 0
    return (left_filled, cyan_filled, gold_filled)

// The four bar segments as glyph runs (hosts wrap colors only):
// (purple left, cyan remaining, gold ▒ fleet, dark ░ own-spent).
// ▒ = U+2592 (9618).
export func rate_bar_split_segments(
    remaining: int,
    fleet_used: int,
    max_requests: int,
    frac_milli: int,
    left_width: int,
    right_width: int
) -> (text, text, text, text)
    left_filled, cyan_filled, gold_filled = rate_bar_fills_split(
        remaining, fleet_used, max_requests, frac_milli, left_width, right_width)
    dark = right_width - cyan_filled - gold_filled
    if dark < 0
        dark = 0
    return (
        rate_bar_segment(left_filled, left_width),
        repeat_char(9608, cyan_filled),
        repeat_char(9618, gold_filled),
        repeat_char(9617, dark)
    )

// Same-IP budget split: peers actively spending neal slots (including self)
// divide the per-IP window evenly. Alone (or unknown) → full budget;
// never below 1 so a crowded IP still crawls rather than starves.
export func effective_rate_limit(max_requests: int, spending_peers: int) -> int
    if spending_peers <= 1
        return max_requests
    eff = max_requests / spending_peers
    if eff < 1
        return 1
    return eff

// 429 cooldown: neal's 429 is a multi-hour IP ban, not a rate signal.
// First strike 2h, doubling per repeat strike, capped at 8h. A client in
// cooldown makes zero neal requests (hive lookups are still fine) and the
// relay broadcasts the state to every session on the IP.
export func cooldown_duration_ms(strikes: int) -> int
    s = strikes
    if s < 1
        s = 1
    if s > 3
        s = 3
    ms = 7200000
    i = 1
    while i < s
        ms = ms * 2
        i = i + 1
    return ms

// Idle bounty poll cadence (fast per design review: idle clients should
// pick up work promptly; the GET doubles as the presence heartbeat).
export func bounty_poll_interval_ms() -> int
    return 10000

// Demand-heartbeat cadence: a rate-limited bulk run re-affirms its open
// bounties this often.
export func bounty_sync_interval_ms() -> int
    return 3000

// A leased bounty lapses after ~3 missed heartbeats — a cancelled run's
// board self-clears in seconds.
export func bounty_lease_ttl_ms() -> int
    return 10000

// One-shot posts from pre-lease clients keep the old 15-minute board TTL.
export func bounty_legacy_ttl_ms() -> int
    return 900000

// Max open bounties per posting session; renewals are exempt — quota
// gates only new posts.
export func bounty_session_quota() -> int
    return 600

// Slice of a prioritized miss list a run should lease to the hive:
// (start, count) past the live horizon (slots_left + effective_max),
// count clamped to [0, 500].
export func bounty_sync_plan(miss_count: int, slots_left: int, effective_max: int) -> (int, int)
    sl = slots_left
    if sl < 0
        sl = 0
    em = effective_max
    if em < 0
        em = 0
    start = sl + em
    count = miss_count - start
    if count < 0
        count = 0
    if count > 500
        count = 500
    return (start, count)

// How many bounties an idle client claims per poll.
export func bounty_claim_limit(slots_left: int) -> int
    n = slots_left
    if n > 5
        n = 5
    if n < 0
        n = 0
    return n

// Relay-computed pacing hint for idle workers — speed up while the board
// is deep, never for ineligible callers.
export func bounty_poll_hint_ms(open_bounties: int, eligible: bool) -> int
    if eligible and open_bounties > 0
        return 2000
    return bounty_poll_interval_ms()

// Hive-aware rate wait: while a bulk run is rate-limited on genuine misses,
// it re-checks rate/cache every tick and re-sweeps the hive for the tail
// every interval — draining fleet-filled pairs for free instead of blocking
// on a slot. A slot frees ~once/sec at 60/min, so a 1s tick paces naturally;
// re-sweeping every 3s keeps relay load bounded on a large tail.
export func hive_wait_tick_ms() -> int
    return 1000

export func hive_resweep_interval_ms() -> int
    return 3000

// Glyph segment for rate bars: clamp filled to [0, width], then █ filled + ░ empty.
// Hosts keep ANSI/HTML wrappers; kernel owns clamp + glyph construction.
// █ = U+2588 (9608), ░ = U+2591 (9617).
export func rate_bar_segment(filled: int, width: int) -> text
    n = filled
    if n < 0
        n = 0
    if n > width
        n = width
    return repeat_char(9608, n) + repeat_char(9617, width - n)

// End-ellipsis for rate-line pair chrome. Plain text length (not ANSI).
// Matches trainer ellipsizeEnd: max_chars<=0 → ""; overflow → prefix + "…".
export func rate_ellipsize_end(s: text, max_chars: int) -> text
    if max_chars <= 0
        return ""
    if s.length <= max_chars
        return s
    if max_chars == 1
        return "…"
    return text_slice(s, 0, max_chars - 1) + "…"

// Format "a + b" into avail cells: split remaining after sep, end-ellipsis each.
// Hosts supply avail (TTY width / DOM clientWidth); kernel owns the math.
export func rate_format_pair_for_width(a: text, b: text, avail: int) -> text
    sep: text = " + "
    if avail <= sep.length + 2
        return rate_ellipsize_end(a + sep + b, avail)
    each = (avail - sep.length) / 2
    left_extra = (avail - sep.length) - each * 2
    return rate_ellipsize_end(a, each + left_extra) + sep + rate_ellipsize_end(b, each)

export func is_slash_command_attempt(line: text) -> bool
    // Port of re.match(r"/[^/]+/", line) then re.match(r"/\w", line).
    if line.length == 0 or line[0] != '/'
        return false
    // Delimited regex at start: /[^/]+/  → not a slash-command attempt.
    if line.length >= 3
        i = 1
        while i < line.length and line[i] != '/'
            i = i + 1
        if i > 1 and i < line.length and line[i] == '/'
            return false
    if line.length >= 2 and is_word_char(line[1])
        return true
    return false

func contains_plus_ws_pipe(s: text) -> bool
    // re.search(r"\+\s+\|", s): '+' then 1+ whitespace then '|'
    i = 0
    while i < s.length
        if s[i] == '+'
            j = i + 1
            if j < s.length and is_ascii_space(s[j])
                while j < s.length and is_ascii_space(s[j])
                    j = j + 1
                if j < s.length and s[j] == '|'
                    return true
        i = i + 1
    return false


export func classify_command_line(line: text) -> Option<(text, text)>
    line = strip_spaces(line)
    if line.length == 0
        return None
    cmds: List<text> = ["/permute", "/permutate", "/import", "/fill", "/prune", "/export", "/exhaust", "/combine", "/crawl", "/with", "/cross", "/script", "/lucky"]
    for cmd in cmds
        rest_opt = slash_args(line, cmd)
        if rest_opt.is_some()
            kind = strip_prefix_one(cmd)
            return Some((kind, rest_opt.unwrap()))
    // v2.0: non-slash lines are scripts (script_parse owns them); classify
    // recognizes slash commands only.
    return None

export func parse_two_elements(rest: text) -> Option<(text, text)>
    rest = strip_spaces(rest)
    // split(None, 1): first whitespace run
    i = 0
    while i < rest.length and not is_ascii_space(rest[i])
        i = i + 1
    if i >= rest.length
        return None
    first = strip_spaces(text_slice(rest, 0, i))
    second = strip_spaces(text_from(rest, i))
    if first.length == 0 or second.length == 0
        return None
    return Some((first, second))

export func parse_with_args(rest: text) -> Option<(text, text)>
    return parse_two_elements(rest)

export func split_two_positional_args(rest: text) -> Option<(text, text)>
    rest = strip_spaces(rest)
    if rest.length == 0
        return None
    tokens: List<text> = []
    i = 0
    n = rest.length
    while i < n and tokens.length < 2
        while i < n and is_ascii_space(rest[i])
            i = i + 1
        if i >= n
            break
        token: text = ""
        if rest[i] == '/'
            j = i + 1
            found_close = false
            while j < n
                if rest[j] == '/'
                    found_close = true
                    break
                j = j + 1
            if not found_close
                j = i
                while j < n and not is_ascii_space(rest[j])
                    j = j + 1
                token = text_slice(rest, i, j)
                i = j
            else
                token = text_slice(rest, i, j + 1)
                i = j + 1
        else
            j = i
            while j < n and not is_ascii_space(rest[j])
                j = j + 1
            token = text_slice(rest, i, j)
            i = j
        token = strip_spaces(token)
        if token.length > 0
            tokens.append(token)
    if tokens.length != 2
        return None
    while i < n and is_ascii_space(rest[i])
        i = i + 1
    if i < n
        return None
    return Some((tokens[0], tokens[1]))

export func parse_cross_queries(rest: text) -> Option<(text, text)>
    return split_two_positional_args(rest)

// Validation errors are built as SEGMENT lists: (text, highlight) pairs.
// The message text lives here once; hosts only style — the Python CLI wraps
// highlighted segments in ANSI yellow, the browser trainer HTML-escapes every
// segment and wraps highlighted ones in a color span. Plain-text variants
// concatenate the segments unchanged.

func seg_concat(segs: List<(text, bool)>) -> text
    out: text = ""
    for seg in segs
        t, hl = seg
        assert hl == hl
        out = out + t
    return out

func plain_segment(msg: text) -> List<(text, bool)>
    return [(msg, false)]

func query_err_segments(err: Option<text>) -> Option<List<(text, bool)>>
    if err.is_none()
        return None
    return Some(plain_segment(err.unwrap()))

func bad_pipe_segments() -> List<(text, bool)>
    segs: List<(text, bool)> = []
    segs.append(("  Pipes are not valid here. Use ", false))
    segs.append(("/with <element> <query>", true))
    segs.append((" or a script cross ", false))
    segs.append(("A * B", true))
    segs.append((". Type ", false))
    segs.append(("/help", true))
    segs.append((" for commands.", false))
    return segs

func has_spaced_pipe_payload(rest: text) -> bool
    if contains_plus_ws_pipe(rest)
        return true
    parsed = parse_two_elements(rest)
    if parsed.is_some()
        pfirst, psecond = parsed.unwrap()
        assert pfirst == pfirst
        if psecond.length > 0 and psecond[0] == '|'
            return true
    return false

export func slash_combine_crawl_pipe_error_segments(rest: text) -> Option<List<(text, bool)>>
    if has_spaced_pipe_payload(rest)
        return Some(bad_pipe_segments())
    return None

export func slash_combine_crawl_pipe_error(rest: text) -> Option<text>
    segs = slash_combine_crawl_pipe_error_segments(rest)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

export func slash_combine_crawl_operator_error_segments(rest: text, kind: text) -> Option<List<(text, bool)>>
    if not strings.contains(rest, " + ")
        return None
    idx = strings.index_of(rest, " + ").unwrap()
    left = text_slice(rest, 0, idx)
    right = text_from(rest, idx + 3)
    positional = "/" + kind + " " + strip_spaces(left) + " " + strip_spaces(right)
    segs: List<(text, bool)> = []
    segs.append(("  Slash /" + kind + " uses positional args, not +. Try ", false))
    segs.append((strip_spaces(rest), true))
    segs.append((" (script) or ", false))
    segs.append((positional, true))
    segs.append((".", false))
    return Some(segs)

export func slash_combine_crawl_operator_error(rest: text, kind: text) -> Option<text>
    segs = slash_combine_crawl_operator_error_segments(rest, kind)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

export func slash_cross_operator_error_segments(rest: text) -> Option<List<(text, bool)>>
    if not strings.contains(rest, " * ")
        return None
    idx = strings.index_of(rest, " * ").unwrap()
    left = text_slice(rest, 0, idx)
    right = text_from(rest, idx + 3)
    positional = "/cross " + strip_spaces(left) + " " + strip_spaces(right)
    segs: List<(text, bool)> = []
    segs.append(("  Slash /cross uses positional args, not *. Try ", false))
    segs.append((strip_spaces(rest), true))
    segs.append((" (script) or ", false))
    segs.append((positional, true))
    segs.append((".", false))
    return Some(segs)

export func slash_cross_operator_error(rest: text) -> Option<text>
    segs = slash_cross_operator_error_segments(rest)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

export func validate_query_at_enqueue(query: text) -> Option<text>
    if query.length > 512
        return Some("  Query too long (max 512 characters)")
    q, qf_exclude, qf_only_new = parse_query_filter(query)
    if not is_delimited_regex(q)
        return None
    body = text_slice(q, 1, q.length - 1)
    if not regex.regex_is_valid(body)
        return Some("  Invalid regex pattern")
    return None

func first_ws_token(s: text) -> text
    s = strip_spaces(s)
    i = 0
    while i < s.length and not is_ascii_space(s[i])
        i = i + 1
    return text_slice(s, 0, i)

func split_once(s: text, sep: text) -> (text, text)
    // Split on first occurrence of sep; if missing, (s, "").
    idx_opt = strings.index_of(s, sep)
    if idx_opt.is_none()
        return (s, "")
    idx = idx_opt.unwrap()
    return (text_slice(s, 0, idx), text_from(s, idx + sep.length))



export func validate_command_line_segments(line: text) -> Option<List<(text, bool)>>
    classified = classify_command_line(line)
    if classified.is_none()
        if is_slash_command_attempt(line)
            cmd = first_ws_token(line)
            segs: List<(text, bool)> = []
            segs.append(("  Unknown command: ", false))
            segs.append((cmd, true))
            segs.append((". Type ", false))
            segs.append(("/help", true))
            segs.append((" for commands.", false))
            return Some(segs)
        unk: List<(text, bool)> = []
        unk.append(("  Unknown input. Type ", false))
        unk.append(("/help", true))
        unk.append((" for commands.", false))
        return Some(unk)
    kind, payload = classified.unwrap()
    if kind == "permute" or kind == "permutate" or kind == "exhaust" or kind == "import"
        if strip_spaces(payload).length == 0
            if kind == "import"
                return Some(plain_segment("  Usage: /import <element>"))
            return Some(plain_segment("  Usage: /" + kind + " <query>"))
        if kind == "import"
            return None
        return query_err_segments(validate_query_at_enqueue(strip_spaces(payload)))
    if kind == "export" or kind == "fill" or kind == "prune"
        return None
    if kind == "script"
        // Path (CLI) / picker (trainer) validity is host business at dispatch.
        return None
    if kind == "lucky"
        arg = strip_spaces(payload)
        if arg.length == 0
            return None
        for ch in arg
            if ch < '0' or ch > '9'
                return Some(plain_segment("  Usage: /lucky [count]"))
        return None
    if kind == "combine" or kind == "crawl"
        pipe_err = slash_combine_crawl_pipe_error_segments(payload)
        if pipe_err.is_some()
            return pipe_err
        op_err = slash_combine_crawl_operator_error_segments(payload, kind)
        if op_err.is_some()
            return op_err
        if parse_two_elements(payload).is_none()
            return Some(plain_segment("  Usage: /" + kind + " <element> <element>"))
        return None
    if kind == "with"
        parsed = parse_with_args(payload)
        if parsed.is_none()
            return Some(plain_segment("  Usage: /with <element> <query>"))
        with_elem, query = parsed.unwrap()
        assert with_elem == with_elem
        return query_err_segments(validate_query_at_enqueue(query))
    if kind == "cross"
        op_err = slash_cross_operator_error_segments(payload)
        if op_err.is_some()
            return op_err
        parsed = parse_cross_queries(payload)
        if parsed.is_none()
            return Some(plain_segment("  Usage: /cross <query> <query>"))
        left_q, right_q = parsed.unwrap()
        err = validate_query_at_enqueue(left_q)
        if err.is_some()
            return query_err_segments(err)
        return query_err_segments(validate_query_at_enqueue(right_q))
    return None

export func validate_command_line(line: text) -> Option<text>
    segs = validate_command_line_segments(line)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

// ---- boundary adapters: tuple/primitive-only shapes for export funcs ----
// Records/enums must not cross export func signatures (toolchain limitation).

func element_from_tuple(t: (text, text, bool)) -> Element
    n, em, f = t
    return Element(name = n, emoji = em, first = f)

func element_to_tuple(e: Element) -> (text, text, bool)
    return (e.name, e.emoji, e.first)

func elements_from_tuples(ts: List<(text, text, bool)>) -> List<Element>
    out: List<Element> = []
    for t in ts
        out.append(element_from_tuple(t))
    return out

func elements_to_tuples(es: List<Element>) -> List<(text, text, bool)>
    out: List<(text, text, bool)> = []
    for e in es
        out.append(element_to_tuple(e))
    return out

func recipe_result_to_tuple(r: RecipeResult) -> (int, text, List<(text, text, text)>)
    match r
        case NotFound
            empty: List<(text, text, text)> = []
            return (0, "", empty)
        case IsBase(n)
            empty: List<(text, text, text)> = []
            return (1, n, empty)
        case NoRecipe(n)
            empty: List<(text, text, text)> = []
            return (2, n, empty)
        case Unreachable(n)
            empty: List<(text, text, text)> = []
            return (3, n, empty)
        case Steps(t, steps)
            out: List<(text, text, text)> = []
            for s in steps
                out.append((s.a, s.b, s.result))
            return (4, t, out)

export func resolve_element_boundary(elements: List<(text, text, bool)>, name: text) -> (text, text, bool)
    return element_to_tuple(resolve_element(elements_from_tuples(elements), name))

export func get_by_name_boundary(elements: List<(text, text, bool)>, name: text) -> Option<(text, text, bool)>
    found = get_by_name(elements_from_tuples(elements), name)
    match found
        case Some(e)
            return Some(element_to_tuple(e))
        case None
            return None

export func add_element_boundary(elements: inout List<(text, text, bool)>, name: text, emoji: text, first: bool) -> bool
    es = elements_from_tuples(elements)
    result = add_element(es, name, emoji, first)
    elements = elements_to_tuples(es)
    return result

export func add_elements_batch_boundary(elements: inout List<(text, text, bool)>, items: List<(text, text, bool)>) -> int
    es = elements_from_tuples(elements)
    result = add_elements_batch(es, items)
    elements = elements_to_tuples(es)
    return result

export func trace_recipe_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>, name: text) -> (int, text, List<(text, text, text)>)
    r = trace_recipe(elements_from_tuples(elements), recipes, name)
    return recipe_result_to_tuple(r)

export func included_element_names_boundary(recipes: Map<text, List<(text, text)>>) -> List<text>
    return sorted_text_list(included_element_names(recipes).items())

export func orphan_candidates_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<(text, text, bool)>
    return elements_to_tuples(orphan_candidates(elements_from_tuples(elements), recipes))

export func export_elements_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<(text, text, bool)>
    return elements_to_tuples(export_elements(elements_from_tuples(elements), recipes))

export func match_elements_boundary(elements: List<(text, text, bool)>, query: text) -> (List<(text, text, bool)>, Option<text>)
    matches, err = match_elements(elements_from_tuples(elements), query)
    return (elements_to_tuples(matches), err)

func element_pairs_to_boundary(pairs: List<(Element, Element)>) -> List<(text, text, bool, text, text, bool)>
    out: List<(text, text, bool, text, text, bool)> = []
    for p in pairs
        a, b = p
        out.append((a.name, a.emoji, a.first, b.name, b.emoji, b.first))
    return out

export func exhaust_pairs_boundary(matches: List<(text, text, bool)>, all_elements: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(exhaust_pairs(elements_from_tuples(matches), elements_from_tuples(all_elements)))

export func permute_pairs_boundary(matches: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(permute_pairs(elements_from_tuples(matches)))

export func cross_pairs_boundary(left: List<(text, text, bool)>, right: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(cross_pairs(elements_from_tuples(left), elements_from_tuples(right)))

export func with_pairs_boundary(target: (text, text, bool), others: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(with_pairs(element_from_tuple(target), elements_from_tuples(others)))

func element_pairs_from_boundary(pairs: List<(text, text, bool, text, text, bool)>) -> List<(Element, Element)>
    out: List<(Element, Element)> = []
    for p in pairs
        an, ae, af, bn, be, bf = p
        out.append((Element(name = an, emoji = ae, first = af), Element(name = bn, emoji = be, first = bf)))
    return out

export func prioritize_pairs_boundary(pairs: List<(text, text, bool, text, text, bool)>, recipes: Map<text, List<(text, text)>>, cached: List<text>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(cache_first_pairs(prioritize_pairs(element_pairs_from_boundary(pairs), recipes), cached))

export func crawl_generation_pairs_boundary(pool: List<(text, text, bool)>, tried_keys: List<text>) -> (List<(text, text, bool, text, text, bool)>, List<text>)
    tried: Set<text> = Set()
    for k in tried_keys
        tried.add(k)
    pairs, new_keys = crawl_generation_pairs(elements_from_tuples(pool), tried)
    return (element_pairs_to_boundary(pairs), new_keys)

export func unfilled_names_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<text>
    // Element-list order is preserved (both hosts display in storage order).
    //
    // Precompute names with a non-empty recipe list, then scan elements with
    // O(1) set lookups. The previous form called is_unfilled(e.name, recipes)
    // once per element; sudoc deep-copies every Map parameter on entry, so
    // that was O(|elements| · |recipes|) full-map dups and made /fill and
    // /unfilled appear to hang on multi-thousand-element saves (same class
    // of bug as the old is_available-in-compute_layers path).
    filled: Set<text> = Set()
    for k in recipes.keys()
        if recipes[k].length > 0
            filled.add(k)
    out: List<text> = []
    for e in elements_from_tuples(elements)
        if is_base_element(e.name)
            continue
        if not filled.has(e.name)
            out.append(e.name)
    return out

// ---- import/export folds ----
// Hosts do JSON traversal and I/O only; id resolution, name sanitization,
// dedup, and id remapping all happen here.

export func ic_save_to_batches(items: List<(int, text, text, bool)>, recipe_refs: List<(int, int, int)>) -> (List<(text, text, bool)>, List<(text, text, text)>)
    // .ic save import: items are (id, text, emoji, discovered) — the host
    // merges the save's discovery/discovered spellings into one flag —
    // and recipe_refs are (result_id, a_id, b_id). Names are sanitized;
    // refs whose ids don't resolve are dropped (no dangling references).
    id_name: Map<text, text> = Map()
    elements: List<(text, text, bool)> = []
    for it in items
        iid, txt, em, disc = it
        nm = sanitize_element_name(txt)
        // Missing or all-control text sanitizes to "": skip the item
        // entirely — its id stays unresolvable, so refs to it drop too.
        if nm.length == 0
            continue
        id_name[int_to_text(iid)] = nm
        elements.append((nm, em, disc))
    recipes_out: List<(text, text, text)> = []
    for ref in recipe_refs
        rid, aid, bid = ref
        rk = int_to_text(rid)
        ak = int_to_text(aid)
        bk = int_to_text(bid)
        if not id_name.has(rk) or not id_name.has(ak) or not id_name.has(bk)
            continue
        recipes_out.append((id_name[rk], id_name[ak], id_name[bk]))
    return (elements, recipes_out)

func lineage_add_unique(elements: inout List<(text, text, bool)>, seen: inout Set<text>, name: text, emoji: text)
    if seen.has(name)
        return
    seen.add(name)
    elements.append((name, emoji, false))

export func lineage_steps_to_batches(steps: List<(text, text, text, text, text, text)>) -> (List<(text, text, bool)>, List<(text, text, text)>)
    // Infinibrowser lineage fold: steps are (a_name, a_emoji, b_name,
    // b_emoji, result_name, result_emoji), after the host's tolerant
    // id-or-text JSON extraction. Names are sanitized; steps with any
    // empty name are skipped (owner ruling 2026-08-07: tolerate malformed
    // payloads instead of erroring). The element batch is deduped by name
    // (first occurrence wins, a/b/result order per step); the recipe
    // batch stays in step order.
    seen: Set<text> = Set()
    elements: List<(text, text, bool)> = []
    recipes_out: List<(text, text, text)> = []
    for st in steps
        a_raw, a_em, b_raw, b_em, r_raw, r_em = st
        a = sanitize_element_name(a_raw)
        b = sanitize_element_name(b_raw)
        r = sanitize_element_name(r_raw)
        if a.length == 0 or b.length == 0 or r.length == 0
            continue
        recipes_out.append((r, a, b))
        lineage_add_unique(elements, seen, a, a_em)
        lineage_add_unique(elements, seen, b, b_em)
        lineage_add_unique(elements, seen, r, r_em)
    return (elements, recipes_out)

export func build_export_items_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> (List<(int, text, text, bool)>, List<(int, int, int)>)
    // .ic export builder (owner ruling 2026-08-07): fresh sequential ids
    // 0..n over the export closure in input (storage) order, recipe pairs
    // remapped to those ids, pairs referencing excluded elements dropped —
    // an export can never contain a dangling id.
    selected = export_elements(elements_from_tuples(elements), recipes)
    name_id: Map<text, int> = Map()
    items: List<(int, text, text, bool)> = []
    idx = 0
    for e in selected
        name_id[e.name] = idx
        items.append((idx, e.name, e.emoji, e.first))
        idx = idx + 1
    refs: List<(int, int, int)> = []
    for e in selected
        if not recipes.has(e.name)
            continue
        for pair in recipes[e.name]
            pa, pb = pair
            if name_id.has(pa) and name_id.has(pb)
                refs.append((name_id[e.name], name_id[pa], name_id[pb]))
    return (items, refs)

// ===========================================================================
// Tests
// ===========================================================================

func parity_fixture() -> List<Element>
    els: List<Element> = []
    els.append(Element(name = "Water", emoji = "💧", first = false))
    els.append(Element(name = "Fire", emoji = "🔥", first = false))
    els.append(Element(name = "Wind", emoji = "🌬️", first = false))
    els.append(Element(name = "Earth", emoji = "🌍", first = false))
    els.append(Element(name = "Firewall", emoji = "🧱", first = true))
    return els

func match_names(els: List<Element>, query: text) -> (Set<text>, Option<text>)
    matches, err = match_elements(els, query)
    names: Set<text> = Set()
    for e in matches
        names.add(e.name)
    return (names, err)

test "script slash command validates and newset-pure is empty"
    // R1 (stress test): /script must pass enqueue validation in both hosts
    assert validate_command_line("/script run.ice").is_none()
    assert validate_command_line("/script").is_none()
    c = classify_command_line("/script run.ice")
    assert c.is_some()
    k, p = c.unwrap()
    assert k == "script"
    assert p == "run.ice"
    // S2 (stress test): [ pure ] is the empty set, not an error
    els: List<(text, text, bool)> = [("Water", "w", false), ("Fire", "f", false)]
    recipes: Map<text, List<(text, text)>> = Map()
    no_names: List<text> = []
    no_vals: List<List<(text, text, bool)>> = []
    no_reg: List<(text, text, bool)> = []
    ok, nodes, kids, muts, err, pos = script_parse("[ w* ]")
    assert ok
    kind, a, b, c2, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 0
    // inner errors still surface
    ok, nodes, kids, muts, err, pos = script_parse("[ xyzzy ]")
    assert ok
    kind, a, b, c2, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert not eok

test "take shuffle sample postfixes"
    els: List<(text, text, bool)> = [("A", "", false), ("B", "", false), ("C", "", false), ("D", "", false), ("E", "", false)]
    recipes: Map<text, List<(text, text)>> = Map()
    no_names: List<text> = []
    no_vals: List<List<(text, text, bool)>> = []
    no_reg: List<(text, text, bool)> = []
    // (expr)N literal take: first N in set order
    ok, nodes, kids, muts, err, pos = script_parse("(?*)3")
    assert ok
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 3
    n0, x0, y0 = eset[0]
    assert n0 == "A"
    // (expr)(num_expr) dynamic count with arithmetic and clamping
    ok, nodes, kids, muts, err, pos = script_parse("(?*)(|?*| - 3)")
    assert ok
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 2
    ok, nodes, kids, muts, err, pos = script_parse("(?*)(|?*| - 99)")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 0
    // (expr)? shuffle: same members, deterministic per seed
    ok, nodes, kids, muts, err, pos = script_parse("(?*)?")
    assert ok
    kind, a, b, c, sval = nodes[nodes.length - 1]
    s1ok, s1, s1err = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 42)
    s2ok, s2, s2err = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 42)
    assert s1ok
    assert s1.length == 5
    for idx = 0 to 4
        a1, w1, w2 = s1[idx]
        a2, w3, w4 = s2[idx]
        assert a1 == a2
    // (expr)N? sample: n random members, deterministic per seed
    ok, nodes, kids, muts, err, pos = script_parse("(?*)2?")
    assert ok
    kind, a, b, c, sval = nodes[nodes.length - 1]
    p1ok, p1, p1err = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 7)
    assert p1ok
    assert p1.length == 2
    // sample: deterministic per seed, members drawn from the set
    p1bok, p1b, p1berr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 7)
    assert p1bok
    m0, q1, q2 = p1[0]
    m0b, q3, q4 = p1b[0]
    assert m0 == m0b
    valid: Set<text> = Set()
    for e in els
        en, ee, ef = e
        valid.add(en)
    for se in p1
        sn, se1, se2 = se
        assert valid.has(sn)
    // purity: takes of pure sets stay pure; count expressions must be pure
    ok, nodes, kids, muts, err, pos = script_parse("(a*)5")
    assert ok
    assert not muts[nodes.length - 1]
    assert runs_local("(a*)5 , (b*)3?")
    ok, nodes, kids, muts, err, pos = script_parse("(a*)(|(b*)!|)")
    assert not ok
    // attachment: spaced or bare-word groups stay juxtaposition errors
    ok, nodes, kids, muts, err, pos = script_parse("(a*) (5)")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("a*(5)")
    assert not ok
    // AST shapes
    ok, nodes, kids, muts, err, pos = script_parse("((fire*)10?)!")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (exhaust (sample pattern:fire* num:10)))"
    ok, nodes, kids, muts, err, pos = script_parse("(fire*)(|water*|)")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (take pattern:fire* (size pattern:water*)))"
    // the semantics triangle: 100? and ?100 both sample; ((S)100)? reorders
    ok, nodes, kids, muts, err, pos = script_parse("(a*)100?")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (sample pattern:a* num:100))"
    ok, nodes, kids, muts, err, pos = script_parse("(a*)?100")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (take (shuffle pattern:a*) num:100))"
    ok, nodes, kids, muts, err, pos = script_parse("((a*)100)?")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (shuffle (take pattern:a* num:100)))"

test "lucky pairs sampling"
    els: List<(text, text, bool)> = [("Water", "w", false), ("Fire", "f", false), ("Wind", "n", false), ("Earth", "e", false)]
    recipes: Map<text, List<(text, text)>> = Map()
    no_tried: List<text> = []
    p1 = lucky_pairs_boundary(els, recipes, no_tried, 3, 42)
    p2 = lucky_pairs_boundary(els, recipes, no_tried, 3, 42)
    assert p1.length == 3
    assert p2.length == 3
    for idx = 0 to 2
        a1, e1, f1, b1, e2, f2 = p1[idx]
        a2, x1, x2, b2, x3, x4 = p2[idx]
        assert a1 == a2
        assert b1 == b2
    // known recipes are excluded from the untried space
    steam_pairs: List<(text, text)> = [("Fire", "Water")]
    recipes["Steam"] = steam_pairs
    p3 = lucky_pairs_boundary(els, recipes, no_tried, 10, 7)
    for p in p3
        a3, y1, y2, b3, y3, y4 = p
        ka, kb = pair_key(a3, b3)
        assert not (ka == "Fire" and kb == "Water")
    // exhausted space returns fewer (or zero) pairs, never loops forever
    two: List<(text, text, bool)> = [("A", "", false), ("B", "", false)]
    all_tried: List<text> = ["A\u{0}A", "A\u{0}B", "B\u{0}B"]
    empty_recipes: Map<text, List<(text, text)>> = Map()
    p4 = lucky_pairs_boundary(two, empty_recipes, all_tried, 5, 99)
    assert p4.length == 0
    // large-n path: enumerate, never churn — n > space returns everything
    two2: List<(text, text, bool)> = [("A", "", false), ("B", "", false)]
    empty_r: Map<text, List<(text, text)>> = Map()
    no_t: List<text> = []
    p5 = lucky_pairs_boundary(two2, empty_r, no_t, 19000, 5)
    assert p5.length == 3
    p6 = lucky_pairs_boundary(two2, empty_r, no_t, 19000, 5)
    assert p6.length == 3
    a5, q5a, q5b, b5, q5c, q5d = p5[0]
    a6, q6a, q6b, b6, q6c, q6d = p6[0]
    assert a5 == a6
    assert b5 == b6
    // enumeration respects tried/known exclusions
    one_tried: List<text> = ["A\u{0}B"]
    p7 = lucky_pairs_boundary(two2, empty_r, one_tried, 100, 9)
    assert p7.length == 2
    // /lucky never dups in the queue
    q: List<text> = ["/lucky 5"]
    assert queue_accept("/lucky 5", "/lucky 5", q, 1, 50) == "ok"
    assert queue_accept("/exhaust a*", "/exhaust a*", q, 1, 50) == "dup"
    // /lucky is wired into dispatch/validation
    assert is_known_slash_command("/lucky")
    assert is_known_slash_command("/lucky 25")
    assert may_bulk_confirm("/lucky 500")
    assert validate_command_line("/lucky").is_none()
    assert validate_command_line("/lucky 25").is_none()
    assert validate_command_line("/lucky banana").is_some()
    assert not runs_local("/lucky 5")

test "runs_local: pure loop-free scripts are immediate"
    assert runs_local("/search fire*")
    assert runs_local("/.* .*/")
    assert runs_local("fire* , water*")
    assert runs_local("x := a* - b* ; x")
    assert runs_local("^(steam*)")
    assert runs_local("[ w* ]")
    assert runs_local("|a*| > 2 ? {steam} : {mud}")
    assert not runs_local("fire + water")
    assert not runs_local("(fire*)*")
    assert not runs_local("{ x := w* } -> |zzz*| > 0")
    assert not runs_local("w* @x { x , steam }")
    assert not runs_local("/exhaust fire*")
    assert not runs_local("/import Steam")
    assert not runs_local("/script run.ice")
    assert not runs_local("/notacommand")
    assert not runs_local("")

test "known slash command inventory"
    cmds = known_slash_commands()
    assert cmds.length == 24
    for c in cmds
        assert is_known_slash_command(c)

test "known slash command dispatch"
    assert is_known_slash_command("/help")
    assert is_known_slash_command("/exhaust fire*")
    assert is_known_slash_command("/script run.ice")
    assert not is_known_slash_command("/steam/ , fire*")
    assert not is_known_slash_command("/steam/")
    assert not is_known_slash_command("fire + water")
    assert not is_known_slash_command("/notacommand x")

test "script eval v0.6"
    els: List<(text, text, bool)> = [("Water", "w", false), ("Fire", "f", false), ("Steam", "s", true), ("Firefly", "ff", false), ("Mud", "m", false)]
    recipes: Map<text, List<(text, text)>> = Map()
    steam_pairs: List<(text, text)> = [("Fire", "Water")]
    recipes["Steam"] = steam_pairs
    mud_pairs: List<(text, text)> = [("Earth", "Water")]
    recipes["Mud"] = mud_pairs
    no_names: List<text> = []
    no_vals: List<List<(text, text, bool)>> = []
    no_reg: List<(text, text, bool)> = []
    // pattern eval
    ok, nodes, kids, muts, err, pos = script_parse("fire*")
    assert ok
    kind, a, b, c, sval = nodes[nodes.length - 1]
    stmt = kids[a][0]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, stmt, els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 2
    n0, e0, f0 = eset[0]
    assert n0 == "Fire"
    // bare ref: resolve chain incl title-case; miss errors
    ok, nodes, kids, muts, err, pos = script_parse("water")
    assert ok
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 1
    ok, nodes, kids, muts, err, pos = script_parse("xyzzy")
    assert ok
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert not eok
    // env shadowing: variable wins over element
    env_names: List<text> = ["water"]
    env_vals: List<List<(text, text, bool)>> = [[("Steam", "s", true), ("Mud", "m", false)]]
    ok, nodes, kids, muts, err, pos = script_parse("water")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, env_names, env_vals, no_reg, 1)
    assert eok
    assert eset.length == 2
    // union dedup + order, diff, intersect
    ok, nodes, kids, muts, err, pos = script_parse("fire* , steam")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 3
    ok, nodes, kids, muts, err, pos = script_parse("fire* - firefly")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 1
    ok, nodes, kids, muts, err, pos = script_parse("fire* & firefly")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 1
    // canrec / cantrec: Fire has a known recipe with Water; Firefly has none
    ok, nodes, kids, muts, err, pos = script_parse("fire* / water")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 1
    n1, e1, f1 = eset[0]
    assert n1 == "Fire"
    ok, nodes, kids, muts, err, pos = script_parse("fire* % water")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 1
    n2, e2, f2 = eset[0]
    assert n2 == "Firefly"
    // first filter and newreg
    ok, nodes, kids, muts, err, pos = script_parse("^(fire* , steam)")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, no_reg, 1)
    assert eok
    assert eset.length == 1
    reg: List<(text, text, bool)> = [("Mud", "m", false)]
    ok, nodes, kids, muts, err, pos = script_parse("[] , steam")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    eok, eset, eerr = script_eval_expr_boundary(nodes, kids, kids[a][0], els, recipes, no_names, no_vals, reg, 1)
    assert eok
    assert eset.length == 2
    // conditions: sizes, arithmetic, modulo, truthiness, short-circuit
    ok, nodes, kids, muts, err, pos = script_parse("|fire*| + 1 == 3 ? {steam} : {mud}")
    assert ok
    kind, a, b, c, sval = nodes[nodes.length - 1]
    tern = kids[a][0]
    tk, ta, tb, tc, ts = nodes[tern]
    assert tk == "ternary"
    cok, truth, cerr = script_eval_cond_boundary(nodes, kids, ta, els, recipes, no_names, no_vals, no_reg, 1)
    assert cok
    assert truth
    ok, nodes, kids, muts, err, pos = script_parse("|fire*| % 2 == 0 && |steam*| == 1 ? {a} : {b}")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    tern2 = kids[a][0]
    tk2, ta2, tb2, tc2, ts2 = nodes[tern2]
    cok, truth, cerr = script_eval_cond_boundary(nodes, kids, ta2, els, recipes, no_names, no_vals, no_reg, 1)
    assert cok
    assert truth
    ok, nodes, kids, muts, err, pos = script_parse("nope* || |fire*| > 1 ? {a} : {b}")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    tern3 = kids[a][0]
    tk3, ta3, tb3, tc3, ts3 = nodes[tern3]
    cok, truth, cerr = script_eval_cond_boundary(nodes, kids, ta3, els, recipes, no_names, no_vals, no_reg, 1)
    assert cok
    assert truth
    ok, nodes, kids, muts, err, pos = script_parse("|a| / 0 > 1 ? {a} : {b}")
    kind, a, b, c, sval = nodes[nodes.length - 1]
    tern4 = kids[a][0]
    tk4, ta4, tb4, tc4, ts4 = nodes[tern4]
    cok, truth, cerr = script_eval_cond_boundary(nodes, kids, ta4, els, recipes, no_names, no_vals, no_reg, 1)
    assert not cok
    // union tuple helper preserves order and dedups
    u = script_union_tuples([("A", "", false), ("B", "", false)], [("B", "x", true), ("C", "", false)])
    assert u.length == 3

test "script parser v0.6"
    ok, nodes, kids, muts, err, pos = script_parse("fire + water")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (combine ref:fire ref:water))"
    ok, nodes, kids, muts, err, pos = script_parse("(fire*)* -> |[]| < 3")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (until (permute pattern:fire*) (cmp < (size newreg) num:3)))"
    ok, nodes, kids, muts, err, pos = script_parse("before := ^(fire* / water*) ; (before)* ; [] * (earth* / before)")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (assign before (first (canrec pattern:fire* pattern:water*))) (permute ref:before) (cross newreg (canrec pattern:earth* ref:before)))"
    ok, nodes, kids, muts, err, pos = script_parse("x := a* , (b* * c*)")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (assign x (union pattern:a* (cross pattern:b* pattern:c*))))"
    ok, nodes, kids, muts, err, pos = script_parse("fire* @f { (f)! } ; |[]| >= 1 ? {a} : {b}"
    )
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (foreach f pattern:fire* (block (exhaust ref:f))) (ternary (cmp >= (size newreg) num:1) (block ref:a) (block ref:b)))"
    ok, nodes, kids, muts, err, pos = script_parse("{ (fire*)* } ~ |!| < 2000")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (while (block (permute pattern:fire*)) (cmp < (size pattern:!) num:2000)))"
    ok, nodes, kids, muts, err, pos = script_parse("(metal* % fire*)!")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (exhaust (cantrec pattern:metal* pattern:fire*)))"
    ok, nodes, kids, muts, err, pos = script_parse("\u{22}salt, pepper\u{22} + fire")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (combine strref:salt, pepper ref:fire))"
    // muts flags: pure statements vs mutating ones
    ok, nodes, kids, muts, err, pos = script_parse("fire* , water* ; fire + water")
    assert ok
    root_kind, root_a, root_b, root_c, root_s = nodes[nodes.length - 1]
    stmts = kids[root_a]
    assert not muts[stmts[0]]
    assert muts[stmts[1]]
    // static errors
    ok, nodes, kids, muts, err, pos = script_parse("(fire*)* -> |[ (fire*)* ]| < 3")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("a - (b* * c*) ? {x} : {y}")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("{x} -> |a - (b* * c*)| > 0")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("x := a* , b* * c*")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("12 + water")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("a ; /fill")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("(_)!")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("fire* @ { (_)! }")
    assert ok
    ok, nodes, kids, muts, err, pos = script_parse("{a; b}")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("|a| > 2")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("fire water")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script ref:fire water)"
    ok, nodes, kids, muts, err, pos = script_parse("(a) (b)")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("(w*) !")
    assert not ok
    assert strings.starts_with(err, "Postfix operators attach")
    // space-star patterns: `(Best *)!` works (star attached to `)` stays
    // pattern material) but the bare and size-bar forms hit the cross
    // operator — those get the targeted hint
    ok, nodes, kids, muts, err, pos = script_parse("(Best *)!")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (exhaust pattern:Best *))"
    ok, nodes, kids, muts, err, pos = script_parse("Best *")
    assert not ok
    assert strings.starts_with(err, "A standalone * is the cross operator")
    ok, nodes, kids, muts, err, pos = script_parse("|Best *| > 25 ? {a} : {b}")
    assert not ok
    assert strings.starts_with(err, "A standalone * is the cross operator")
    ok, nodes, kids, muts, err, pos = script_parse("(Best ?*)! -> |Best ?*| > 25")
    assert ok
    assert script_ast_repr(nodes, kids, nodes.length - 1) == "(script (until (exhaust pattern:Best ?*) (cmp > (size pattern:Best ?*) num:25)))"
    ok, nodes, kids, muts, err, pos = script_parse("(/^best /)! -> |/^best /| > 25")
    assert ok
    ok, nodes, kids, muts, err, pos = script_parse("x := ")
    assert not ok
    ok, nodes, kids, muts, err, pos = script_parse("water +| fire*")
    assert not ok
    assert strings.starts_with(err, "+| was removed")

test "script tokenizer v0.6"
    ok, toks, err, pos = script_tokenize("mountain range + ship")
    assert ok
    assert script_tokens_repr(toks) == "word:mountain range\u{a7}op:+\u{a7}word:ship"
    ok, toks, err, pos = script_tokenize("fire* * water*")
    assert ok
    assert script_tokens_repr(toks) == "word:fire*\u{a7}op:*\u{a7}word:water*"
    ok, toks, err, pos = script_tokenize("(fire*)* -> |[]| < 3")
    assert ok
    assert script_tokens_repr(toks) == "(\u{a7}word:fire*\u{a7})\u{a7}post:*\u{a7}op:->\u{a7}|\u{a7}[]\u{a7}|\u{a7}op:<\u{a7}word:3"
    ok, toks, err, pos = script_tokenize("[bc]at + mu[dg]")
    assert ok
    assert script_tokens_repr(toks) == "word:[bc]at\u{a7}op:+\u{a7}word:mu[dg]"
    ok, toks, err, pos = script_tokenize("[ fire* ]")
    assert ok
    assert script_tokens_repr(toks) == "[\u{a7}word:fire*\u{a7}]"
    ok, toks, err, pos = script_tokenize("[]!")
    assert ok
    assert script_tokens_repr(toks) == "[]\u{a7}post:!"
    ok, toks, err, pos = script_tokenize("x := a* , (b* * c*)")
    assert ok
    assert script_tokens_repr(toks) == "word:x\u{a7}op::=\u{a7}word:a*\u{a7},\u{a7}(\u{a7}word:b*\u{a7}op:*\u{a7}word:c*\u{a7})"
    ok, toks, err, pos = script_tokenize("fire* @f { (f)! }")
    assert ok
    assert script_tokens_repr(toks) == "word:fire*\u{a7}atid:f\u{a7}{\u{a7}(\u{a7}word:f\u{a7})\u{a7}post:!\u{a7}}"
    ok, toks, err, pos = script_tokenize("\u{22}salt, pepper\u{22} + fire")
    assert ok
    assert script_tokens_repr(toks) == "str:salt, pepper\u{a7}op:+\u{a7}word:fire"
    ok, toks, err, pos = script_tokenize("(/^best /)! ; a* / ^(b*)")
    assert ok
    assert script_tokens_repr(toks) == "(\u{a7}word:/^best /\u{a7})\u{a7}post:!\u{a7};\u{a7}word:a*\u{a7}op:/\u{a7}^(\u{a7}word:b*\u{a7})"
    ok, toks, err, pos = script_tokenize("/steam engine/ + x")
    assert ok
    assert script_tokens_repr(toks) == "word:/steam engine/\u{a7}op:+\u{a7}word:x"
    ok, toks, err, pos = script_tokenize("^(before) ; ^fire*")
    assert ok
    assert script_tokens_repr(toks) == "^(\u{a7}word:before\u{a7})\u{a7};\u{a7}word:^fire*"
    ok, toks, err, pos = script_tokenize("a* # trailing note")
    assert ok
    assert script_tokens_repr(toks) == "word:a*"
    ok, toks, err, pos = script_tokenize("jack-in-the-box + water")
    assert ok
    assert script_tokens_repr(toks) == "word:jack-in-the-box\u{a7}op:+\u{a7}word:water"
    ok, toks, err, pos = script_tokenize("|a*| || |b?|")
    assert ok
    assert script_tokens_repr(toks) == "|\u{a7}word:a*\u{a7}|\u{a7}op:||\u{a7}|\u{a7}word:b?\u{a7}|"
    ok, toks, err, pos = script_tokenize("!fire* - !")
    assert ok
    assert script_tokens_repr(toks) == "word:!fire*\u{a7}op:-\u{a7}word:!"
    ok, toks, err, pos = script_tokenize("c ? {a} : {b}")
    assert ok
    assert script_tokens_repr(toks) == "word:c\u{a7}op:?\u{a7}{\u{a7}word:a\u{a7}}\u{a7}op::\u{a7}{\u{a7}word:b\u{a7}}"
    ok, toks, err, pos = script_tokenize("\u{22}unterminated")
    assert not ok

test "auto approve and rate note"
    assert is_local_command("/auto")
    assert is_local_command("/auto on")
    assert command_queue_lane("/auto") == "local"
    kind, state = auto_approve_outcome(false, "")
    assert kind == "on"
    assert state
    kind, state = auto_approve_outcome(true, "")
    assert kind == "off"
    assert not state
    kind, state = auto_approve_outcome(false, "  ON ")
    assert kind == "on"
    assert state
    kind, state = auto_approve_outcome(true, "off")
    assert kind == "off"
    assert not state
    kind, state = auto_approve_outcome(true, "status")
    assert kind == "show_on"
    assert state
    kind, state = auto_approve_outcome(false, "show")
    assert kind == "show_off"
    assert not state
    kind, state = auto_approve_outcome(false, "banana")
    assert kind == "invalid"
    assert not state
    assert bulk_confirm_required(500, 200, false)
    assert not bulk_confirm_required(500, 200, true)
    assert not bulk_confirm_required(100, 200, false)
    assert not bulk_confirm_required(100, 200, true)
    assert rate_status_note(0) == "Rate limiting in progress"
    assert rate_status_note(-1) == "Rate limiting in progress"
    assert rate_status_note(1) == ""
    assert rate_status_note(60) == ""

test "retry policy parity"
    assert fetch_timeout_ms() == 30000
    assert pair_retry_max_attempts() == 3
    assert pair_retry_backoff_ms(0) == 1000
    assert pair_retry_backoff_ms(1) == 2000
    assert pair_retry_backoff_ms(2) == 4000
    assert pair_should_retry(0)
    assert pair_should_retry(1)
    assert not pair_should_retry(2)
    assert ib_retry_max_attempts() == 4
    assert ib_retry_backoff_ms(0) == 2000
    assert ib_retry_backoff_ms(1) == 4000
    assert ib_retry_backoff_ms(2) == 8000
    assert ib_should_retry(429, 0)
    assert ib_should_retry(0, 0)
    assert ib_should_retry(429, 2)
    assert not ib_should_retry(429, 3)
    assert not ib_should_retry(0, 3)
    assert not ib_should_retry(404, 0)
    assert not ib_should_retry(500, 0)
    assert not ib_should_retry(200, 0)

test "is_local_command parity"
    assert is_local_command("/help")
    assert is_local_command("/list")
    assert is_local_command("/history")
    assert is_local_command("/clear")
    assert is_local_command("/queue")
    assert is_local_command("/unfilled")
    assert is_local_command("/unfilled extra")
    assert is_local_command("/search")
    assert is_local_command("/search water")
    assert is_local_command("/recipe")
    assert is_local_command("/recipe Fire")
    assert is_local_command("/target")
    assert is_local_command("/target Steam")
    assert is_local_command("/target clear")
    assert is_local_command("/relay")
    assert is_local_command("/relay off")
    assert not is_local_command("/combine Water + Fire")
    assert not is_local_command("/fill")
    assert not is_local_command("/prune")
