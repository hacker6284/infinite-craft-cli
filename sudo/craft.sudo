// Pure host-adapter-free Infinite Craft kernel (v2 / CLI v1.4.2).
// Single kernel behavior = Python CLI. No `_js` siblings.
// Matching uses vendored regex.sudo (linear-time; no safety gates/timeouts).

import std.strings
import std.regex
import std.sorting

record Element
    name: text
    emoji: text
    first: bool

record RecipeStep
    a: text
    b: text
    result: text

enum RecipeResult
    NotFound
    IsBase(name: text)
    NoRecipe(name: text)
    Unreachable(name: text)
    Steps(target: text, steps: List<RecipeStep>)

// ---------------------------------------------------------------------------
// Base elements
// ---------------------------------------------------------------------------

export func is_base_element(name: text) -> bool
    return name == "Water" or name == "Fire" or name == "Wind" or name == "Earth"

// ---------------------------------------------------------------------------
// ASCII char helpers
// ---------------------------------------------------------------------------

func upper_char(c: int) -> int
    if c >= 'a' and c <= 'z'
        return c - 32
    return c

func lower_char(c: int) -> int
    if c >= 'A' and c <= 'Z'
        return c + 32
    return c

func is_alpha_ascii(c: int) -> bool
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')

func is_word_char(c: int) -> bool
    // Python regex \w = [A-Za-z0-9_]
    return is_alpha_ascii(c) or (c >= '0' and c <= '9') or c == '_'

// ---------------------------------------------------------------------------
// strip / substring helpers (stdlib has no trim/slice)
// ---------------------------------------------------------------------------

func is_ascii_space(c: int) -> bool
    return c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12

func strip_spaces(s: text) -> text
    start = 0
    end = s.length
    while start < end and is_ascii_space(s[start])
        start = start + 1
    while end > start and is_ascii_space(s[end - 1])
        end = end - 1
    out: text = ""
    for i = start to end - 1
        out.append(s[i])
    return out

func strip_prefix_one(s: text) -> text
    out: text = ""
    for i = 1 to s.length - 1
        out.append(s[i])
    return out

func text_slice(s: text, start: int, end: int) -> text
    out: text = ""
    i = start
    while i < end and i < s.length
        out.append(s[i])
        i = i + 1
    return out

func text_from(s: text, start: int) -> text
    return text_slice(s, start, s.length)

// Hand-rolled base-10 conversion — sudo has no built-in int-to-text.
func int_to_text(n: int) -> text
    if n == 0
        return "0"
    if n < 0
        return "-" + int_to_text(0 - n)
    digits: List<int> = []
    x = n
    while x > 0
        digits.append(x mod 10)
        x = x / 10
    out: text = ""
    for i = digits.length - 1 downto 0
        out.append('0' + digits[i])
    return out

func repeat_char(c: int, n: int) -> text
    out: text = ""
    for i = 1 to n
        out.append(c)
    return out

// ---------------------------------------------------------------------------
// Title-casing — ASCII approximation of Python str.title(), with one
// intentional divergence: apostrophes do not start a new word.
// ---------------------------------------------------------------------------

func is_apostrophe(c: int) -> bool
    // ASCII ' (39) and Unicode right single quotation mark U+2019 (8217),
    // which paste/autocorrect often produce in contractions like "don't".
    return c == 39 or c == 8217

export func title_case(s: text) -> text
    // Like Python str.title() for spaces/punctuation/digits, with a targeted
    // fix for apostrophes in Infinite Craft names:
    //
    // Python title() resets the word boundary on every non-letter, so
    // "you don't" becomes "You Don'T". That form both misses stored
    // contraction names and is sent to the pair API for undiscovered
    // operands (screenshot: `Beach + You Don't` → displayed/sent as
    // `You Don'T` → Nothing).
    //
    // Rule: an apostrophe does not start a new word when the letters so
    // far in the current word are a multi-letter stem (don't → Don't,
    // baker's → Baker's). A single letter before the apostrophe still
    // capitalizes the next letter (o'brien → O'Brien), matching names
    // like O'Brien / O'Clock.
    out: text = ""
    prev_cased = false
    letters_in_word = 0
    for c in s
        if is_alpha_ascii(c)
            // Capitalize when starting a word, or right after an
            // apostrophe that followed a single-letter stem (O'Brien).
            start_word = not prev_cased
            if start_word
                out.append(upper_char(c))
            else
                out.append(lower_char(c))
            prev_cased = true
            letters_in_word = letters_in_word + 1
        else if is_apostrophe(c)
            out.append(c)
            // Multi-letter stem (don't): stay in-word so 't' stays lower.
            // Single-letter stem (o'): drop in-word so 'b' capitalizes.
            if letters_in_word == 1
                prev_cased = false
            // else leave prev_cased true; letters_in_word unchanged
        else
            out.append(c)
            prev_cased = false
            letters_in_word = 0
    return out

// ---------------------------------------------------------------------------
// Element-name storage normalization
// ---------------------------------------------------------------------------

export func sanitize_element_name(name: text) -> text
    // Normalization applied to API/import element names before storage
    // (owner ruling 2026-08-07): strip ASCII whitespace at both ends, then
    // drop control characters — C0 (U+0000–U+001F), DEL (U+007F), C1
    // (U+0080–U+009F) — and the Unicode line/paragraph separators
    // U+2028/U+2029. Hosts may additionally sanitize for DISPLAY (TTY
    // escapes, DOM escaping) at print time; this is the only normalization
    // that decides what gets persisted, so both hosts store identical
    // names for identical payloads.
    out: text = ""
    for c in strip_spaces(name)
        if c < 32 or c == 127 or (c >= 128 and c <= 159) or c == 8232 or c == 8233
            continue
        out.append(c)
    return out

// ---------------------------------------------------------------------------
// Name lookup / resolve
// ---------------------------------------------------------------------------

func get_by_name(elements: List<Element>, name: text) -> Option<Element>
    for e in elements
        if e.name == name
            return Some(e)
    return None

func ascii_lower_text(s: text) -> text
    out: text = ""
    for c in s
        out.append(lower_char(c))
    return out

func get_by_name_ci(elements: List<Element>, name: text) -> Option<Element>
    // ASCII case-insensitive scan only — first hit wins. Apostrophe code
    // points are NOT folded: the live pair API treats "You Don't" (U+0027)
    // and "You Don't" (U+2019) as distinct element names, so inventory and
    // resolve must keep them separate.
    needle = ascii_lower_text(name)
    for e in elements
        if ascii_lower_text(e.name) == needle
            return Some(e)
    return None

func resolve_element(elements: List<Element>, name: text) -> Element
    // Lookups are inlined (not get_by_name / get_by_name_ci). sudoc deep-copies
    // every List parameter on entry, so calling those helpers would re-dup the
    // entire inventory up to four times per resolve — multi-second on large
    // saves when hosts format multi-step /recipe output. One list ownership
    // here, several linear scans.
    for e in elements
        if e.name == name
            return e
    stripped = strip_spaces(name)
    if not (stripped == name)
        for e in elements
            if e.name == stripped
                return e
    // title_case preserves the input's apostrophe code point (straight or
    // curly); it only changes letter case.
    title = title_case(stripped)
    if not (title == stripped)
        for e in elements
            if e.name == title
                return e
    needle = ascii_lower_text(stripped)
    for e in elements
        if ascii_lower_text(e.name) == needle
            return e
    return Element(name = title, emoji = "", first = false)

// ---------------------------------------------------------------------------
// Sorted pair key / record_recipe
// ---------------------------------------------------------------------------

export func pair_key(a: text, b: text) -> (text, text)
    if strings.lex_compare(a, b) <= 0
        return (a, b)
    return (b, a)

export func record_recipe(recipes: inout Map<text, List<(text, text)>>, result_name: text, a_name: text, b_name: text)
    // Pair-membership check is inlined: a helper taking the pair list would
    // deep-copy it on every record_recipe call (sudoc List arg semantics).
    pair = pair_key(a_name, b_name)
    existing = recipes.get(result_name).get_or([])
    has = false
    for p in existing
        if p == pair
            has = true
            break
    if not has
        existing.append(pair)
        recipes[result_name] = existing

export func record_recipes_batch(recipes: inout Map<text, List<(text, text)>>, entries: List<(text, text, text)>)
    for entry in entries
        result_name, a_name, b_name = entry
        record_recipe(recipes, result_name, a_name, b_name)

// ---------------------------------------------------------------------------
// add_element / batch (no discovered-flag promotion on re-add)
// ---------------------------------------------------------------------------

func add_element(elements: inout List<Element>, name: text, emoji: text, first: bool) -> bool
    // Membership scan inlined (not find_index_by_name): that helper would
    // deep-copy the whole element list on every insert-or-ignore check —
    // catastrophic inside add_elements_batch on large inventories.
    for i = 0 to elements.length - 1
        if elements[i].name == name
            return false
    elements.append(Element(name = name, emoji = emoji, first = first))
    return true

func add_elements_batch(elements: inout List<Element>, items: List<(text, text, bool)>) -> int
    // Single ownership of `elements` for the whole batch: do not call
    // add_element (a separate function taking the list) per item — each call
    // would re-enter and, with nested helpers, re-dup. Inline the same
    // insert-or-ignore rule once per item against the shared list.
    added = 0
    for item in items
        n, em, f = item
        found = false
        for i = 0 to elements.length - 1
            if elements[i].name == n
                found = true
                break
        if not found
            elements.append(Element(name = n, emoji = em, first = f))
            added = added + 1
    return added

// ---------------------------------------------------------------------------
// Deterministic sorts — std.sorting.sort_by (stable merge sort, O(n log n)
// since sudoc v0.6.0) with top-level comparators; sudo has no closures, so anything a comparison
// needs must live in the sorted items themselves.
// NOTE: sorting.sort_by historically hit a Rust-backend cross-module
// `inout` codegen bug (see DIVERGENCES.md, "sudo language friction");
// fixed in sudoc v0.3.0, so present in the v0.4.0 toolchain this repo
// pins; regression-covered upstream by conformance/multimodule/xmod_inout.
// ---------------------------------------------------------------------------

func text_lex_less(a: text, b: text) -> bool
    return strings.lex_compare(a, b) < 0

func element_name_less(a: Element, b: Element) -> bool
    return strings.lex_compare(a.name, b.name) < 0

func sorted_text_list(items: List<text>) -> List<text>
    out = items
    sorting.sort_by(out, text_lex_less)
    return out

// ---------------------------------------------------------------------------
// Pair generation — exhaust / permute / cross / with
// ---------------------------------------------------------------------------

func exhaust_pairs(matches: List<Element>, all_elements: List<Element>) -> List<(Element, Element)>
    seen: Set<text> = Set()
    pairs: List<(Element, Element)> = []
    for target in matches
        for other in all_elements
            if other.name == target.name
                continue
            key = pair_key(target.name, other.name)
            ka, kb = key
            // Encode pair key as text for Set membership (text,text not settable).
            key_text = ka + "\u{0}" + kb
            if seen.has(key_text)
                continue
            seen.add(key_text)
            pairs.append((target, other))
    return pairs

func permute_pairs(matches: List<Element>) -> List<(Element, Element)>
    // Upper triangle: every unordered pair of distinct matches, in match
    // order — (m[0],m[1]), (m[0],m[2]), ..., (m[n-2],m[n-1]).
    pairs: List<(Element, Element)> = []
    for i = 0 to matches.length - 1
        for j = i + 1 to matches.length - 1
            pairs.append((matches[i], matches[j]))
    return pairs

func cross_pairs(left: List<Element>, right: List<Element>) -> List<(Element, Element)>
    // Left-major product, skipping same-name pairs, deduped on the
    // symmetric pair key (a+b == b+a).
    seen: Set<text> = Set()
    pairs: List<(Element, Element)> = []
    for a in left
        for b in right
            if a.name == b.name
                continue
            key = pair_key(a.name, b.name)
            ka, kb = key
            key_text = ka + "\u{0}" + kb
            if seen.has(key_text)
                continue
            seen.add(key_text)
            pairs.append((a, b))
    return pairs

func with_pairs(target: Element, others: List<Element>) -> List<(Element, Element)>
    // Target paired with each other match, in match order; the target
    // itself is skipped. No pair-key dedup needed: others are unique.
    pairs: List<(Element, Element)> = []
    for o in others
        if o.name == target.name
            continue
        pairs.append((target, o))
    return pairs

func crawl_generation_pairs(pool: List<Element>, tried: Set<text>) -> (List<(Element, Element)>, List<text>)
    // One crawl generation: every untried unordered pair over the pool,
    // INCLUDING self-pairs (j starts at i). owner rulings 2026-08-07 (see
    // DIVERGENCES.md): the pool is iterated in sorted-name order, so pair
    // order is deterministic across hosts regardless of how the pool
    // accumulated. Returns the pairs plus their encoded keys; the caller
    // adds the keys to its tried-set (hosts never build keys themselves).
    sorted_pool = pool
    sorting.sort_by(sorted_pool, element_name_less)
    pairs: List<(Element, Element)> = []
    new_keys: List<text> = []
    for i = 0 to sorted_pool.length - 1
        for j = i to sorted_pool.length - 1
            key = pair_key(sorted_pool[i].name, sorted_pool[j].name)
            ka, kb = key
            key_text = ka + "\u{0}" + kb
            if tried.has(key_text)
                continue
            pairs.append((sorted_pool[i], sorted_pool[j]))
            new_keys.append(key_text)
    return (pairs, new_keys)

// ---------------------------------------------------------------------------
// Pair prioritization (owner rulings 2026-08-07, prioritizer release):
// batch API pairs execute proven combiners first. Score = ingredient-usage
// count of a + count of b, descending; ties break on ascending canonical
// pair key. The sort is spelled out here — no host may rely on its own
// sort's stability or ordering.
// ---------------------------------------------------------------------------

export func ingredient_usage_counts(recipes: Map<text, List<(text, text)>>) -> Map<text, int>
    // +1 per ingredient slot per recorded recipe: a self-pair [X, X]
    // counts X twice; results do not count, only ingredient slots.
    // Iteration order does not affect the counts map — do not sort keys
    // (sorting the keys is pure overhead on every bulk command; it was
    // outright quadratic back when sort_by was insertion sort).
    counts: Map<text, int> = Map()
    for name in recipes.keys()
        for pair in recipes[name]
            pa, pb = pair
            counts[pa] = counts.get(pa).get_or(0) + 1
            counts[pb] = counts.get(pb).get_or(0) + 1
    return counts

func priority_row_less(a: (int, text, text, int), b: (int, text, text, int)) -> bool
    // Decorated row: (score, key_first, key_second, input_index).
    // Higher score first; equal scores order by ascending canonical pair
    // key; identical (score, key) falls back to input order, making the
    // order a total one independent of sort stability.
    a_score, a_k1, a_k2, a_idx = a
    b_score, b_k1, b_k2, b_idx = b
    if a_score != b_score
        return a_score > b_score
    c = strings.lex_compare(a_k1, b_k1)
    if c != 0
        return c < 0
    c2 = strings.lex_compare(a_k2, b_k2)
    if c2 != 0
        return c2 < 0
    return a_idx < b_idx

func prioritize_pairs(pairs: List<(Element, Element)>, recipes: Map<text, List<(text, text)>>) -> List<(Element, Element)>
    counts = ingredient_usage_counts(recipes)
    rows: List<(int, text, text, int)> = []
    idx = 0
    for p in pairs
        a, b = p
        score = counts.get(a.name).get_or(0) + counts.get(b.name).get_or(0)
        ka, kb = pair_key(a.name, b.name)
        rows.append((score, ka, kb, idx))
        idx = idx + 1
    // One stdlib call. This was a hand-inlined heapsort until sudoc v0.7.1.
    // sort_by was insertion sort (O(n²)) through v0.5.0; v0.6.0 made it a
    // merge sort but the generated code still deep-copied the whole list four
    // times per merge pass, so the builtin lost to the heapsort. v0.7.1 fixed
    // the swap and added copy-on-write lists; v0.7.3 made that COW uniform and
    // stopped read-only destructures copying. Measured on 441 choose-2 =
    // 97,020 pairs, py backend, byte-identical output ordering throughout:
    // heapsort 40.2s, this 6.6s.
    sorting.sort_by(rows, priority_row_less)
    out: List<(Element, Element)> = []
    for row in rows
        r_score, r_k1, r_k2, r_idx = row
        assert r_score == r_score
        assert r_k1 == r_k1
        assert r_k2 == r_k2
        out.append(pairs[r_idx])
    return out

// ---------------------------------------------------------------------------
// Recipe BFS / backtrack / trace (unbounded depth)
// ---------------------------------------------------------------------------

// Layered BFS from the four bases: each pass collects every not-yet-visited
// result whose first ready pair has both ingredients available, then commits
// them to `visited`/`parent` together, so same-layer results cannot depend
// on each other. The first ready pair in list order wins for each result.
//
// Readiness is inlined against the precomputed `has_pairs` set, the key list
// is never sorted, and the scan stops the moment `target` is reached. All
// three avoid work that made `/recipe` hang on real saves; DIVERGENCES.md §1
// carries the rationale and the invariants that keep them output-equivalent
// to the old form.
func compute_layers(target: text, recipes: Map<text, List<(text, text)>>) -> (bool, Map<text, (text, text)>)
    parent: Map<text, (text, text)> = Map()
    visited: Set<text> = Set()
    visited.add("Water")
    visited.add("Fire")
    visited.add("Wind")
    visited.add("Earth")
    keys = recipes.keys()
    has_pairs: Set<text> = Set()
    for k in keys
        if recipes[k].length > 0
            has_pairs.add(k)
    found = false
    while not found
        new_names: List<text> = []
        new_pairs: Map<text, (text, text)> = Map()
        for result_name in keys
            // Target found mid-layer: ancestors are already in `parent` from
            // prior layers, and backtrack only walks parent links from the
            // target, so co-layer siblings are unnecessary. Stop scanning.
            if found
                break
            if visited.has(result_name)
                continue
            if new_pairs.has(result_name)
                continue
            if not has_pairs.has(result_name)
                continue
            pairs = recipes[result_name]
            for pair in pairs
                pa, pb = pair
                // Inlined readiness (see performance notes above).
                a_ok = visited.has(pa) or is_base_element(pa) or not has_pairs.has(pa)
                b_ok = visited.has(pb) or is_base_element(pb) or not has_pairs.has(pb)
                if a_ok and b_ok
                    new_pairs[result_name] = pair
                    new_names.append(result_name)
                    if result_name == target
                        found = true
                    break
        if new_names.length == 0
            break
        for rn in new_names
            pr = new_pairs[rn]
            parent[rn] = pr
            visited.add(rn)
    return (found, parent)

func backtrack_steps(target: text, parent: Map<text, (text, text)>) -> List<RecipeStep>
    resolved: Set<text> = Set()
    resolved.add("Water")
    resolved.add("Fire")
    resolved.add("Wind")
    resolved.add("Earth")
    to_resolve: List<text> = [target]
    steps: List<RecipeStep> = []
    while to_resolve.length > 0
        nm = to_resolve.pop()
        if resolved.has(nm)
            continue
        if not parent.has(nm)
            resolved.add(nm)
            continue
        pr = parent[nm]
        a, b = pr
        deferred = false
        for dep in [a, b]
            if resolved.has(dep)
                continue
            if not parent.has(dep) and not is_base_element(dep)
                resolved.add(dep)
                continue
            to_resolve.append(nm)
            to_resolve.append(dep)
            deferred = true
            break
        if not deferred
            steps.append(RecipeStep(a = a, b = b, result = nm))
            resolved.add(nm)
    return steps

func trace_recipe(elements: List<Element>, recipes: Map<text, List<(text, text)>>, name: text) -> RecipeResult
    stripped = strip_spaces(name)
    elem = get_by_name(elements, stripped)
    if elem.is_none()
        elem = get_by_name(elements, title_case(stripped))
    if elem.is_none()
        return NotFound
    target = elem.unwrap().name
    if is_base_element(target)
        return IsBase(target)
    target_pairs = recipes.get(target).get_or([])
    if target_pairs.length == 0
        return NoRecipe(target)
    found, parent = compute_layers(target, recipes)
    if not found
        return Unreachable(target)
    steps = backtrack_steps(target, parent)
    return Steps(target, steps)

// ---------------------------------------------------------------------------
// Export / prune closure (v1.4.2: recipes-only input)
// ---------------------------------------------------------------------------

func included_element_names(recipes: Map<text, List<(text, text)>>) -> Set<text>
    // Transitive closure of recipe ingredients. The final Set is independent
    // of scan order, so we never sort keys/items here — sorted_text_list is
    // re-sorting on every closure iteration made export/prune lag on large
    // saves, and is wasted work at any complexity. The public boundary still
    // returns a sorted name list.
    included: Set<text> = Set()
    included.add("Water")
    included.add("Fire")
    included.add("Wind")
    included.add("Earth")
    for name in recipes.keys()
        pairs = recipes[name]
        if pairs.length > 0
            included.add(name)
    changed = true
    while changed
        changed = false
        // Snapshot current members; order does not affect the fixed point.
        names = included.items()
        for nm in names
            if not recipes.has(nm)
                continue
            for pair in recipes[nm]
                pa, pb = pair
                if not included.has(pa)
                    included.add(pa)
                    changed = true
                if not included.has(pb)
                    included.add(pb)
                    changed = true
    return included

func orphan_candidates(elements: List<Element>, recipes: Map<text, List<(text, text)>>) -> List<Element>
    included = included_element_names(recipes)
    out: List<Element> = []
    for e in elements
        if not included.has(e.name)
            out.append(e)
    return out

func export_elements(elements: List<Element>, recipes: Map<text, List<(text, text)>>) -> List<Element>
    included = included_element_names(recipes)
    out: List<Element> = []
    for e in elements
        if included.has(e.name)
            out.append(e)
    return out

// ---------------------------------------------------------------------------
// Unfilled predicate
// ---------------------------------------------------------------------------

export func is_unfilled(name: text, recipes: Map<text, List<(text, text)>>) -> bool
    // owner ruling 2026-08-07: an element whose recipes entry exists but is
    // an EMPTY list is unfilled — "we know no way to make it". Key presence
    // alone does not make an element filled (consistent with
    // included_element_names, which seeds only non-empty recipe results).
    // Base elements are never unfilled.
    //
    // Cost note: sudoc deep-copies Map args on entry, so a hot loop of
    // is_unfilled(name, recipes) is O(n · |recipes|) in marshalling. Prefer
    // unfilled_names_boundary for bulk scans — it precomputes a filled set
    // once. Hosts that re-check after each /fill lineage should track a
    // local filled set rather than calling this per name.
    if is_base_element(name)
        return false
    return recipes.get(name).get_or([]).length == 0

// ---------------------------------------------------------------------------
// Query filter / pattern match (regex.sudo; no safety gates)
// ---------------------------------------------------------------------------

export func parse_query_filter(query: text) -> (text, bool, bool)
    // owner ruling 2026-07-22: '!' (exclude) and '^' (only_new) prefixes
    // combine — both may appear, in either order ('!^x' and '^!x' both
    // set exclude=true and only_new=true). A repeated prefix consumes
    // only its first occurrence; the second instance stays in the
    // pattern text ('!!x' -> pattern "!x", still exclude=true).
    q = strip_spaces(query)
    exclude = false
    only_new = false
    took_bang = false
    took_caret = false
    keep_going = true
    while keep_going
        if q.length > 0 and q[0] == '!' and not took_bang
            exclude = true
            took_bang = true
            q = strip_prefix_one(q)
        else if q.length > 0 and q[0] == '^' and not took_caret
            only_new = true
            took_caret = true
            q = strip_prefix_one(q)
        else
            keep_going = false
    return (q, exclude, only_new)

export func is_delimited_regex(pattern: text) -> bool
    p = strip_spaces(pattern)
    return p.length >= 2 and p[0] == '/' and p[p.length - 1] == '/'

func is_glob_trigger(pattern: text) -> bool
    for c in pattern
        if c == '*' or c == '?' or c == '[' or c == ']'
            return true
    return false

export func element_matches_pattern(name: text, pattern: text) -> (bool, Option<text>)
    pattern = strip_spaces(pattern)
    if pattern.length == 0
        return (false, None)
    if is_delimited_regex(pattern)
        body = text_slice(pattern, 1, pattern.length - 1)
        // owner ruling 2026-07-22 (R4): an empty regex body ("//") is
        // a valid empty pattern that matches every name — standard
        // empty-regex semantics, not a special "no match" case.
        match regex.regex_search(body, name, true)
            case Err(msg)
                assert msg.length >= 0
                return (false, Some("Invalid regex pattern"))
            case Ok(matched)
                return (matched, None)
    if is_glob_trigger(pattern)
        return (regex.glob_match(pattern, name, true), None)
    return (strings.contains(strings.to_lower(name), strings.to_lower(pattern)), None)

func match_elements(elements: List<Element>, query: text) -> (List<Element>, Option<text>)
    empty: List<Element> = []
    if query.length > 512
        return (empty, Some("Query too long (max 512 characters)"))
    q, exclude, only_new = parse_query_filter(query)
    if strip_spaces(q).length == 0
        if exclude
            return (elements, None)
        if only_new
            firsts: List<Element> = []
            for e in elements
                if e.first
                    firsts.append(e)
            return (firsts, None)
        return (empty, None)
    matches: List<Element> = []
    for e in elements
        matched, err = element_matches_pattern(e.name, q)
        if err.is_some()
            return (empty, err)
        if exclude
            if not matched
                matches.append(e)
        else if matched
            matches.append(e)
    if only_new
        filtered: List<Element> = []
        for e in matches
            if e.first
                filtered.append(e)
        return (filtered, None)
    return (matches, None)

// ---------------------------------------------------------------------------
// Slash / command classification & validation
// ---------------------------------------------------------------------------

export func slash_args(line: text, command: text) -> Option<text>
    if line == command
        return Some("")
    prefix = command + " "
    if strings.starts_with(line, prefix)
        return Some(text_from(line, prefix.length))
    return None

export func is_local_command(line: text) -> bool
    if line == "/help" or line == "/list" or line == "/history" or line == "/clear" or line == "/queue"
        return true
    if line == "/unfilled" or strings.starts_with(line, "/unfilled ")
        return true
    if line == "/search" or strings.starts_with(line, "/search ")
        return true
    if line == "/recipe" or strings.starts_with(line, "/recipe ")
        return true
    if line == "/target" or strings.starts_with(line, "/target ")
        return true
    return false

// Infinibrowser-backed long commands — independent host queue from pair API.
export func is_ib_command(line: text) -> bool
    if line == "/import" or strings.starts_with(line, "/import ")
        return true
    if line == "/fill" or strings.starts_with(line, "/fill ")
        return true
    if line == "/prune" or strings.starts_with(line, "/prune ")
        return true
    return false

// Host queue routing: "local" | "ib" | "pair".
// Local runs immediately; ib and pair are independent FIFO workers.
export func command_queue_lane(line: text) -> text
    if is_local_command(line)
        return "local"
    if is_ib_command(line)
        return "ib"
    return "pair"

// Pure enqueue accept decision. Hosts keep validation, membership snapshots,
// append, worker wake, paint, message chrome. Returns "dup" | "full" | "ok".
// Idle current is "" — hosts store "" (not None/null) for idle worker current.
export func queue_accept(line: text, current: text, lane_queue: List<text>, total_pending: int, max_depth: int) -> text
    // Idle current is "" — do not false-dup empty line unless empty is queued.
    if current.length > 0 and line == current
        return "dup"
    for item in lane_queue
        if item == line
            return "dup"
    if total_pending >= max_depth
        return "full"
    return "ok"

// Pure lane-busy / deferred-ack predicate. Hosts map session flags only:
// current non-empty (running cmd string), pending_len (lane queue depth),
// confirm_active (pair confirm / bulk / folded workerRunning). True → show
// "Queued:" ack; validation, append, wake, paint stay host-side.
export func queue_lane_busy(current: text, pending_len: int, confirm_active: bool) -> bool
    return current.length > 0 or pending_len > 0 or confirm_active

// Dual-queue cancel-reset policy for shared cancelled flag across pair/IB.
// lane in {"pair","ib"}. Hosts map peer_busy (other lane current non-empty)
// and confirm_active (pair confirm wait); hosts own the actual reset side-effect.
// Start-of-job: pair resets only when not peer_busy; ib when not peer_busy and
// not confirm_active. Soft-skip: pair always; ib only when not peer_busy.
export func lane_should_reset_cancel(lane: text, peer_busy: bool, confirm_active: bool) -> bool
    if lane == "ib"
        return not peer_busy and not confirm_active
    // "pair"
    return not peer_busy

export func lane_should_soft_reset_cancel(lane: text, peer_busy: bool) -> bool
    if lane == "ib"
        return not peer_busy
    return true

// Bulk-confirm gate (hosts prompt when pair count exceeds threshold).
export func may_bulk_confirm(line: text) -> bool
    s = strip_spaces(line)
    end = 0
    while end < s.length and not is_ascii_space(s[end])
        end = end + 1
    head = text_slice(s, 0, end)
    return head == "/permutate" or head == "/permute" or head == "/exhaust" or head == "/cross" or head == "/with"

// Pair-count bulk-warn predicate (strict greater-than). Hosts keep threshold constants.
export func should_bulk_warn(n: int, threshold: int) -> bool
    return n > threshold

// /target pure rules — hosts own session state and confirm UI.
// parse_target_arg returns (action, name) with action in {"show","clear","set"}.
// name is non-empty only for "set" (already sanitize_element_name'd).
export func parse_target_arg(arg: text) -> (text, text)
    rest = strip_spaces(arg)
    if rest.length == 0
        return ("show", "")
    low = ascii_lower_text(rest)
    if low == "clear" or low == "off" or low == "none" or low == "-"
        return ("clear", "")
    return ("set", sanitize_element_name(rest))

// Exact name match; empty target or empty result is never a hit.
export func is_target_hit(target: text, result_name: text) -> bool
    if target.length == 0 or result_name.length == 0
        return false
    return target == result_name

// Outcome of a /target command after parse_target_arg.
// Returns (kind, new_state, detail) with kind in
// {show_empty, show, clear_empty, clear, set}.
// show+empty→show_empty; show+set→show (new_state=prev);
// clear+empty prev→clear_empty; clear+had prev→clear (detail=prev);
// else set (new_state=sanitize name). Hosts format wording; no display strings.
export func target_outcome(prev: text, action: text, name: text) -> (text, text, text)
    if action == "show"
        if prev.length == 0
            return ("show_empty", "", "")
        return ("show", prev, "")
    if action == "clear"
        if prev.length == 0
            return ("clear_empty", "", "")
        return ("clear", "", prev)
    // "set"
    return ("set", sanitize_element_name(name), "")

// Apply parse_target_arg action to session target (empty text = no target).
export func apply_target_state(current: text, action: text, name: text) -> text
    kind, new_state, detail = target_outcome(current, action, name)
    return new_state

// Confirm key normalize: strip + ascii-lower full key.
export func confirm_answer_key(answer: text) -> text
    return strip_spaces(ascii_lower_text(answer))

// Confirm policy: single-key y continues; anything else stops.
export func confirm_should_continue(answer: text) -> bool
    return confirm_answer_key(answer) == "y"

// Confirm key gate: single-key y/n only (reject "", "yes", "no", multi-char).
export func is_confirm_answer(answer: text) -> bool
    key = confirm_answer_key(answer)
    return key == "y" or key == "n"

// Confirm input route: classify y/n against waiting Future vs bulk buffer.
// ignore = not a confirm key (or no waiter/buffer sink); deliver = set Future;
// buffer = stash until bulk awaiter is ready. Hosts own Future/buffer I/O.
export func confirm_input_route(answer: text, waiting: bool, bulk_pending: bool) -> text
    if not is_confirm_answer(answer)
        return "ignore"
    if waiting
        return "deliver"
    if bulk_pending
        return "buffer"
    return "ignore"

// ---------------------------------------------------------------------------
// HTTP retry policy (pure). Hosts own sockets, timers, and abort plumbing;
// the kernel owns how many attempts, which failures retry, and the backoff
// schedule, so the CLI and trainer cannot drift apart (they had: the trainer
// retried Infinibrowser 429s, the CLI gave up on first error).
// Attempts are 0-based; backoff(attempt) is the wait after that attempt fails.
// Status 0 means a transport-level failure (network error / timeout).
// ---------------------------------------------------------------------------

export func fetch_timeout_ms() -> int
    return 30000

export func pair_retry_max_attempts() -> int
    return 3

// 1s, 2s, 4s, ... doubling from 1000ms.
export func pair_retry_backoff_ms(attempt: int) -> int
    ms = 1000
    i = 0
    while i < attempt
        ms = ms * 2
        i = i + 1
    return ms

export func pair_should_retry(attempt: int) -> bool
    // The pair API retries any failure: transport, bad status, bad body.
    return attempt + 1 < pair_retry_max_attempts()

export func ib_retry_max_attempts() -> int
    return 4

// 2s, 4s, 8s, ... doubling from 2000ms.
export func ib_retry_backoff_ms(attempt: int) -> int
    ms = 2000
    i = 0
    while i < attempt
        ms = ms * 2
        i = i + 1
    return ms

export func ib_should_retry(status: int, attempt: int) -> bool
    // Infinibrowser retries only rate limiting and transport failures; any
    // other status (404, 5xx) is a real answer the caller interprets.
    if status != 429 and status != 0
        return false
    return attempt + 1 < ib_retry_max_attempts()

// ---------------------------------------------------------------------------
// Rate-window chrome math (pure). Hosts own clocks, deques, HTTP, paint.
// Times are integer milliseconds (or any consistent unit).
// ---------------------------------------------------------------------------

export func rate_slots_left(used: int, max_requests: int) -> int
    if max_requests <= 0
        return 0
    left = max_requests - used
    if left < 0
        return 0
    return left

// Progress toward the next free slot, in thousandths [0, 1000].
// Idle (no timestamps) → 1000 (left bar full). Resets when a slot frees
// (has_last_freed + last_freed_ms), then fills over the inter-drop interval.
export func rate_next_slot_frac_milli(
    now_ms: int,
    oldest_ms: int,
    last_freed_ms: int,
    window_ms: int,
    has_timestamps: bool,
    has_last_freed: bool
) -> int
    if not has_timestamps
        return 1000
    if window_ms <= 0
        return 1000
    next_free = oldest_ms + window_ms
    start = oldest_ms
    if has_last_freed and last_freed_ms >= oldest_ms
        start = last_freed_ms
    span = next_free - start
    if span <= 0
        return 1000
    elapsed = now_ms - start
    if elapsed <= 0
        return 0
    milli = (elapsed * 1000) / span
    if milli < 0
        return 0
    if milli > 1000
        return 1000
    return milli

// Segmented bar cell counts: left = next-slot wait, right = remaining capacity.
// frac_milli is [0, 1000]. Rounding matches common half-up via +width/2 style.
export func rate_bar_fills(
    remaining: int,
    max_requests: int,
    frac_milli: int,
    left_width: int,
    right_width: int
) -> (int, int)
    left_filled = 0
    if left_width > 0
        fm = frac_milli
        if fm < 0
            fm = 0
        if fm > 1000
            fm = 1000
        left_filled = (fm * left_width + 500) / 1000
        if left_filled > left_width
            left_filled = left_width
    right_filled = 0
    if right_width > 0 and max_requests > 0
        rem = remaining
        if rem < 0
            rem = 0
        if rem > max_requests
            rem = max_requests
        right_filled = (rem * right_width + max_requests / 2) / max_requests
        if right_filled > right_width
            right_filled = right_width
    return (left_filled, right_filled)

// Glyph segment for rate bars: clamp filled to [0, width], then █ filled + ░ empty.
// Hosts keep ANSI/HTML wrappers; kernel owns clamp + glyph construction.
// █ = U+2588 (9608), ░ = U+2591 (9617).
export func rate_bar_segment(filled: int, width: int) -> text
    n = filled
    if n < 0
        n = 0
    if n > width
        n = width
    return repeat_char(9608, n) + repeat_char(9617, width - n)

// End-ellipsis for rate-line pair chrome. Plain text length (not ANSI).
// Matches trainer ellipsizeEnd: max_chars<=0 → ""; overflow → prefix + "…".
export func rate_ellipsize_end(s: text, max_chars: int) -> text
    if max_chars <= 0
        return ""
    if s.length <= max_chars
        return s
    if max_chars == 1
        return "…"
    return text_slice(s, 0, max_chars - 1) + "…"

// Format "a + b" into avail cells: split remaining after sep, end-ellipsis each.
// Hosts supply avail (TTY width / DOM clientWidth); kernel owns the math.
export func rate_format_pair_for_width(a: text, b: text, avail: int) -> text
    sep: text = " + "
    if avail <= sep.length + 2
        return rate_ellipsize_end(a + sep + b, avail)
    each = (avail - sep.length) / 2
    left_extra = (avail - sep.length) - each * 2
    return rate_ellipsize_end(a, each + left_extra) + sep + rate_ellipsize_end(b, each)

export func is_slash_command_attempt(line: text) -> bool
    // Port of re.match(r"/[^/]+/", line) then re.match(r"/\w", line).
    if line.length == 0 or line[0] != '/'
        return false
    // Delimited regex at start: /[^/]+/  → not a slash-command attempt.
    if line.length >= 3
        i = 1
        while i < line.length and line[i] != '/'
            i = i + 1
        if i > 1 and i < line.length and line[i] == '/'
            return false
    if line.length >= 2 and is_word_char(line[1])
        return true
    return false

func contains_plus_ws_pipe(s: text) -> bool
    // re.search(r"\+\s+\|", s): '+' then 1+ whitespace then '|'
    i = 0
    while i < s.length
        if s[i] == '+'
            j = i + 1
            if j < s.length and is_ascii_space(s[j])
                while j < s.length and is_ascii_space(s[j])
                    j = j + 1
                if j < s.length and s[j] == '|'
                    return true
        i = i + 1
    return false

func ends_with_space_plus(s: text) -> bool
    // re.search(r" \+$", line.rstrip())
    t = strip_spaces(s)
    // strip_spaces strips both ends; rstrip only trims right — rebuild rstrip.
    end = s.length
    while end > 0 and is_ascii_space(s[end - 1])
        end = end - 1
    if end < 2
        return false
    return s[end - 2] == ' ' and s[end - 1] == '+'

export func classify_command_line(line: text) -> Option<(text, text)>
    line = strip_spaces(line)
    if line.length == 0
        return None
    cmds: List<text> = ["/permute", "/permutate", "/import", "/fill", "/prune", "/export", "/exhaust", "/combine", "/crawl", "/with", "/cross"]
    for cmd in cmds
        rest_opt = slash_args(line, cmd)
        if rest_opt.is_some()
            kind = strip_prefix_one(cmd)
            return Some((kind, rest_opt.unwrap()))
    if is_slash_command_attempt(line)
        return None
    if contains_plus_ws_pipe(line)
        return Some(("bad+|", line))
    if strings.contains(line, " ++ ")
        return Some(("++", line))
    if strings.contains(line, "+|")
        return Some(("+|", line))
    if strings.contains(line, " * ")
        return Some(("*", line))
    if strings.contains(line, " + ") or ends_with_space_plus(line)
        return Some(("+", line))
    return None

export func parse_two_elements(rest: text) -> Option<(text, text)>
    rest = strip_spaces(rest)
    // split(None, 1): first whitespace run
    i = 0
    while i < rest.length and not is_ascii_space(rest[i])
        i = i + 1
    if i >= rest.length
        return None
    first = strip_spaces(text_slice(rest, 0, i))
    second = strip_spaces(text_from(rest, i))
    if first.length == 0 or second.length == 0
        return None
    return Some((first, second))

export func parse_with_args(rest: text) -> Option<(text, text)>
    return parse_two_elements(rest)

export func split_two_positional_args(rest: text) -> Option<(text, text)>
    rest = strip_spaces(rest)
    if rest.length == 0
        return None
    tokens: List<text> = []
    i = 0
    n = rest.length
    while i < n and tokens.length < 2
        while i < n and is_ascii_space(rest[i])
            i = i + 1
        if i >= n
            break
        token: text = ""
        if rest[i] == '/'
            j = i + 1
            found_close = false
            while j < n
                if rest[j] == '/'
                    found_close = true
                    break
                j = j + 1
            if not found_close
                j = i
                while j < n and not is_ascii_space(rest[j])
                    j = j + 1
                token = text_slice(rest, i, j)
                i = j
            else
                token = text_slice(rest, i, j + 1)
                i = j + 1
        else
            j = i
            while j < n and not is_ascii_space(rest[j])
                j = j + 1
            token = text_slice(rest, i, j)
            i = j
        token = strip_spaces(token)
        if token.length > 0
            tokens.append(token)
    if tokens.length != 2
        return None
    while i < n and is_ascii_space(rest[i])
        i = i + 1
    if i < n
        return None
    return Some((tokens[0], tokens[1]))

export func parse_cross_queries(rest: text) -> Option<(text, text)>
    return split_two_positional_args(rest)

// Validation errors are built as SEGMENT lists: (text, highlight) pairs.
// The message text lives here once; hosts only style — the Python CLI wraps
// highlighted segments in ANSI yellow, the browser trainer HTML-escapes every
// segment and wraps highlighted ones in a color span. Plain-text variants
// concatenate the segments unchanged.

func seg_concat(segs: List<(text, bool)>) -> text
    out: text = ""
    for seg in segs
        t, hl = seg
        assert hl == hl
        out = out + t
    return out

func plain_segment(msg: text) -> List<(text, bool)>
    return [(msg, false)]

func query_err_segments(err: Option<text>) -> Option<List<(text, bool)>>
    if err.is_none()
        return None
    return Some(plain_segment(err.unwrap()))

func bad_pipe_segments() -> List<(text, bool)>
    segs: List<(text, bool)> = []
    segs.append(("  Use <element> +| <query> (no space between + and |). Type ", false))
    segs.append(("/help", true))
    segs.append((" for commands.", false))
    return segs

func has_spaced_pipe_payload(rest: text) -> bool
    if contains_plus_ws_pipe(rest)
        return true
    parsed = parse_two_elements(rest)
    if parsed.is_some()
        pfirst, psecond = parsed.unwrap()
        assert pfirst == pfirst
        if psecond.length > 0 and psecond[0] == '|'
            return true
    return false

export func slash_combine_crawl_pipe_error_segments(rest: text) -> Option<List<(text, bool)>>
    if has_spaced_pipe_payload(rest)
        return Some(bad_pipe_segments())
    return None

export func slash_combine_crawl_pipe_error(rest: text) -> Option<text>
    segs = slash_combine_crawl_pipe_error_segments(rest)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

export func slash_combine_crawl_operator_error_segments(rest: text, kind: text) -> Option<List<(text, bool)>>
    if not strings.contains(rest, " + ")
        return None
    idx = strings.index_of(rest, " + ").unwrap()
    left = text_slice(rest, 0, idx)
    right = text_from(rest, idx + 3)
    positional = "/" + kind + " " + strip_spaces(left) + " " + strip_spaces(right)
    segs: List<(text, bool)> = []
    segs.append(("  Slash /" + kind + " uses positional args, not +. Try ", false))
    segs.append((strip_spaces(rest), true))
    segs.append((" (shorthand) or ", false))
    segs.append((positional, true))
    segs.append((".", false))
    return Some(segs)

export func slash_combine_crawl_operator_error(rest: text, kind: text) -> Option<text>
    segs = slash_combine_crawl_operator_error_segments(rest, kind)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

export func slash_cross_operator_error_segments(rest: text) -> Option<List<(text, bool)>>
    if not strings.contains(rest, " * ")
        return None
    idx = strings.index_of(rest, " * ").unwrap()
    left = text_slice(rest, 0, idx)
    right = text_from(rest, idx + 3)
    positional = "/cross " + strip_spaces(left) + " " + strip_spaces(right)
    segs: List<(text, bool)> = []
    segs.append(("  Slash /cross uses positional args, not *. Try ", false))
    segs.append((strip_spaces(rest), true))
    segs.append((" (shorthand) or ", false))
    segs.append((positional, true))
    segs.append((".", false))
    return Some(segs)

export func slash_cross_operator_error(rest: text) -> Option<text>
    segs = slash_cross_operator_error_segments(rest)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

export func validate_query_at_enqueue(query: text) -> Option<text>
    if query.length > 512
        return Some("  Query too long (max 512 characters)")
    q, qf_exclude, qf_only_new = parse_query_filter(query)
    if not is_delimited_regex(q)
        return None
    body = text_slice(q, 1, q.length - 1)
    if not regex.regex_is_valid(body)
        return Some("  Invalid regex pattern")
    return None

func first_ws_token(s: text) -> text
    s = strip_spaces(s)
    i = 0
    while i < s.length and not is_ascii_space(s[i])
        i = i + 1
    return text_slice(s, 0, i)

func split_once(s: text, sep: text) -> (text, text)
    // Split on first occurrence of sep; if missing, (s, "").
    idx_opt = strings.index_of(s, sep)
    if idx_opt.is_none()
        return (s, "")
    idx = idx_opt.unwrap()
    return (text_slice(s, 0, idx), text_from(s, idx + sep.length))

func rsplit_once_space_plus(s: text) -> text
    // payload.rsplit(" +", 1)[0] — last occurrence of " +"
    last = -1
    i = 0
    while i + 1 < s.length
        if s[i] == ' ' and s[i + 1] == '+'
            last = i
        i = i + 1
    if last < 0
        return s
    return text_slice(s, 0, last)

export func parse_operands(kind: text, payload: text) -> Option<(text, text)>
    // Operand extraction for the shorthand kinds returned by
    // classify_command_line ("++", "+|", "*", "+"). Python str.split(sep, 1)
    // semantics: split on the separator's FIRST occurrence, the right side
    // keeps any later separators ("A + B + C" -> ("A", "B + C")).
    // Owner ruling 2026-08-07: JS String.split's second argument is a
    // result-length limit, which silently truncated the tail; maxsplit
    // semantics are canonical.
    left: text = ""
    right: text = ""
    if kind == "++"
        left, right = split_once(payload, " ++ ")
    else if kind == "+|"
        left, right = split_once(payload, "+|")
    else if kind == "*"
        left, right = split_once(payload, " * ")
    else if kind == "+"
        if strings.contains(payload, " + ")
            left, right = split_once(payload, " + ")
        else
            left = rsplit_once_space_plus(payload)
            right = ""
    else
        return None
    l = strip_spaces(left)
    r = strip_spaces(right)
    if l.length == 0 or r.length == 0
        return None
    return Some((l, r))

export func validate_command_line_segments(line: text) -> Option<List<(text, bool)>>
    classified = classify_command_line(line)
    if classified.is_none()
        if is_slash_command_attempt(line)
            cmd = first_ws_token(line)
            segs: List<(text, bool)> = []
            segs.append(("  Unknown command: ", false))
            segs.append((cmd, true))
            segs.append((". Type ", false))
            segs.append(("/help", true))
            segs.append((" for commands.", false))
            return Some(segs)
        unk: List<(text, bool)> = []
        unk.append(("  Unknown input. Type ", false))
        unk.append(("/help", true))
        unk.append((" for commands.", false))
        return Some(unk)
    kind, payload = classified.unwrap()
    if kind == "bad+|"
        return Some(bad_pipe_segments())
    if kind == "permute" or kind == "permutate" or kind == "exhaust" or kind == "import"
        if strip_spaces(payload).length == 0
            if kind == "import"
                return Some(plain_segment("  Usage: /import <element>"))
            return Some(plain_segment("  Usage: /" + kind + " <query>"))
        if kind == "import"
            return None
        return query_err_segments(validate_query_at_enqueue(strip_spaces(payload)))
    if kind == "export" or kind == "fill" or kind == "prune"
        return None
    if kind == "combine" or kind == "crawl"
        pipe_err = slash_combine_crawl_pipe_error_segments(payload)
        if pipe_err.is_some()
            return pipe_err
        op_err = slash_combine_crawl_operator_error_segments(payload, kind)
        if op_err.is_some()
            return op_err
        if parse_two_elements(payload).is_none()
            return Some(plain_segment("  Usage: /" + kind + " <element> <element>"))
        return None
    if kind == "with"
        parsed = parse_with_args(payload)
        if parsed.is_none()
            return Some(plain_segment("  Usage: /with <element> <query>"))
        with_elem, query = parsed.unwrap()
        assert with_elem == with_elem
        return query_err_segments(validate_query_at_enqueue(query))
    if kind == "cross"
        op_err = slash_cross_operator_error_segments(payload)
        if op_err.is_some()
            return op_err
        parsed = parse_cross_queries(payload)
        if parsed.is_none()
            return Some(plain_segment("  Usage: /cross <query> <query>"))
        left_q, right_q = parsed.unwrap()
        err = validate_query_at_enqueue(left_q)
        if err.is_some()
            return query_err_segments(err)
        return query_err_segments(validate_query_at_enqueue(right_q))
    if kind == "++"
        if parse_operands(kind, payload).is_none()
            return Some(plain_segment("  Usage: <element> ++ <element>"))
        return None
    if kind == "+|"
        operands = parse_operands(kind, payload)
        if operands.is_none()
            return Some(plain_segment("  Usage: <element> +| <query>"))
        op_left, op_right = operands.unwrap()
        assert op_left == op_left
        return query_err_segments(validate_query_at_enqueue(op_right))
    if kind == "*"
        operands = parse_operands(kind, payload)
        if operands.is_none()
            return Some(plain_segment("  Usage: <query> * <query>"))
        op_left, op_right = operands.unwrap()
        err = validate_query_at_enqueue(op_left)
        if err.is_some()
            return query_err_segments(err)
        return query_err_segments(validate_query_at_enqueue(op_right))
    if kind == "+"
        if parse_operands(kind, payload).is_none()
            return Some(plain_segment("  Usage: <element> + <element>"))
        return None
    return None

export func validate_command_line(line: text) -> Option<text>
    segs = validate_command_line_segments(line)
    if segs.is_none()
        return None
    return Some(seg_concat(segs.unwrap()))

// ---- boundary adapters: tuple/primitive-only shapes for export funcs ----
// Records/enums must not cross export func signatures (toolchain limitation).

func element_from_tuple(t: (text, text, bool)) -> Element
    n, em, f = t
    return Element(name = n, emoji = em, first = f)

func element_to_tuple(e: Element) -> (text, text, bool)
    return (e.name, e.emoji, e.first)

func elements_from_tuples(ts: List<(text, text, bool)>) -> List<Element>
    out: List<Element> = []
    for t in ts
        out.append(element_from_tuple(t))
    return out

func elements_to_tuples(es: List<Element>) -> List<(text, text, bool)>
    out: List<(text, text, bool)> = []
    for e in es
        out.append(element_to_tuple(e))
    return out

func recipe_result_to_tuple(r: RecipeResult) -> (int, text, List<(text, text, text)>)
    match r
        case NotFound
            empty: List<(text, text, text)> = []
            return (0, "", empty)
        case IsBase(n)
            empty: List<(text, text, text)> = []
            return (1, n, empty)
        case NoRecipe(n)
            empty: List<(text, text, text)> = []
            return (2, n, empty)
        case Unreachable(n)
            empty: List<(text, text, text)> = []
            return (3, n, empty)
        case Steps(t, steps)
            out: List<(text, text, text)> = []
            for s in steps
                out.append((s.a, s.b, s.result))
            return (4, t, out)

export func resolve_element_boundary(elements: List<(text, text, bool)>, name: text) -> (text, text, bool)
    return element_to_tuple(resolve_element(elements_from_tuples(elements), name))

export func get_by_name_boundary(elements: List<(text, text, bool)>, name: text) -> Option<(text, text, bool)>
    found = get_by_name(elements_from_tuples(elements), name)
    match found
        case Some(e)
            return Some(element_to_tuple(e))
        case None
            return None

export func add_element_boundary(elements: inout List<(text, text, bool)>, name: text, emoji: text, first: bool) -> bool
    es = elements_from_tuples(elements)
    result = add_element(es, name, emoji, first)
    elements = elements_to_tuples(es)
    return result

export func add_elements_batch_boundary(elements: inout List<(text, text, bool)>, items: List<(text, text, bool)>) -> int
    es = elements_from_tuples(elements)
    result = add_elements_batch(es, items)
    elements = elements_to_tuples(es)
    return result

export func trace_recipe_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>, name: text) -> (int, text, List<(text, text, text)>)
    r = trace_recipe(elements_from_tuples(elements), recipes, name)
    return recipe_result_to_tuple(r)

export func included_element_names_boundary(recipes: Map<text, List<(text, text)>>) -> List<text>
    return sorted_text_list(included_element_names(recipes).items())

export func orphan_candidates_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<(text, text, bool)>
    return elements_to_tuples(orphan_candidates(elements_from_tuples(elements), recipes))

export func export_elements_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<(text, text, bool)>
    return elements_to_tuples(export_elements(elements_from_tuples(elements), recipes))

export func match_elements_boundary(elements: List<(text, text, bool)>, query: text) -> (List<(text, text, bool)>, Option<text>)
    matches, err = match_elements(elements_from_tuples(elements), query)
    return (elements_to_tuples(matches), err)

func element_pairs_to_boundary(pairs: List<(Element, Element)>) -> List<(text, text, bool, text, text, bool)>
    out: List<(text, text, bool, text, text, bool)> = []
    for p in pairs
        a, b = p
        out.append((a.name, a.emoji, a.first, b.name, b.emoji, b.first))
    return out

export func exhaust_pairs_boundary(matches: List<(text, text, bool)>, all_elements: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(exhaust_pairs(elements_from_tuples(matches), elements_from_tuples(all_elements)))

export func permute_pairs_boundary(matches: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(permute_pairs(elements_from_tuples(matches)))

export func cross_pairs_boundary(left: List<(text, text, bool)>, right: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(cross_pairs(elements_from_tuples(left), elements_from_tuples(right)))

export func with_pairs_boundary(target: (text, text, bool), others: List<(text, text, bool)>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(with_pairs(element_from_tuple(target), elements_from_tuples(others)))

func element_pairs_from_boundary(pairs: List<(text, text, bool, text, text, bool)>) -> List<(Element, Element)>
    out: List<(Element, Element)> = []
    for p in pairs
        an, ae, af, bn, be, bf = p
        out.append((Element(name = an, emoji = ae, first = af), Element(name = bn, emoji = be, first = bf)))
    return out

export func prioritize_pairs_boundary(pairs: List<(text, text, bool, text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<(text, text, bool, text, text, bool)>
    return element_pairs_to_boundary(prioritize_pairs(element_pairs_from_boundary(pairs), recipes))

export func crawl_generation_pairs_boundary(pool: List<(text, text, bool)>, tried_keys: List<text>) -> (List<(text, text, bool, text, text, bool)>, List<text>)
    tried: Set<text> = Set()
    for k in tried_keys
        tried.add(k)
    pairs, new_keys = crawl_generation_pairs(elements_from_tuples(pool), tried)
    return (element_pairs_to_boundary(pairs), new_keys)

export func unfilled_names_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> List<text>
    // Element-list order is preserved (both hosts display in storage order).
    //
    // Precompute names with a non-empty recipe list, then scan elements with
    // O(1) set lookups. The previous form called is_unfilled(e.name, recipes)
    // once per element; sudoc deep-copies every Map parameter on entry, so
    // that was O(|elements| · |recipes|) full-map dups and made /fill and
    // /unfilled appear to hang on multi-thousand-element saves (same class
    // of bug as the old is_available-in-compute_layers path).
    filled: Set<text> = Set()
    for k in recipes.keys()
        if recipes[k].length > 0
            filled.add(k)
    out: List<text> = []
    for e in elements_from_tuples(elements)
        if is_base_element(e.name)
            continue
        if not filled.has(e.name)
            out.append(e.name)
    return out

// ---- import/export folds ----
// Hosts do JSON traversal and I/O only; id resolution, name sanitization,
// dedup, and id remapping all happen here.

export func ic_save_to_batches(items: List<(int, text, text, bool)>, recipe_refs: List<(int, int, int)>) -> (List<(text, text, bool)>, List<(text, text, text)>)
    // .ic save import: items are (id, text, emoji, discovered) — the host
    // merges the save's discovery/discovered spellings into one flag —
    // and recipe_refs are (result_id, a_id, b_id). Names are sanitized;
    // refs whose ids don't resolve are dropped (no dangling references).
    id_name: Map<text, text> = Map()
    elements: List<(text, text, bool)> = []
    for it in items
        iid, txt, em, disc = it
        nm = sanitize_element_name(txt)
        // Missing or all-control text sanitizes to "": skip the item
        // entirely — its id stays unresolvable, so refs to it drop too.
        if nm.length == 0
            continue
        id_name[int_to_text(iid)] = nm
        elements.append((nm, em, disc))
    recipes_out: List<(text, text, text)> = []
    for ref in recipe_refs
        rid, aid, bid = ref
        rk = int_to_text(rid)
        ak = int_to_text(aid)
        bk = int_to_text(bid)
        if not id_name.has(rk) or not id_name.has(ak) or not id_name.has(bk)
            continue
        recipes_out.append((id_name[rk], id_name[ak], id_name[bk]))
    return (elements, recipes_out)

func lineage_add_unique(elements: inout List<(text, text, bool)>, seen: inout Set<text>, name: text, emoji: text)
    if seen.has(name)
        return
    seen.add(name)
    elements.append((name, emoji, false))

export func lineage_steps_to_batches(steps: List<(text, text, text, text, text, text)>) -> (List<(text, text, bool)>, List<(text, text, text)>)
    // Infinibrowser lineage fold: steps are (a_name, a_emoji, b_name,
    // b_emoji, result_name, result_emoji), after the host's tolerant
    // id-or-text JSON extraction. Names are sanitized; steps with any
    // empty name are skipped (owner ruling 2026-08-07: tolerate malformed
    // payloads instead of erroring). The element batch is deduped by name
    // (first occurrence wins, a/b/result order per step); the recipe
    // batch stays in step order.
    seen: Set<text> = Set()
    elements: List<(text, text, bool)> = []
    recipes_out: List<(text, text, text)> = []
    for st in steps
        a_raw, a_em, b_raw, b_em, r_raw, r_em = st
        a = sanitize_element_name(a_raw)
        b = sanitize_element_name(b_raw)
        r = sanitize_element_name(r_raw)
        if a.length == 0 or b.length == 0 or r.length == 0
            continue
        recipes_out.append((r, a, b))
        lineage_add_unique(elements, seen, a, a_em)
        lineage_add_unique(elements, seen, b, b_em)
        lineage_add_unique(elements, seen, r, r_em)
    return (elements, recipes_out)

export func build_export_items_boundary(elements: List<(text, text, bool)>, recipes: Map<text, List<(text, text)>>) -> (List<(int, text, text, bool)>, List<(int, int, int)>)
    // .ic export builder (owner ruling 2026-08-07): fresh sequential ids
    // 0..n over the export closure in input (storage) order, recipe pairs
    // remapped to those ids, pairs referencing excluded elements dropped —
    // an export can never contain a dangling id.
    selected = export_elements(elements_from_tuples(elements), recipes)
    name_id: Map<text, int> = Map()
    items: List<(int, text, text, bool)> = []
    idx = 0
    for e in selected
        name_id[e.name] = idx
        items.append((idx, e.name, e.emoji, e.first))
        idx = idx + 1
    refs: List<(int, int, int)> = []
    for e in selected
        if not recipes.has(e.name)
            continue
        for pair in recipes[e.name]
            pa, pb = pair
            if name_id.has(pa) and name_id.has(pb)
                refs.append((name_id[e.name], name_id[pa], name_id[pb]))
    return (items, refs)

