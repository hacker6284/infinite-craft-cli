test "trace_recipe outcomes"
    els: List<Element> = []
    els.append(Element(name = "Water", emoji = "", first = false))
    recipes: Map<text, List<(text, text)>> = Map()
    r = trace_recipe(els, recipes, "Water")
    match r
        case IsBase(n)
            assert n == "Water"
        case NotFound
            assert false
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0
        case Steps(t, steps)
            assert t.length < 0 or steps.length < 0
    els.append(Element(name = "Mystery", emoji = "", first = false))
    r = trace_recipe(els, recipes, "Mystery")
    match r
        case NoRecipe(n)
            assert n == "Mystery"
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0
        case Steps(t, steps)
            assert t.length < 0 or steps.length < 0
    r = trace_recipe(els, recipes, "Nope")
    match r
        case NotFound
            assert true
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0
        case Steps(t, steps)
            assert t.length < 0 or steps.length < 0
    els2: List<Element> = []
    els2.append(Element(name = "A", emoji = "", first = false))
    els2.append(Element(name = "B", emoji = "", first = false))
    recipes2: Map<text, List<(text, text)>> = Map()
    recipes2["A"] = [("B", "Water")]
    recipes2["B"] = [("A", "Fire")]
    r = trace_recipe(els2, recipes2, "A")
    match r
        case Unreachable(n)
            assert n == "A"
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Steps(t, steps)
            assert t.length < 0 or steps.length < 0
    els3: List<Element> = []
    els3.append(Element(name = "Steam", emoji = "", first = false))
    els3.append(Element(name = "Cloud", emoji = "", first = false))
    recipes3: Map<text, List<(text, text)>> = Map()
    recipes3["Steam"] = [("Fire", "Water")]
    recipes3["Cloud"] = [("Steam", "Wind")]
    r = trace_recipe(els3, recipes3, "Cloud")
    match r
        case Steps(t, steps)
            assert t == "Cloud"
            assert steps.length == 2
            assert steps[0].result == "Steam"
            assert steps[1].result == "Cloud"
        case NotFound
            assert false
        case IsBase(n)
            assert n.length < 0
        case NoRecipe(n)
            assert n.length < 0
        case Unreachable(n)
            assert n.length < 0

test "boundary adapters smoke"
    // match_elements_boundary
    els: List<(text, text, bool)> = []
    els.append(("Water", "", false))
    els.append(("Fire", "", false))
    els.append(("Steam", "", false))
    m, err = match_elements_boundary(els, "tea")
    assert err.is_none()
    assert m.length == 1
    n, em, f = m[0]
    assert n == "Steam"
    m, err = match_elements_boundary(els, "")
    assert err.is_none()
    assert m.length == 0
    // resolve / get_by_name
    miss = resolve_element_boundary(els, "unicorn dust")
    n, em, f = miss
    assert n == "Unicorn Dust"
    found = get_by_name_boundary(els, "Water")
    assert found.is_some()
    assert get_by_name_boundary(els, "missing").is_none()
    // add
    assert add_element_boundary(els, "Lava", "🌋", false)
    assert not add_element_boundary(els, "Lava", "xx", true)
    batch: List<(text, text, bool)> = []
    batch.append(("X", "", false))
    assert add_elements_batch_boundary(els, batch) == 1
    empty_batch: List<(text, text, bool)> = []
    assert add_elements_batch_boundary(els, empty_batch) == 0
    // trace
    base_els: List<(text, text, bool)> = []
    base_els.append(("Water", "", false))
    base_recipes: Map<text, List<(text, text)>> = Map()
    status, name, steps = trace_recipe_boundary(base_els, base_recipes, "Water")
    assert status == 1
    assert name == "Water"
    assert steps.length == 0
    status0, name0, steps0 = trace_recipe_boundary(base_els, base_recipes, "Nope")
    assert status0 == 0
    // included / orphan / export
    recipes: Map<text, List<(text, text)>> = Map()
    recipes["Steam"] = [("Mystery Gas", "Water")]
    exp_els: List<(text, text, bool)> = []
    exp_els.append(("Water", "", false))
    exp_els.append(("Steam", "", false))
    exp_els.append(("Mystery Gas", "", false))
    exp_els.append(("Orphan", "", false))
    names = included_element_names_boundary(recipes)
    assert names.length >= 5
    empty_recipes: Map<text, List<(text, text)>> = Map()
    names_empty = included_element_names_boundary(empty_recipes)
    assert names_empty.length == 4
    orphans = orphan_candidates_boundary(exp_els, recipes)
    assert orphans.length == 1
    empty_orphans = orphan_candidates_boundary(exp_els, empty_recipes)
    // with only bases in closure, Steam/Mystery/Orphan are orphans (Water is base)
    assert empty_orphans.length == 3
    exported = export_elements_boundary(exp_els, recipes)
    assert exported.length == 3
    empty_export = export_elements_boundary(exp_els, empty_recipes)
    assert empty_export.length == 1
    // exhaust_pairs_boundary
    matches: List<(text, text, bool)> = []
    matches.append(("Water", "", false))
    matches.append(("Wind", "", false))
    all_e: List<(text, text, bool)> = []
    all_e.append(("Water", "", false))
    all_e.append(("Wind", "", false))
    all_e.append(("Fire", "", false))
    all_e.append(("Earth", "", false))
    ep = exhaust_pairs_boundary(matches, all_e)
    assert ep.length == 5
    empty_matches: List<(text, text, bool)> = []
    ep0 = exhaust_pairs_boundary(empty_matches, all_e)
    assert ep0.length == 0

// End of craft.sudo kernel v2.
