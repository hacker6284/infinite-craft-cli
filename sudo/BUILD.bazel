load("@rules_sudo//:defs.bzl", "sudo_library", "sudo_lockstep_test")

sudo_library(
    name = "craft",
    srcs = ["craft.sudo"],
    visibility = ["//visibility:public"],
)

sudo_lockstep_test(
    name = "craft_lockstep_test",
    lib = ":craft",
    entry = "craft.sudo",
    # rules_sudo 1.0.0 renamed `targets` → `backends` (the list may now also
    # carry LABELS to sudo_external_backend targets; craft.sudo uses only the
    # built-in py/js).
    backends = [
        "py",
        "js",
    ],
    # 18 tests x 2 backends runs ~3.5min locally and ~2x that on CI —
    # the default moderate (300s) timeout is exactly the wrong size.
    timeout = "long",
)
