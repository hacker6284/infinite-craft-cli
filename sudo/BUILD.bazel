load("@rules_sudo//:defs.bzl", "sudo_library", "sudo_lockstep_test")

sudo_library(
    name = "craft",
    srcs = ["craft.sudo"],
    visibility = ["//visibility:public"],
)

sudo_lockstep_test(
    name = "craft_lockstep_test",
    lib = ":craft",
    entry = "craft.sudo",
    # rules_sudo 1.0.0 renamed `targets` → `backends` (the list may now also
    # carry LABELS to sudo_external_backend targets; craft.sudo uses only the
    # built-in py/js).
    backends = [
        "py",
        "js",
    ],
    # Was "long" when 18 tests x 2 backends took ~3.5min locally (~2x on CI),
    # back when std.sorting.sort_by was quadratic. It is now 31 tests x 2
    # backends in ~2.3s, so Bazel flags "long" as oversized and it is.
    #
    # "short" (60s) is also the failure signal for the
    # "prioritize_pairs order contract at scale" test: that case sorts 19,900
    # pairs, which is sub-second at O(n log n) and hundreds of millions of
    # comparisons if anything reintroduces a quadratic sort. A regression
    # blows this timeout rather than quietly taking 15 minutes.
    timeout = "short",
)
