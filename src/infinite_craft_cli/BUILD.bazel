load("@rules_python//python:defs.bzl", "py_library")

# Kernel adapters for craft.sudo, generated at build time by the pinned
# sudoc binary (see //sudo:sudoc_bin). Bazel-only generation route: does
# NOT read scripts/generate.sh's gitignored output directory of the same
# name -- this genrule's outs live under bazel-out and are visible to
# Python only through this py_library's srcs, never mixed with a source
# glob of _sudo/**, to avoid the "generated output collides with tracked
# source path" ambiguity when a developer has also run generate.sh
# in-place. Non-bazel flows (pytest via uv, minify.sh, publish/pages CI)
# still use scripts/generate.sh directly; both routes independently
# regenerate the same content from the same pinned sudoc + sudo/craft.sudo,
# and don't need to interoperate.
genrule(
    name = "gen_py_sudo",
    srcs = ["//sudo:craft.sudo"],
    outs = [
        "_sudo/craft.py",
        "_sudo/_craft_impl.py",
        "_sudo/_regex_impl.py",
        "_sudo/_strings_impl.py",
        "_sudo/_sudo_rt.py",
        "_sudo/regex.py",
        "_sudo/__init__.py",
    ],
    cmd = "set -euo pipefail; " +
          "OUTDIR=$(RULEDIR)/_sudo; " +
          "mkdir -p \"$$OUTDIR\"; " +
          "$(location //sudo:sudoc_bin) build --target py -o \"$$OUTDIR\" $(location //sudo:craft.sudo); " +
          "{ " +
          "echo '# Generated by Bazel (//src/infinite_craft_cli:gen_py_sudo) - DO NOT EDIT BY HAND.'; " +
          "echo '# Mirrors the shim scripts/generate.sh writes for the non-Bazel flow: sudoc'; " +
          "echo \"# generated Python modules import each other via bare top-level module\"; " +
          "echo '# names, which only resolve when this directory is on sys.path.'; " +
          "echo 'import os'; " +
          "echo 'import sys'; " +
          "echo ''; " +
          "echo '_here = os.path.dirname(__file__)'; " +
          "echo 'if _here not in sys.path:'; " +
          "echo '    sys.path.insert(0, _here)'; " +
          "echo ''; " +
          "echo 'from . import craft  # noqa: E402,F401'; " +
          "} > \"$$OUTDIR/__init__.py\"",
    tools = ["//sudo:sudoc_bin"],
)

py_library(
    name = "infinite_craft_cli",
    srcs = glob(["*.py"]) + [":gen_py_sudo"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "@pip//curl_cffi",
    ],
)
