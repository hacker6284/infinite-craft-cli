load("@rules_python//python:defs.bzl", "py_library")
load("@rules_sudo//:defs.bzl", "sudo_py_library")

# Kernel adapters for craft.sudo, compiled by rules_sudo's sudo_py_library
# into a tree-artifact directory named "_sudo" (the rule always names the
# output directory after the target's own name — do not rename this
# target). Landing at runfiles path src/infinite_craft_cli/_sudo keeps
# `from infinite_craft_cli._sudo import craft` working exactly as it did
# under the old genrule, with zero import-path changes downstream.
sudo_py_library(
    name = "_sudo",
    lib = "//sudo:craft",
    entry = "craft.sudo",
)

py_library(
    name = "infinite_craft_cli",
    srcs = glob(["*.py"]),
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        ":_sudo",
        "@pip//curl_cffi",
    ],
)
