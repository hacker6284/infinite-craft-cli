module(
    name = "infinite-craft-cli",
    version = "1.0.0",
)

bazel_dep(name = "rules_python", version = "1.7.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pip")

# rules_sudo 1.0.0's hermetic decomposed sudo_lockstep_test rule declares BOTH
# the python and rust toolchain types (the py/rs run-leaves pin a toolchain from
# runfiles — design §5/§9). craft.sudo only exercises py+js, but the rule still
# resolves @rules_rust//rust:toolchain_type, so a rust toolchain must be
# registered even though no Rust code is compiled here.
bazel_dep(name = "rules_rust", version = "0.72.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.96.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# rules_sudo compiles sudo/craft.sudo into generated Python/JS libraries and
# lockstep-tests them across backends. rules_sudo 1.0.0 (compatibility_level 2):
# the hermetic decomposed sudo_lockstep_test REPLACES the v0.2.1 PATH-inheriting
# one (breaking).
#
# Consumed from a matched-pair release (design §8 Phase 5 Task 8), which
# publishes BOTH the ruleset tarball AND the matched binary SET (sudoc +
# lockstep_diff + capture_run + emit_unpack). Each binary's per-platform sha256 is
# pinned in the tarball's versions.bzl, so sudo.toolchain(version = "v0.7.3")
# resolves the whole set with no local sha overrides.
#
# The module stays at 1.0.0 / compatibility_level 2 and defs.bzl (the public
# rule surface) is byte-identical across every bump so far -- no rule
# attributes have moved. What changes is the pinned `sudoc` binary:
#
#   v0.4.0  breaking: `record`/`enum` names may no longer contain `_`.
#           No effect here -- Element, RecipeStep and RecipeResult are
#           already underscore-free.
#   v0.5.0  no language change. Haskell `List<T>` moved to Data.Sequence
#           (this project builds py/js only) and `sudoc check` now reports
#           every signature-pass error instead of just the first.
#   v0.6.0  std.sorting.sort_by became a stable O(n log n) merge sort. NOT
#           adoptable on its own: it regressed passing a comparator over a
#           caller-declared record into an imported generic, which is exactly
#           what `sorting.sort_by(pool, element_name_less)` does -- craft.sudo
#           failed `sudoc check` outright. Skipped; never pinned here.
#   v0.7.0  fixes that (a caller-declared record/enum is now a legal type
#           argument to an imported generic), which is what let the kernel's
#           hand-rolled heapsort go. Also: `regex` gained a 100k-NFA-state
#           compile budget in v0.6.0, which is what finally makes DIVERGENCES
#           ruling 7's "hosts may drop their own complexity gates" true
#           rather than merely asserted.
#   v0.7.1  std.sorting.sort_by finally beat the kernel's hand-rolled heapsort
#           (swap-as-rebinding + copy-on-write lists), so the heapsort is gone.
#   v0.7.3  copy-on-write made uniform across every composite, and read-only
#           tuple destructures no longer copy their source. prioritize_pairs
#           at 97,020 pairs: 26.1s -> 6.6s, same output ordering.
#
# The protocol bumps (2 -> 3 in v0.6.0, 3 -> 4 in v0.7.0) bind `sudoc` to its
# matched emitter; the matched-pair release ships both and we register no
# sudo_external_backend, so they do not reach this project. v0.7.0 does add a
# generated `sudo_types.*` file whenever a nominal type crosses a module
# boundary -- rules_sudo declares it as an output, so it flows into the wheel
# and the bookmarklet bundle without a BUILD change.
bazel_dep(name = "rules_sudo", version = "1.0.0")
archive_override(
    module_name = "rules_sudo",
    urls = ["https://github.com/hacker6284/sudocode/releases/download/v0.7.3/rules_sudo-v0.7.3.tar.gz"],
    strip_prefix = "rules_sudo",
    sha256 = "25391a009113e9e7df693688476b1ec6c51fb58af0fbced9e8802b13b973acf4",
)

sudo = use_extension("@rules_sudo//:extensions.bzl", "sudo")
sudo.toolchain(version = "v0.7.3")
use_repo(sudo, "sudo_toolchain")

# Hermetic esbuild (bundles the bookmarklet; replaces npx esbuild/terser).
#
# Pinned to the latest BCR release (0.26.0) rather than the brief's 0.22.1:
# checked https://registry.bazel.build/modules/aspect_rules_esbuild, 0.26.0 is
# current. Its own MODULE.bazel (github.com/aspect-build/rules_esbuild
# @v0.26.0) declares minimum bazel_dep versions of aspect_rules_js 3.0.3 and
# bazel_lib 3.0.0 -- note the *module name* "bazel_lib", not
# "aspect_bazel_lib": upstream bazel-contrib/bazel-lib renamed the BCR module
# starting at bazel_lib 3.0.0 (aspect_bazel_lib tops out around 2.22.5 and is
# the pre-rename name). Pinned here to the latest release of each on BCR.
bazel_dep(name = "aspect_rules_esbuild", version = "0.26.0")

# Directly loaded by //bookmarklet (esbuild rule transitively needs JsInfo /
# copy_to_bin machinery from these). Under bzlmod a root module can only load
# repos it declares -- transitive deps of aspect_rules_esbuild are NOT
# visible -- so these are explicit even though rules_esbuild also pulls them
# in. (Fable review.)
bazel_dep(name = "aspect_rules_js", version = "3.3.1")
bazel_dep(name = "bazel_lib", version = "3.7.1")

esbuild = use_extension("@aspect_rules_esbuild//esbuild:extensions.bzl", "esbuild")

# esbuild 0.28.1 (the brief's suggested pin) is not in aspect_rules_esbuild
# 0.26.0's vendored TOOL_VERSIONS table (max is 0.28.0, which is also that
# table's first/default entry -- LATEST_ESBUILD_VERSION). Byte-parity with
# the old minify.sh is an explicit non-goal, so we take the ruleset's default
# instead of supplying an unvendored version + manual integrity hashes.
esbuild.toolchain(esbuild_version = "0.28.0")
use_repo(esbuild, "esbuild_toolchains")
register_toolchains("@esbuild_toolchains//:all")

# Packages the Chrome extension's tracked sources into a real .zip
# (//extension:zip) so tests/test_extension_loader.py can read a hermetic,
# Bazel-built artifact instead of a manually-built untracked file. Pinned to
# the latest BCR release (checked https://registry.bazel.build/modules/rules_pkg).
bazel_dep(name = "rules_pkg", version = "1.2.0")
