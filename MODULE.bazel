module(
    name = "infinite-craft-cli",
    version = "1.0.0",
)

bazel_dep(name = "rules_python", version = "1.7.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pip")

# rules_sudo compiles sudo/craft.sudo into generated Python/JS libraries via
# the pinned sudoc release binary. No BCR registration yet — consume via
# archive_override against the GitHub release tarball. See
# https://github.com/hacker6284/sudocode for the source ruleset.
bazel_dep(name = "rules_sudo", version = "0.1.0")
archive_override(
    module_name = "rules_sudo",
    urls = ["https://github.com/hacker6284/sudocode/releases/download/v0.1.0/rules_sudo-v0.1.0.tar.gz"],
    sha256 = "dc9d46f803c86c873f0adefb97b43367e05239987f8cf4f85a13fbbae81ef7d5",
    strip_prefix = "rules_sudo",
)

sudo = use_extension("@rules_sudo//:extensions.bzl", "sudo")
sudo.toolchain(version = "v0.1.0")
use_repo(sudo, "sudo_toolchain")
