load("@rules_python//python:defs.bzl", "py_test")

# Relay tests run under the system node, same documented compromise as
# //tests/parity: no JS ruleset for one small service; `local` disables
# sandboxing so `node` on PATH is reachable.
py_test(
    name = "relay_test",
    srcs = ["relay_test.py"],
    data = [
        "server.mjs",
        "server.test.mjs",
    ],
    tags = ["local"],
    env_inherit = ["PATH"],
)
