load("@rules_python//python:defs.bzl", "py_test")

# Relay tests run under the system node, same documented compromise as
# //tests/parity: no JS ruleset for one small service; `local` disables
# sandboxing so `node` on PATH is reachable.
py_test(
    name = "relay_test",
    srcs = ["relay_test.py"],
    data = [
        "server.mjs",
        "server.test.mjs",
    ] + glob(["_sudo/**"]),
    tags = ["local"],
    env_inherit = ["PATH"],
)

# The relay deploys from git with no build step, so the JS kernel is a
# committed copy under relay/_sudo. This tripwire fails the moment
# craft.sudo changes without re-vendoring.
py_test(
    name = "sudo_freshness_test",
    srcs = ["sudo_freshness_test.py"],
    data = ["//bookmarklet:_sudo"] + glob(["_sudo/**"]),
)
